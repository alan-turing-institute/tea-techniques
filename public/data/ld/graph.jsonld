        "tea:tag/expertise-needed/statistics",
        "tea:tag/explanatory-scope/global",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/technique-type/algorithmic"
      ],
      "complexityRating": 1,
      "computationalCostRating": 1,
      "relatedTo": [
        "tea:technique/platt-scaling",
        "tea:technique/deep-ensembles",
        "tea:technique/conformal-prediction"
      ],
      "citesResource": [
        "tea:resource/TemperatureScalerTorchUncertaintyDocs",
        "tea:resource/gpleissTemperature_scaling2017",
        "tea:resource/guoCalibrationModernNeural2017",
        "tea:resource/ImproveToplabelCalibration"
      ],
      "exampleUseCases": [
        {
          "description": "Adjusting a deep learning image classifier's confidence scores to be realistic, ensuring that when it's 90% confident, it's right 90% of the time.",
          "goal": "Reliability"
        },
        {
          "description": "Making medical diagnosis model predictions more trustworthy by providing realistic confidence scores that doctors can interpret and use to make informed decisions about patient care.",
          "goal": "Transparency"
        },
        {
          "description": "Ensuring fair treatment across patient demographics by calibrating confidence scores equally across different groups, preventing systematic over-confidence in predictions for certain populations.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "Only addresses calibration at the overall dataset level, not subgroup-specific miscalibration issues."
        },
        {
          "description": "Does not improve the rank ordering or accuracy of predictions, only adjusts confidence levels."
        },
        {
          "description": "Assumes that calibration errors are consistent across different types of inputs and feature values."
        },
        {
          "description": "Requires a separate validation set for temperature parameter optimisation, which may not be available in small datasets."
        }
      ],
      "sampleClaims": [
        {
          "text": "The medical diagnosis system's confidence scores align with observed clinical outcome frequencies across all prediction confidence levels",
          "domain": "healthcare",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The credit risk model's probability estimates reflect true default rates without sacrificing discriminative accuracy",
          "domain": "finance",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The image classifier communicates prediction confidence through calibrated probabilities that match empirical correctness rates",
          "domain": "general",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The fraud detection system's confidence estimates are equally well-calibrated across customer demographic groups",
          "domain": "finance",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The environmental forecasting model's stated uncertainty levels correspond to actual prediction accuracy across diverse weather conditions",
          "domain": "environmental",
          "assuranceGoal": "reliability"
        }
      ]
    },
    {
      "@id": "tea:technique/deep-ensembles",
      "@type": "Technique",
      "name": "Deep Ensembles",
      "slug": "deep-ensembles",
      "description": "Deep ensembles combine predictions from multiple neural networks trained independently with different random initializations to capture epistemic uncertainty (model uncertainty). By training several models on the same data with different starting points, the ensemble reveals how much the model's predictions depend on training randomness. The disagreement between ensemble members naturally indicates prediction uncertainty - when models agree, confidence is high; when they disagree, uncertainty is revealed. This approach provides more reliable uncertainty estimates, better out-of-distribution detection, and improved calibration compared to single models.",
      "addressesGoal": [
        "tea:goal/reliability",
        "tea:goal/transparency",
        "tea:goal/safety"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/neural-networks",
        "tea:tag/applicable-models/paradigm/parametric",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/uncertainty-quantification",
        "tea:tag/assurance-goal-category/safety",
        "tea:tag/assurance-goal-category/safety/safeguards",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/confidence-and-limits",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-selection-and-training",
        "tea:tag/lifecycle-stage/system-deployment",
        "tea:tag/lifecycle-stage/system-deployment/system-implementation"
      ],
      "complexityRating": 3,
      "computationalCostRating": 5,
      "relatedTo": [
        "tea:technique/monte-carlo-dropout",
        "tea:technique/conformal-prediction",
        "tea:technique/out-of-distribution-detector-for-neural-networks",
        "tea:technique/epistemic-uncertainty-quantification"
      ],
      "citesResource": [
        "tea:resource/Deep_ensemblesTorchUncertaintyDocs",
        "tea:resource/Torchuncertainty",
        "tea:resource/lakshminarayananSimpleScalablePredictive2016",
        "tea:resource/DeepEnsemblesSegmentation",
        "tea:resource/langnerUncertaintyawareBodyComposition2021"
      ],
      "exampleUseCases": [
        {
          "description": "Improving self-driving car safety by using multiple neural networks to detect obstacles, where disagreement between models signals uncertainty and triggers extra caution or human intervention, providing robust uncertainty quantification for critical decisions.",
          "goal": "Reliability"
        },
        {
          "description": "Communicating prediction confidence to medical professionals by showing the range of diagnoses from multiple trained models, enabling doctors to understand when the AI system is uncertain and requires additional human expertise or testing.",
          "goal": "Transparency"
        },
        {
          "description": "Detecting out-of-distribution inputs in financial fraud detection systems where ensemble disagreement signals potentially novel attack patterns that require immediate security team review and system safeguards.",
          "goal": "Safety"
        }
      ],
      "limitations": [
        {
          "description": "Computationally expensive to train and deploy, requiring multiple complete neural networks which increases training time, memory usage, and inference costs proportionally to ensemble size."
        },
        {
          "description": "May still provide overconfident predictions for inputs far from the training distribution, as all ensemble members can be similarly confident about out-of-distribution examples."
        },
        {
          "description": "Requires careful hyperparameter tuning for each ensemble member to ensure diversity, as identical hyperparameters may lead to similar models that reduce uncertainty estimation quality."
        },
        {
          "description": "Storage and deployment overhead increases linearly with ensemble size, making it challenging to deploy large ensembles in resource-constrained environments or real-time applications."
        },
        {
          "description": "Ensemble predictions may be difficult to interpret individually, as the final decision emerges from averaging multiple models rather than from a single explainable pathway."
        }
      ],
      "sampleClaims": [
        {
          "text": "The autonomous driving system's predictions are accompanied by confidence estimates that reflect genuine disagreement among multiple independent models",
          "domain": "autonomous systems",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The diagnostic model's uncertainty estimates reveal when different training conditions would yield substantially different predictions",
          "domain": "healthcare",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The system detects inputs that fall outside its validated operating envelope by measuring prediction variation across independently trained models",
          "domain": "general",
          "assuranceGoal": "safety"
        },
        {
          "text": "The credit risk model's confidence bounds reflect variability in model structure rather than relying on a single trained configuration",
          "domain": "finance",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The system's hazard warnings are triggered when multiple independent models produce conflicting predictions about safe operation",
          "domain": "autonomous systems",
          "assuranceGoal": "safety"
        }
      ]
    },
    {
      "@id": "tea:technique/bootstrapping",
      "@type": "Technique",
      "name": "Bootstrapping",
      "slug": "bootstrapping",
      "description": "Bootstrapping estimates uncertainty by repeatedly resampling the original dataset with replacement to create many new training sets, training a model on each sample, and analysing the variation in predictions. This approach provides confidence intervals and stability measures without making strong statistical assumptions. By showing how predictions change with different random samples of the data, it reveals how sensitive the model is to the specific training examples and provides robust uncertainty estimates.",
      "addressesGoal": [
        "tea:goal/reliability",
        "tea:goal/transparency",
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/data-requirements/access-to-training-data",
