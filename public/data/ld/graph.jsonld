      ],
      "publicationDate": "2019-6"
    },
    {
      "@id": "tea:resource/turpinCotunfaithfulnessCodeTurpin2026",
      "@type": "Resource",
      "name": "cot-unfaithfulness (code for Turpin et al. 2023)",
      "citationKey": "turpinCotunfaithfulnessCodeTurpin2026",
      "url": "https://github.com/milesaturpin/cot-unfaithfulness",
      "sourceType": "software_package",
      "publicationDate": "2026-08-13T22:17:11Z"
