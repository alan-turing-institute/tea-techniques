      "@id": "tea:resource/adversarial-robustness-toolboxdevelopersArtdefencesdetectorpoisonAdversarialRobustness",
      "@type": "Resource",
      "name": "art.defences.detector.poison — Adversarial Robustness Toolbox ...",
      "citationKey": "adversarial-robustness-toolboxdevelopersArtdefencesdetectorpoisonAdversarialRobustness",
      "url": "https://adversarial-robustness-toolbox.readthedocs.io/en/latest/modules/defences/detector_poisoning.html",
      "sourceType": "documentation",
