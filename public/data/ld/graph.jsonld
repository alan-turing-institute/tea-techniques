    {
      "@id": "tea:resource/liuFormalizingBenchmarkingPrompt2024",
      "@type": "Resource",
      "name": "Formalizing and benchmarking prompt injection attacks and defenses",
      "citationKey": "liuFormalizingBenchmarkingPrompt2024",
      "url": "https://www.usenix.org/conference/usenixsecurity24/presentation/liu-yupei",
      "sourceType": "technical_paper",
      "authors": [
