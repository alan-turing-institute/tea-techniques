      "@id": "tea:resource/TemperatureScalerTorchUncertaintyDocs",
      "@type": "Resource",
      "name": "TemperatureScaler - TorchUncertainty Docs",
      "citationKey": "TemperatureScalerTorchUncertaintyDocs",
