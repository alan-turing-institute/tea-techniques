    {
      "@id": "tea:resource/sillMonotonicNetworks1997",
      "@type": "Resource",
      "name": "Monotonic Networks",
      "citationKey": "sillMonotonicNetworks1997",
      "url": "https://proceedings.neurips.cc/paper/1997/hash/83adc9225e4deb67d7ce42d58fe5157c-Abstract.html",
      "sourceType": "technical_paper",
      "authors": [
        "Joseph Sill"
      ],
      "publicationDate": "1997",
      "abstract": "Monotonicity  is  a  constraint which  arises  in many application do(cid:173) mains.  We present  a  machine learning model,  the monotonic net(cid:173) work, for which monotonicity can be enforced exactly, i.e., by virtue  offunctional form .  A straightforward method for implementing and  training  a  monotonic  network  is  described.  Monotonic  networks  are  proven  to  be  universal  approximators of continuous,  differen(cid:173) tiable  monotonic functions.  We  apply  monotonic  networks  to  a  real-world  task  in  corporate  bond  rating  prediction  and  compare  them to other approaches."
    },
