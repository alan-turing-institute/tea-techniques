      "@id": "tea:resource/nicholsNonparametricPermutationTests2001",
      "@type": "Resource",
      "name": "Nonparametric permutation tests for functional neuroimaging: A primer with examples",
      "citationKey": "nicholsNonparametricPermutationTests2001",
