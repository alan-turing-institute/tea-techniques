    {
      "@id": "tea:resource/singhHierarchicalNeuralnetInterpretations2026",
      "@type": "Resource",
      "name": "Hierarchical neural-net interpretations (ACD) (csinva/hierarchical-dnn-interpretations)",
      "citationKey": "singhHierarchicalNeuralnetInterpretations2026",
      "url": "https://github.com/csinva/hierarchical-dnn-interpretations",
      "sourceType": "software_package",
