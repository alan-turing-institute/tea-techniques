    {
      "@id": "tea:resource/kamiranDecisionTheoryDiscriminationAware2012",
      "@type": "Resource",
      "name": "Decision Theory for Discrimination-Aware Classification",
      "citationKey": "kamiranDecisionTheoryDiscriminationAware2012",
      "url": "https://doi.org/10.1109/icdm.2012.45",
      "sourceType": "technical_paper",
      "authors": [
        "Faisal Kamiran",
        "Asim Karim",
        "Xiangliang Zhang"
      ],
      "publicationDate": "2012-12"
    },
    {
      "@id": "tea:resource/kamiranExploitingRejectOption2018",
      "@type": "Resource",
      "name": "Exploiting reject option in classification for social discrimination control",
