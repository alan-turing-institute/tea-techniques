    {
      "@id": "tea:resource/hillUncoveringNonlinearPatterns2025",
      "@type": "Resource",
      "name": "Uncovering nonlinear patterns in time-sensitive prehospital breathing emergencies: an exploratory machine learning study",
      "citationKey": "hillUncoveringNonlinearPatterns2025",
      "url": "https://doi.org/10.1186/s12911-025-03046-z",
      "sourceType": "application_paper",
      "authors": [
        "Peter Hill",
