      "sourceType": "application_paper",
      "authors": [
        "Scott M. Lundberg",
        "Bala Nair",
        "Monica S. Vavilala",
        "Mayumi Horibe",
        "Michael J. Eisses",
        "Trevor Adams",
        "David E. Liston",
        "Daniel King-Wai Low",
