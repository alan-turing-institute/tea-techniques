        },
        {
          "text": "The diagnostic support system prevents treatment recommendations from being actioned until reviewed by a licensed physician",
          "domain": "healthcare",
          "assuranceGoal": "safety"
        },
        {
          "text": "The content moderation system escalates borderline cases to human moderators based on defined criteria rather than relying solely on automated classification",
          "domain": "public sector",
          "assuranceGoal": "fairness"
        }
      ]
