      "@id": "tea:resource/blanco-justiciaDigitalForgettingLarge2025",
      "@type": "Resource",
      "name": "Digital forgetting in large language models: A survey of unlearning methods",
      "citationKey": "blanco-justiciaDigitalForgettingLarge2025",
