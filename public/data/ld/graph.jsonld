      "@id": "tea:resource/pavlin-policarOpenTSNE2018",
      "@type": "Resource",
      "name": "openTSNE",
      "citationKey": "pavlin-policarOpenTSNE2018",
      "url": "https://github.com/pavlin-policar/openTSNE",
