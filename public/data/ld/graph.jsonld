      "@id": "tea:resource/hadleyInvestigatingAlgorithmReview2024",
      "@type": "Resource",
      "name": "Investigating Algorithm Review Boards for Organizational Responsible Artificial Intelligence Governance",
      "citationKey": "hadleyInvestigatingAlgorithmReview2024",
      "url": "https://link.springer.com/article/10.1007/s43681-024-00574-8",
      "sourceType": "technical_paper",
