    {
      "@id": "tea:resource/utkuozbulakPytorchcnnvisualizations2017",
      "@type": "Resource",
      "name": "pytorch-cnn-visualizations",
      "citationKey": "utkuozbulakPytorchcnnvisualizations2017",
