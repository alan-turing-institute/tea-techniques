    {
      "@id": "tea:resource/aif360developersWelcomeAIFairness2018",
      "@type": "Resource",
      "name": "Welcome to AI Fairness 360's documentation! — aif360 0.1.0 ...",
      "citationKey": "aif360developersWelcomeAIFairness2018",
