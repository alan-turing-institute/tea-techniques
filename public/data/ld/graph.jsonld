{
  "@context": "https://alan-turing-institute.github.io/tea-techniques/data/ld/context.jsonld",
  "@graph": [
    {
      "@id": "tea:technique/shapley-additive-explanations",
      "@type": "Technique",
      "name": "SHapley Additive exPlanations",
      "slug": "shapley-additive-explanations",
      "description": "SHAP explains model predictions by quantifying how much each input feature contributes to the outcome. It assigns an importance score to every feature, indicating whether it pushes the prediction towards or away from the average. The method systematically evaluates how predictions change as features are included or excluded, drawing on game theory concepts to ensure a fair distribution of contributions.",
      "addressesGoal": [
        "tea:goal/explainability",
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/assurance-goal-category/explainability",
        "tea:tag/assurance-goal-category/explainability/attribution-methods/perturbation-based",
        "tea:tag/assurance-goal-category/explainability/explains/feature-importance",
        "tea:tag/assurance-goal-category/explainability/property/completeness",
        "tea:tag/assurance-goal-category/explainability/property/consistency",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/bias-diagnosis",
        "tea:tag/data-requirements/reference-dataset",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/explanatory-scope/global",
        "tea:tag/explanatory-scope/local",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation"
      ],
      "acronym": "SHAP",
      "complexityRating": 3,
      "computationalCostRating": 4,
      "relatedTo": [
        "tea:technique/local-interpretable-model-agnostic-explanations",
        "tea:technique/permutation-importance",
        "tea:technique/partial-dependence-plots"
      ],
      "citesResource": [
        "tea:resource/SHAPDocumentation",
        "tea:resource/shapShap2016",
        "tea:resource/lundbergUnifiedApproachInterpreting2017",
        "tea:resource/lundbergLocalExplanationsGlobal2020",
        "tea:resource/IntroductionExplainableAI",
        "tea:resource/lundbergExplainableMachinelearningPredictions2018"
      ],
      "exampleUseCases": [
        {
          "description": "Analysing a customer churn prediction model to understand why a specific high-value customer was flagged as likely to leave, revealing that recent support ticket interactions and declining purchase frequency were the main drivers.",
          "goal": "Explainability"
        },
        {
          "description": "Auditing a loan approval model by comparing SHAP values for applicants from different demographic groups, ensuring that protected characteristics like race or gender do not have an undue influence on credit decisions.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "Assumes feature independence, which can produce misleading explanations when features are highly correlated, as the model may attribute importance to features that are merely proxies for others."
        },
        {
          "description": "Computationally expensive for models with many features or large datasets, as the number of required predictions grows exponentially with the number of features."
        },
        {
          "description": "The choice of background dataset for generating explanations can significantly influence the results, requiring careful selection to ensure a representative baseline."
        },
        {
          "description": "Global explanations derived from averaging local SHAP values may obscure important heterogeneous effects where features impact subgroups of the population differently."
        }
      ],
      "sampleClaims": [
        {
          "text": "The model's predictions can be decomposed into quantified contributions from each input feature",
          "domain": "general",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The credit scoring system's decision rationale is expressed as the sum of individual feature impacts on the baseline prediction",
          "domain": "finance",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The model's reliance on demographic attributes is quantifiable and bounded across all decision contexts",
          "domain": "public sector",
          "assuranceGoal": "fairness"
        }
      ]
    },
    {
      "@id": "tea:technique/permutation-importance",
      "@type": "Technique",
      "name": "Permutation Importance",
      "slug": "permutation-importance",
      "description": "Permutation Importance quantifies a feature's contribution to a model's performance by randomly shuffling its values and measuring the resulting drop in predictive accuracy. If shuffling a feature significantly degrades the model's performance, that feature is considered important. This model-agnostic technique helps identify which inputs are genuinely driving predictions, rather than just being correlated with the outcome.",
      "addressesGoal": [
        "tea:goal/explainability"
      ],
      "hasTag": [
        "tea:tag/assurance-goal-category/explainability",
        "tea:tag/assurance-goal-category/explainability/attribution-methods/perturbation-based",
        "tea:tag/assurance-goal-category/explainability/explains/feature-importance",
        "tea:tag/assurance-goal-category/explainability/property/consistency",
        "tea:tag/assurance-goal-category/explainability/property/fidelity",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-type/tabular",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/explanatory-scope/global",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation"
      ],
      "complexityRating": 2,
      "computationalCostRating": 3,
      "relatedTo": [
        "tea:technique/shapley-additive-explanations",
        "tea:technique/mean-decrease-impurity",
        "tea:technique/partial-dependence-plots"
      ],
      "citesResource": [
        "tea:resource/scikit-learndevelopersScikitlearnPermutation_importance2007",
        "tea:resource/Scikitlearn",
        "tea:resource/breimanRandomForests2001",
        "tea:resource/fisherAllModelsAre2019",
        "tea:resource/PermutationImportanceVs",
        "tea:resource/cutlerRANDOMFORESTSCLASSIFICATION2007"
      ],
      "exampleUseCases": [
        {
          "description": "Assessing which patient characteristics (e.g., age, blood pressure, cholesterol) are most critical for a medical diagnosis model by observing the performance drop when each characteristic's values are randomly shuffled, ensuring the model relies on clinically relevant factors.",
          "goal": "Explainability"
        }
      ],
      "limitations": [
        {
          "description": "Can be misleading when features are highly correlated, as shuffling one feature might indirectly affect others, leading to an overestimation of its importance."
        },
        {
          "description": "Computationally expensive for large datasets or complex models, as it requires re-evaluating the model many times for each feature."
        },
        {
          "description": "Does not account for interactions between features; it measures the marginal importance of a feature, assuming other features remain unchanged."
        },
        {
          "description": "The choice of metric for evaluating performance drop (e.g., accuracy, F1-score) can influence the perceived importance of features."
        }
      ],
      "sampleClaims": [
        {
          "text": "The fraud detection system's performance degrades measurably when individual transaction characteristics are unavailable",
          "domain": "finance",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The environmental monitoring model's forecasts are most sensitive to atmospheric variables that domain experts consider physically relevant",
          "domain": "environmental",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The recommendation system's ability to predict user preferences depends on behavioural patterns rather than demographic attributes",
          "domain": "general",
          "assuranceGoal": "explainability"
        }
      ]
    },
    {
      "@id": "tea:technique/mean-decrease-impurity",
      "@type": "Technique",
      "name": "Mean Decrease Impurity",
      "slug": "mean-decrease-impurity",
      "description": "Mean Decrease Impurity (MDI) quantifies a feature's importance in tree-based models (e.g., Random Forests, Gradient Boosting Machines) by measuring the total reduction in impurity (e.g., Gini impurity, entropy) across all splits where the feature is used. Features that lead to larger, more consistent reductions in impurity are considered more important, indicating their effectiveness in creating homogeneous child nodes and improving predictive accuracy. This makes MDI a computationally efficient method for feature selection and model validation in tree-based ensembles.",
      "addressesGoal": [
        "tea:goal/explainability"
      ],
      "hasTag": [
        "tea:tag/assurance-goal-category/explainability",
        "tea:tag/assurance-goal-category/explainability/attribution-methods/model-specific",
        "tea:tag/assurance-goal-category/explainability/explains/feature-importance",
        "tea:tag/assurance-goal-category/explainability/property/efficiency",
        "tea:tag/assurance-goal-category/explainability/property/completeness",
        "tea:tag/data-requirements/no-special-requirements",
        "tea:tag/data-type/tabular",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/explanatory-scope/global",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/applicable-models/architecture/tree-based",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation"
      ],
      "complexityRating": 2,
      "computationalCostRating": 1,
      "relatedTo": [
        "tea:technique/permutation-importance",
        "tea:technique/shapley-additive-explanations",
        "tea:technique/partial-dependence-plots",
        "tea:technique/local-interpretable-model-agnostic-explanations"
      ],
      "citesResource": [
        "tea:resource/FeatureImportanceEvaluation",
        "tea:resource/Scikitlearn",
        "tea:resource/breimanRandomForests2001",
        "tea:resource/stroblBiasRandomForest2007",
        "tea:resource/FeatureImportancesForest",
        "tea:resource/menzeComparisonRandomForest2009"
      ],
      "exampleUseCases": [
        {
          "description": "Determining the most influential genetic markers in a decision tree model predicting disease susceptibility, by identifying which markers consistently lead to the purest splits between healthy and diseased patient groups.",
          "goal": "Explainability"
        },
        {
          "description": "Assessing the key factors driving customer purchasing decisions in an e-commerce random forest model, revealing which product attributes or customer demographics are most effective in segmenting buyers.",
          "goal": "Explainability"
        }
      ],
      "limitations": [
        {
          "description": "MDI is inherently biased towards features with more unique values or those that allow for more splits, potentially overestimating their true importance."
        },
        {
          "description": "It is only applicable to tree-based models and cannot be directly used with other model architectures."
        },
        {
          "description": "The importance scores can be unstable, varying significantly with small changes in the training data or model parameters."
        },
        {
          "description": "MDI does not account for feature interactions, meaning it might not accurately reflect the importance of features that are only relevant when combined with others."
        }
      ],
      "sampleClaims": [
        {
          "text": "The model's feature importance ranking reflects which patient characteristics most consistently separate clinical outcomes across decision boundaries",
          "domain": "healthcare",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The environmental forecast model's predictions prioritize meteorological variables that create homogeneous regional clusters",
          "domain": "environmental",
          "assuranceGoal": "explainability"
        }
      ]
    },
    {
      "@id": "tea:technique/coefficient-magnitudes-in-linear-models",
      "@type": "Technique",
      "name": "Coefficient Magnitudes (in Linear Models)",
      "slug": "coefficient-magnitudes-in-linear-models",
      "description": "Coefficient Magnitudes assess feature influence in linear models by examining the absolute values of their coefficients. Features with larger absolute coefficients are considered to have a stronger impact on the prediction, while the sign of the coefficient indicates the direction of that influence (positive or negative). This technique provides a straightforward and transparent way to understand the direct linear relationship between each input feature and the model's output.",
      "addressesGoal": [
        "tea:goal/explainability",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/assurance-goal-category/explainability",
        "tea:tag/assurance-goal-category/explainability/attribution-methods/model-specific",
        "tea:tag/assurance-goal-category/explainability/explains/feature-importance",
        "tea:tag/assurance-goal-category/explainability/property/comprehensibility",
        "tea:tag/assurance-goal-category/explainability/property/fidelity",
        "tea:tag/assurance-goal-category/explainability/property/efficiency",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/readable-by-design",
        "tea:tag/data-requirements/no-special-requirements",
        "tea:tag/data-type/tabular",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/explanatory-scope/global",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/technique-type/metric",
        "tea:tag/applicable-models/architecture/linear-models",
        "tea:tag/applicable-models/paradigm/parametric",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/expertise-needed/statistics"
      ],
      "complexityRating": 1,
      "computationalCostRating": 1,
      "relatedTo": [
        "tea:technique/shapley-additive-explanations",
        "tea:technique/generalized-additive-models"
      ],
      "citesResource": [
        "tea:resource/scikit-learndevelopersScikitlearnLinearModels2007",
        "tea:resource/statsmodelsStatsmodels2011",
        "tea:resource/Scikitlearn",
        "tea:resource/ElementsStatisticalLearning2009",
        "tea:resource/bringHowStandardizeRegression1994",
        "tea:resource/CommonPitfallsInterpretation",
        "tea:resource/LinearRegressionInterpretable"
      ],
      "exampleUseCases": [
        {
          "description": "Interpreting which features influence housing price predictions in linear regression, such as identifying that 'number of bedrooms' has a larger positive impact than 'distance to city centre' based on coefficient magnitudes.",
          "goal": "Explainability"
        },
        {
          "description": "Explaining the factors contributing to customer lifetime value (CLV) in a linear model, showing how 'average monthly spend' has a strong positive coefficient, making the model transparent for business stakeholders.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Only valid for linear relationships; it cannot capture complex non-linear patterns or interactions between features."
        },
        {
          "description": "Highly sensitive to feature scaling; features with larger numerical ranges can appear more important even if their true impact is smaller."
        },
        {
          "description": "Can be misleading in the presence of multicollinearity, where correlated features may split importance or have unstable coefficients."
        },
        {
          "description": "Does not imply causation; a strong correlation (large coefficient) does not necessarily mean a causal relationship."
        }
      ],
      "sampleClaims": [
        {
          "text": "The model's feature influences are quantifiable through direct examination of their linear coefficients",
          "domain": "general",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The housing price estimator's reliance on specific property attributes is transparent to regulators through standardized coefficient magnitudes",
          "domain": "finance",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The clinical risk model's predictive contributions from patient characteristics are directly interpretable from the regression parameters",
          "domain": "healthcare",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The system's feature importance rankings remain consistent when input variables are appropriately scaled",
          "domain": "general",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The crop yield prediction model's dependence on environmental factors is directly measurable through their coefficient values",
          "domain": "environmental",
          "assuranceGoal": "explainability"
        }
      ]
    },
    {
      "@id": "tea:technique/integrated-gradients",
      "@type": "Technique",
      "name": "Integrated Gradients",
      "slug": "integrated-gradients",
      "description": "Integrated Gradients explains a single prediction of a differentiable model, such as a neural network, by giving each input feature a score for how much it moved the output away from a chosen reference input called the baseline. It applies to any input the model treats as continuous: image pixels, table columns, or, for language models, the vector representation (embedding) of each token, since the token identifiers themselves cannot be interpolated. The method builds a series of inputs along a straight line from the baseline (for example a black image, an all-zero embedding or a sequence of padding tokens) to the actual input, computes the model's gradient at each step, and multiplies each feature's average gradient by that feature's difference from the baseline. The scores satisfy completeness: they sum to the difference between the model's output on the input and on the baseline, which also gives a check that enough steps were used. The output is one score per pixel, feature or token, usually shown as a heatmap or highlighted text, and it means something only relative to the baseline chosen.",
      "addressesGoal": [
        "tea:goal/explainability",
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/neural-networks",
        "tea:tag/applicable-models/architecture/neural-networks/transformer",
        "tea:tag/applicable-models/paradigm/parametric",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/differentiable",
        "tea:tag/applicable-models/requirements/gradient-access",
        "tea:tag/assurance-goal-category/explainability",
        "tea:tag/assurance-goal-category/explainability/attribution-methods/gradient-based",
        "tea:tag/assurance-goal-category/explainability/explains/feature-importance",
        "tea:tag/assurance-goal-category/explainability/property/completeness",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/bias-diagnosis",
        "tea:tag/data-requirements/reference-dataset",
        "tea:tag/data-type/image",
        "tea:tag/data-type/tabular",
        "tea:tag/data-type/text",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/evidence-type/visualisation",
        "tea:tag/expertise-needed/deep-learning",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/explanatory-scope/local",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/technique-type/algorithmic"
      ],
      "complexityRating": 4,
      "computationalCostRating": 3,
      "relatedTo": [
        "tea:technique/deeplift",
        "tea:technique/layer-wise-relevance-propagation",
        "tea:technique/gradient-saliency",
        "tea:technique/taylor-decomposition"
      ],
      "citesResource": [
        "tea:resource/IntegratedGradientsCaptum",
        "tea:resource/meta-pytorchCaptum2019",
        "tea:resource/sundararajanAxiomaticAttributionDeep2017",
        "tea:resource/IntegratedGradientsTensorFlow",
        "tea:resource/sayresUsingDeepLearning2019",
        "tea:resource/sturmfelsVisualizingImpactFeature2020",
        "tea:resource/InterpretingBERTModels"
      ],
      "exampleUseCases": [
        {
          "description": "An eye-screening programme evaluating a diabetic retinopathy grading model shows graders an Integrated Gradients heatmap beside each prediction, so they can see whether the regions driving a referral are lesions such as haemorrhages rather than camera artefacts, and uses the review to decide whether the model may assist grading.",
          "goal": "Explainability"
        },
        {
          "description": "A team building a question-answering assistant over an organisation's policy documents attributes each answer to the question's tokens and flags questions where the content words receive almost no attribution; those questions become test cases in which the content words are changed, to show whether the assistant actually reads the question.",
          "goal": "Explainability"
        },
        {
          "description": "A trust-and-safety team investigating false positives in a toxic-content classifier aggregates token attributions over wrongly flagged posts to see whether identity terms, such as the name of a religion or a sexual orientation, rather than abusive language drive the score, and adds counter-examples to the training data where they do.",
          "goal": "Fairness"
        },
        {
          "description": "A lender's model-risk team runs Integrated Gradients over a classifier that reads the free-text statements in loan applications, ranking the most highly attributed words across a sample of declined applications to check whether words that reveal a protected characteristic, or stand in for one, carry weight in the decision.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "Attributions are measured against the baseline and no choice is neutral. Features that match the baseline score near zero even when the model relies on them: with a black-image baseline, dark pixels on the object get little credit. A comparison of blurred, noise and training-data baselines found none best, so the baseline is an assumption to state and to vary before drawing conclusions."
        },
        {
          "description": "Requires gradient access to a differentiable model, so it cannot explain tree ensembles, rule-based components or a model reached only through an API. For text, the path runs through token embeddings whose intermediate points are not real words, and subword tokenisation splits a word across several scores that must be recombined before a reviewer can read them."
        },
        {
          "description": "Each explanation needs one gradient computation per step along the path; the original authors found 20 to 300 steps were usually enough for the scores to sum to within 5% of the output difference. Explaining long documents, high-resolution images or a large audit sample therefore costs tens to hundreds of forward and backward passes per prediction."
        },
        {
          "description": "A score shows how sensitive the output was to a feature along one straight path, not that the feature causes the outcome in the world or that removing it would change the decision. Maps over neighbouring pixels or tokens are often noisy, and a plausible-looking heatmap does not show that the model's reasoning is sound."
        }
      ],
      "sampleClaims": [
        {
          "text": "The retinopathy grading model's referral predictions are attributable to lesion regions in the retinal image rather than to imaging artefacts, as shown by Integrated Gradients review of a stratified sample of graded cases",
          "domain": "healthcare",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The attribution scores given to credit analysts for each decision sum, within a stated tolerance, to the difference between the model's score for the applicant and its score for the documented reference applicant",
          "domain": "finance",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The question-answering assistant's answers depend on the content words of each question in the test set, not only on generic words",
          "domain": "general",
          "assuranceGoal": "explainability"
        },
        {
          "text": "Identity terms do not rank among the most highly attributed tokens for the moderation classifier's decisions on non-abusive posts in the audit set",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The loan-screening model's decisions on free-text application statements do not rely on words that reveal a protected characteristic",
          "domain": "finance",
          "assuranceGoal": "fairness"
        }
      ]
    },
    {
      "@id": "tea:technique/deeplift",
      "@type": "Technique",
      "name": "DeepLIFT",
      "slug": "deeplift",
      "description": "DeepLIFT (Deep Learning Important FeaTures) explains neural network predictions by decomposing the difference between the actual output and a reference output back to individual input features. It compares each neuron's activation to a reference activation (typically from a baseline input like all zeros or the dataset mean) and propagates these differences backwards through the network using chain rule modifications. Unlike gradient-based methods, DeepLIFT satisfies the sensitivity property (zero input gets zero attribution) and provides more stable attributions by using discrete differences rather than gradients.",
      "addressesGoal": [
        "tea:goal/explainability",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/assurance-goal-category/explainability",
        "tea:tag/assurance-goal-category/explainability/attribution-methods/gradient-based",
        "tea:tag/assurance-goal-category/explainability/representation-analysis/decomposition",
        "tea:tag/assurance-goal-category/explainability/explains/feature-importance",
        "tea:tag/assurance-goal-category/explainability/property/completeness",
        "tea:tag/assurance-goal-category/explainability/property/consistency",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/decision-reasons",
        "tea:tag/applicable-models/requirements/model-internals",
        "tea:tag/data-requirements/reference-dataset",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/deep-learning",
        "tea:tag/explanatory-scope/local",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/applicable-models/architecture/neural-networks",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/applicable-models/requirements/differentiable",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation"
      ],
      "complexityRating": 4,
      "computationalCostRating": 3,
      "relatedTo": [
        "tea:technique/layer-wise-relevance-propagation",
        "tea:technique/integrated-gradients",
        "tea:technique/taylor-decomposition",
        "tea:technique/gradient-saliency"
      ],
      "citesResource": [
        "tea:resource/DeepLIFTDocumentationCaptum2019",
        "tea:resource/meta-pytorchCaptum2019",
        "tea:resource/DeepLIFTKundajelabDeeplift2026",
        "tea:resource/shrikumarLearningImportantFeatures2017",
        "tea:resource/tangermemedevelopersTutorialA3DeepLIFT2023",
        "tea:resource/InterpretingCIFAR10TorchVision",
        "tea:resource/chenAttributionDeepLearning2023"
      ],
      "exampleUseCases": [
        {
          "description": "Identifying which genomic sequences contribute to a neural network's prediction of protein binding sites, helping biologists understand regulatory mechanisms by comparing to neutral DNA baselines.",
          "goal": "Explainability"
        },
        {
          "description": "Debugging a deep learning image classifier that misclassifies medical scans by attributing the decision to specific image regions, revealing if the model focuses on irrelevant artifacts rather than pathological features.",
          "goal": "Explainability"
        },
        {
          "description": "Providing transparent explanations for automated loan approval decisions by showing which financial features (relative to typical applicant profiles) most influenced the neural network's recommendation.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Requires careful selection of reference baseline, as different choices can lead to substantially different attribution scores."
        },
        {
          "description": "Implementation complexity varies significantly across different neural network architectures and layer types."
        },
        {
          "description": "May produce unintuitive results when the chosen reference is not representative of the decision boundary."
        },
        {
          "description": "Limited to feedforward networks and specific layer types, not suitable for all modern architectures like transformers."
        }
      ],
      "sampleClaims": [
