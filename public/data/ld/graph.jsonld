      "@id": "tea:resource/hongWhosWhosOut2024",
      "@type": "Resource",
      "name": "Who's in and who's out? A case study of multimodal CLIP-filtering in DataComp",
      "citationKey": "hongWhosWhosOut2024",
      "url": "https://doi.org/10.1145/3689904.3694702",
