        "tea:tag/applicable-models/requirements/gradient-access",
        "tea:tag/applicable-models/requirements/differentiable",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/data-requirements/no-special-requirements",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation"
      ],
      "complexityRating": 5,
      "computationalCostRating": 4,
      "relatedTo": [
        "tea:technique/layer-wise-relevance-propagation",
        "tea:technique/deeplift",
        "tea:technique/integrated-gradients",
        "tea:technique/gradient-saliency"
      ],
      "citesResource": [
        "tea:resource/AnalyzerINNvestigateDocumentation",
        "tea:resource/sebastian-lapuschkinLrp_toolbox2016",
        "tea:resource/alberINNvestigateAlbermaxInnvestigate2026",
        "tea:resource/montavonExplainingNonLinearClassification2015",
        "tea:resource/montavonMethodsInterpretingUnderstanding2018"
      ],
      "exampleUseCases": [
        {
          "description": "Analysing which pixels in an image contribute most to a convolutional neural network's classification decision, showing both positive and negative relevance scores for different regions of the input image.",
          "goal": "Explainability"
        },
        {
          "description": "Understanding how different word embeddings in a sentiment analysis model contribute to the final sentiment score, revealing which terms drive positive vs negative predictions.",
          "goal": "Explainability"
        }
      ],
      "limitations": [
        {
          "description": "Mathematically complex requiring deep understanding of calculus and neural network architectures."
        },
        {
          "description": "Computationally intensive as it requires computing gradients and higher-order derivatives through the entire network."
        },
        {
          "description": "Approximations used in practice may introduce errors that affect attribution accuracy."
        },
        {
          "description": "Limited tooling availability compared to other explainability methods, with most implementations being research-focused rather than production-ready."
        }
      ],
      "sampleClaims": [
        {
          "text": "The diagnostic imaging model's classification attributions decompose mathematically into first-order feature contributions and higher-order interaction effects",
          "domain": "healthcare",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The credit risk model's predictions trace through network layers with precise mathematical relevance scores for each input element",
          "domain": "finance",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The object detection system's recognition decisions are attributable to specific pixel regions through backward propagation of derivative-based relevance",
          "domain": "autonomous systems",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The model's feature attributions quantify both individual input contributions and their multiplicative interactions through higher-order terms",
          "domain": "general",
          "assuranceGoal": "explainability"
        }
      ]
    },
    {
      "@id": "tea:technique/sobol-indices",
      "@type": "Technique",
      "name": "Sobol Indices",
      "slug": "sobol-indices",
      "description": "Sobol Indices quantify how much each input feature contributes to the total variance in a model's predictions through global sensitivity analysis. The technique calculates first-order indices (individual feature contributions) and total-order indices (including all interaction effects involving that feature). By systematically sampling the input space and decomposing output variance, Sobol Indices reveal which features drive model uncertainty and which interactions between features are most important for predictions.",
      "addressesGoal": [
        "tea:goal/explainability",
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/assurance-goal-category/explainability",
        "tea:tag/assurance-goal-category/explainability/causal-analysis/interaction-effects",
        "tea:tag/assurance-goal-category/explainability/attribution-methods/perturbation-based",
        "tea:tag/assurance-goal-category/explainability/explains/feature-importance",
        "tea:tag/assurance-goal-category/explainability/explains/causal-pathways",
        "tea:tag/assurance-goal-category/explainability/property/completeness",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/bias-diagnosis",
        "tea:tag/data-requirements/no-special-requirements",
        "tea:tag/data-type/tabular",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/explanatory-scope/global",
