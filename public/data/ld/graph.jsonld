        },
        {
          "text": "The model's individual predictions are accompanied by feature-level attributions measured against defined baseline conditions",
          "domain": "general",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The recommendation system's outputs are interpretable through comparison with typical user interaction patterns",
          "domain": "general",
