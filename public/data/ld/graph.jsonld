    {
      "@id": "tea:technique/reject-option-classification",
      "@type": "Technique",
      "name": "Reject Option Classification",
      "slug": "reject-option-classification",
      "description": "A post-processing fairness technique that modifies predictions in regions of high uncertainty to favour disadvantaged groups and achieve fairness objectives. The method identifies a 'rejection region' where the model's confidence is low (typically near the decision boundary) and reassigns predictions within this region to benefit underrepresented groups. By leveraging model uncertainty, this approach can improve fairness metrics like demographic parity or equalised odds whilst minimising changes to confident predictions, thus preserving overall accuracy for cases where the model is certain.",
      "addressesGoal": [
        "tea:goal/fairness",
        "tea:goal/reliability",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/applicable-models/requirements/probabilistic-output",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/post-processing",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/uncertainty-quantification",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/audit-trail",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/any",
        "tea:tag/expertise-needed/statistics",
