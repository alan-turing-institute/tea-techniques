    {
      "@id": "tea:technique/layer-wise-relevance-propagation",
      "@type": "Technique",
      "name": "Layer-wise Relevance Propagation",
      "slug": "layer-wise-relevance-propagation",
      "description": "Layer-wise Relevance Propagation (LRP) explains neural network predictions by working backwards through the network to show how much each input feature contributed to the final decision. It follows a simple conservation rule: the total contribution scores always add up to the original prediction. Starting from the output, LRP distributes 'relevance' backwards through each layer using different rules depending on the layer type. This creates a detailed breakdown showing which input features helped or hindered the prediction, making it easier to understand why the network made a particular decision.",
      "addressesGoal": [
        "tea:goal/explainability",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/assurance-goal-category/explainability",
        "tea:tag/assurance-goal-category/explainability/attribution-methods/model-specific",
        "tea:tag/assurance-goal-category/explainability/representation-analysis/decomposition",
        "tea:tag/assurance-goal-category/explainability/explains/feature-importance",
        "tea:tag/assurance-goal-category/explainability/explains/internal-mechanisms",
        "tea:tag/assurance-goal-category/explainability/property/completeness",
        "tea:tag/assurance-goal-category/explainability/property/consistency",
        "tea:tag/assurance-goal-category/explainability/property/fidelity",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/decision-reasons",
        "tea:tag/applicable-models/requirements/model-internals",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/deep-learning",
        "tea:tag/explanatory-scope/local",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/applicable-models/architecture/neural-networks",
        "tea:tag/applicable-models/paradigm/parametric",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/applicable-models/requirements/differentiable",
        "tea:tag/data-requirements/no-special-requirements",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation"
      ],
      "acronym": "LRP",
      "complexityRating": 5,
      "computationalCostRating": 3,
      "relatedTo": [
        "tea:technique/deeplift",
        "tea:technique/taylor-decomposition",
        "tea:technique/integrated-gradients",
        "tea:technique/gradient-saliency"
      ],
      "citesResource": [
        "tea:resource/zennitdevelopersGettingStartedZennit",
