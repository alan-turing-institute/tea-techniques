    {
      "@id": "tea:resource/kimMultiaccuracy2019",
      "@type": "Resource",
      "name": "Multiaccuracy",
      "citationKey": "kimMultiaccuracy2019",
      "url": "https://doi.org/10.1145/3306618.3314287",
      "sourceType": "technical_paper",
      "authors": [
        "Michael P. Kim",
        "Amirata Ghorbani",
        "James Zou"
      ],
      "publicationDate": "2019-1-27"
