    {
      "@id": "tea:resource/farayolaFairnessfocusedApproachRecidivism2025",
      "@type": "Resource",
      "name": "A fairness-focused approach to recidivism prediction: implications for accuracy, trust, and equity",
      "citationKey": "farayolaFairnessfocusedApproachRecidivism2025",
      "url": "https://doi.org/10.1007/s00146-025-02452-1",
      "sourceType": "application_paper",
      "authors": [
        "Michael Mayowa Farayola",
        "Irina Tal",
        "Takfarinas Saber",
