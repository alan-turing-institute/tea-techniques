      "@id": "tea:resource/TcavOfficialTCAV2026",
      "@type": "Resource",
      "name": "tcav (official TCAV implementation)",
      "citationKey": "TcavOfficialTCAV2026",
      "url": "https://github.com/tensorflow/tcav",
