      "@id": "tea:resource/murdochContextualDecompositionJamiemurdochContextualDecomposition2026",
      "@type": "Resource",
      "name": "ContextualDecomposition (jamie-murdoch/ContextualDecomposition)",
      "citationKey": "murdochContextualDecompositionJamiemurdochContextualDecomposition2026",
