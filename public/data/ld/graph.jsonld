    {
      "@id": "tea:resource/SdvdevCTGAN2026",
      "@type": "Resource",
      "name": "sdv-dev/CTGAN",
      "citationKey": "SdvdevCTGAN2026",
      "url": "https://github.com/sdv-dev/CTGAN",
      "sourceType": "software_package",
