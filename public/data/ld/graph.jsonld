        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/preprocessing-and-feature-engineering"
      ],
      "complexityRating": 3,
      "computationalCostRating": 3,
      "relatedTo": [
        "tea:technique/principal-component-analysis",
        "tea:technique/prototype-and-criticism-models",
        "tea:technique/sobol-indices"
      ],
      "citesResource": [
        "tea:resource/FactorAnalysisScikitlearn",
        "tea:resource/FactorAnalyzerDocumentation",
        "tea:resource/educationaltestingserviceFactor_analyzer2017",
        "tea:resource/spearmanGeneralIntelligenceObjectively1904",
