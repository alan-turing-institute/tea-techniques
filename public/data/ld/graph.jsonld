        },
        {
          "text": "The environmental monitoring model maintains prediction reliability across sensor configurations and atmospheric conditions encountered during deployment",
          "domain": "environmental",
          "assuranceGoal": "reliability"
        }
      ]
    },
    {
      "@id": "tea:technique/permutation-tests",
      "@type": "Technique",
      "name": "Permutation Tests",
      "slug": "permutation-tests",
      "description": "Permutation tests assess the statistical significance of observed results (such as model accuracy, feature importance, or group differences) by comparing them to what would occur purely by chance. The technique randomly shuffles labels or data thousands of times, recalculating the metric of interest each time to build an empirical null distribution. If the actual observed result falls in the extreme tail of this distribution (typically beyond the 95th or 99th percentile), it provides strong evidence that the relationship is genuine rather than due to random chance, without requiring parametric assumptions about data distributions.",
      "addressesGoal": [
        "tea:goal/explainability",
        "tea:goal/fairness",
        "tea:goal/reliability"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/explainability",
        "tea:tag/assurance-goal-category/explainability/attribution-methods/perturbation-based",
        "tea:tag/assurance-goal-category/explainability/explains/feature-importance",
        "tea:tag/assurance-goal-category/explainability/property/consistency",
        "tea:tag/assurance-goal-category/explainability/property/fidelity",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/bias-measurement",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/performance-assessment",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/statistical-test",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/explanatory-scope/global",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/technique-type/testing"
      ],
      "complexityRating": 3,
      "computationalCostRating": 4,
      "relatedTo": [
        "tea:technique/permutation-importance",
        "tea:technique/cross-validation",
        "tea:technique/shapley-additive-explanations"
      ],
      "citesResource": [
        "tea:resource/Scipystatspermutation_testSciPyManual",
        "tea:resource/ScipyScipySciPy2026",
        "tea:resource/pitmanSignificanceTestsWhich1937",
        "tea:resource/ojalaPermutationTestsStudying2009",
        "tea:resource/berkHowUsePermutation2021",
        "tea:resource/TestPermutationsSignificance",
        "tea:resource/nicholsNonparametricPermutationTests2001"
      ],
      "exampleUseCases": [
        {
          "description": "Validating feature importance in medical diagnosis models by permuting each feature 10,000 times to ensure that identified risk factors (e.g., blood pressure, cholesterol) have statistically significant predictive power beyond random chance.",
          "goal": "Reliability"
        },
        {
          "description": "Testing whether observed differences in loan approval rates between demographic groups are statistically significant by permuting group labels and calculating the approval rate difference distribution under the null hypothesis of no discrimination.",
          "goal": "Explainability"
        },
        {
          "description": "Verifying that a model's claimed 95% accuracy on test data is genuinely better than random guessing by permuting labels 5,000 times and confirming the actual accuracy falls beyond the 99th percentile of the null distribution.",
          "goal": "Reliability"
        }
      ],
      "limitations": [
        {
          "description": "Computationally expensive as it requires thousands of model evaluations or metric calculations, scaling poorly with dataset size and model complexity."
        },
        {
          "description": "Requires many permutations (typically 5,000-10,000) to achieve reliable p-values for strict significance thresholds like p < 0.01."
        },
        {
          "description": "Assumes exchangeability of observations under the null hypothesis, which may be violated in time series or hierarchical data structures."
        },
        {
          "description": "Cannot be easily parallelised for some metrics that require global model retraining, limiting scalability for complex machine learning pipelines."
        }
      ],
      "sampleClaims": [
        {
          "text": "The model's performance advantage over baseline methods is statistically robust to random data partitioning",
          "domain": "general",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The observed differences in loan approval rates between demographic groups exceed what would occur by chance alone",
          "domain": "finance",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The identified risk factors maintain their predictive strength independent of incidental correlations in the training data",
          "domain": "healthcare",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The system's feature importance rankings reflect genuine signal rather than spurious patterns in the observed sample",
          "domain": "environmental",
          "assuranceGoal": "explainability"
        }
      ]
    },
    {
      "@id": "tea:technique/demographic-parity-assessment",
      "@type": "Technique",
      "name": "Demographic Parity Assessment",
      "slug": "demographic-parity-assessment",
      "description": "Demographic Parity Assessment evaluates whether a model produces equal positive prediction rates across different demographic groups, regardless of underlying differences in qualifications or base rates. It quantifies fairness using metrics like Statistical Parity Difference (the absolute difference in positive outcome rates between groups) or Disparate Impact ratio (the ratio of positive rates). Unlike techniques that modify data or models, this is purely a measurement approach that highlights when protected groups receive favourable outcomes at different rates, helping organisations identify and document potential discrimination.",
      "addressesGoal": [
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/bias-measurement",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/fairness-metric",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/technique-type/metric",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/lifecycle-stage/system-deployment",
        "tea:tag/lifecycle-stage/system-deployment/system-use-and-monitoring"
      ],
      "complexityRating": 1,
      "computationalCostRating": 1,
      "relatedTo": [
        "tea:technique/equal-opportunity-difference",
        "tea:technique/average-odds-difference",
        "tea:technique/counterfactual-fairness-assessment",
        "tea:technique/reweighing"
      ],
      "citesResource": [
        "tea:resource/fairlearndevelopersFairlearnDemographicParity2018",
        "tea:resource/trusted-aiAIF3602018",
        "tea:resource/dworkFairnessAwareness2011",
        "tea:resource/feldmanCertifyingRemovingDisparate2015",
        "tea:resource/AIF360TutorialDetecting",
        "tea:resource/iveDataCentricApproachDetecting2024",
        "tea:resource/pfohlEmpiricalCharacterizationFair2021"
      ],
      "exampleUseCases": [
        {
          "description": "Evaluating credit approval algorithms by calculating that loan approval rates for different racial groups must be within 20% of each other (0.8 disparate impact ratio), ensuring compliance with anti-discrimination regulations.",
          "goal": "Fairness"
        },
        {
          "description": "Monitoring hiring platforms by measuring that job recommendation rates for male vs female candidates remain statistically equivalent (Statistical Parity Difference < 0.05), preventing systemic gender bias in career opportunities.",
          "goal": "Fairness"
        },
        {
          "description": "Auditing healthcare triage systems to verify that urgent care assignment rates are equal across ethnic groups, ensuring that automated medical prioritisation doesn't disadvantage minority patients.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "Purely observational - identifies discrimination but doesn't provide solutions for remediation or bias mitigation."
        },
        {
          "description": "May penalise models for legitimate differences in base rates between groups, potentially forcing artificial equality where none should exist."
        },
        {
          "description": "Can conflict with individual fairness principles, where similarly qualified individuals might receive different treatment to achieve group parity."
        },
        {
          "description": "Doesn't account for quality of outcomes or consider whether equal rates are actually desirable given different group needs or preferences."
        }
      ],
      "sampleClaims": [
        {
          "text": "The recruitment system's job offer rates are statistically equivalent across gender groups",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The automated lending platform produces approval decisions at equal rates for all ethnic demographics",
          "domain": "finance",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The medical referral system assigns specialist appointments at consistent rates across patient age groups",
          "domain": "healthcare",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The benefits allocation system provides positive outcomes at equal rates across protected demographic categories",
          "domain": "public sector",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The admissions algorithm produces acceptance decisions at statistically indistinguishable rates for applicants from different socioeconomic backgrounds",
          "domain": "general",
          "assuranceGoal": "fairness"
        }
      ]
    },
    {
      "@id": "tea:technique/adversarial-debiasing",
      "@type": "Technique",
      "name": "Adversarial Debiasing",
      "slug": "adversarial-debiasing",
      "description": "Adversarial debiasing reduces bias by training models using a competitive adversarial setup, similar to Generative Adversarial Networks (GANs). The technique involves two neural networks: a predictor that learns to make accurate predictions on the main task, and an adversary (bias detector) that attempts to predict protected attributes (such as race, gender, or age) from the predictor's internal representations. Through adversarial training, the predictor learns to produce representations that retain predictive power for the main task whilst being uninformative about protected characteristics, thereby reducing discriminatory bias.",
      "addressesGoal": [
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/neural-networks",
        "tea:tag/applicable-models/paradigm/discriminative",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/differentiable",
        "tea:tag/applicable-models/requirements/gradient-access",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/in-processing",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/any",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-selection-and-training",
        "tea:tag/evidence-type/model-artefact"
      ],
      "complexityRating": 4,
      "computationalCostRating": 3,
      "relatedTo": [
        "tea:technique/fair-adversarial-networks",
        "tea:technique/reweighing"
      ],
      "citesResource": [
        "tea:resource/aif360developersAif360sklearninprocessingAdversarialDebiasingAif3600612018",
        "tea:resource/trusted-aiAIF3602018",
        "tea:resource/grariFairnessROADRobust2023",
        "tea:resource/zhangMitigatingUnwantedBiases2018",
        "tea:resource/AIF360DemoAdversarial",
        "tea:resource/yangAdversarialTrainingFramework2023"
      ],
      "exampleUseCases": [
        {
          "description": "Training a resume screening model for a technology company that evaluates candidates based on skills and experience whilst preventing the internal representations from encoding gender or ethnicity information, ensuring hiring decisions cannot be influenced by protected characteristics even indirectly through correlated features.",
          "goal": "Fairness"
        },
        {
          "description": "Developing a credit scoring model for loan approvals that accurately predicts default risk whilst ensuring the model's internal features cannot be used to infer applicants' race or age, thereby preventing discriminatory lending practices whilst maintaining predictive accuracy.",
          "goal": "Fairness"
        },
        {
          "description": "Creating a medical diagnosis model that makes accurate predictions about patient conditions whilst ensuring that the learned representations cannot reveal sensitive demographic information like gender or ethnicity, protecting patient privacy whilst maintaining clinical effectiveness.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "Significantly more complex to implement than standard models, requiring expertise in adversarial training techniques and careful architecture design for both predictor and adversary networks."
        },
        {
          "description": "Requires careful hyperparameter tuning to balance the competing objectives of task performance and bias mitigation, as overly strong adversarial training can harm predictive accuracy."
        },
        {
          "description": "Effectiveness heavily depends on the quality and design of the adversary network - a weak adversary may fail to detect subtle biases, whilst an overly strong adversary may eliminate useful information."
        },
        {
          "description": "Training can be unstable and may suffer from convergence issues common to adversarial training, requiring careful learning rate scheduling and regularisation techniques."
        },
        {
          "description": "Provides no formal guarantees about bias elimination and may not prevent all forms of discrimination, particularly when protected attributes can be inferred from other available features."
        }
      ],
      "sampleClaims": [
        {
          "text": "The model's internal representations cannot be used to infer protected characteristics of individuals",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The hiring system's learned features maintain predictive power for job suitability whilst being statistically independent of candidate gender",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The credit scoring model's intermediate layers do not encode information about applicants' race or ethnicity",
          "domain": "finance",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The diagnostic system achieves equitable performance across patient demographics without encoding sensitive attributes in its feature representations",
          "domain": "healthcare",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The facial recognition model's hidden representations are uninformative about protected characteristics whilst preserving identification accuracy",
          "domain": "autonomous systems",
          "assuranceGoal": "fairness"
        }
      ]
    },
    {
      "@id": "tea:technique/counterfactual-fairness-assessment",
      "@type": "Technique",
      "name": "Counterfactual Fairness Assessment",
      "slug": "counterfactual-fairness-assessment",
      "description": "Counterfactual Fairness Assessment tests a model against the criterion of Kusner et al. (2017): a model is counterfactually fair if each individual's prediction would have had the same distribution had their protected attribute, such as race or sex, been different, with everything that attribute causes changed accordingly. The assessor first writes down a causal model, a graph of which variables cause which, covering the protected attribute, the model's inputs and unobserved background factors, and fits its equations to data. For each individual, the fitted model is used to infer the background factors from what was observed (abduction), set the protected attribute to another value (action) and recompute every input the attribute influences (prediction), giving a counterfactual version of that person. The model under test is run on the factual and counterfactual inputs, and the gap between the two predictions, per individual or as a distance between the two prediction distributions, is the evidence: distributions that lie on top of each other indicate counterfactual fairness under the assumed causal model. Every causal effect of the attribute counts as unfair, including effects that run through inputs it influences, such as test scores, which is what separates this criterion from versions that allow some pathways.",
      "addressesGoal": [
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/bias-measurement",
        "tea:tag/data-requirements/causal-graph",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/tabular",
        "tea:tag/evidence-type/causal-analysis",
        "tea:tag/evidence-type/fairness-metric",
        "tea:tag/expertise-needed/causal-inference",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/technique-type/testing"
      ],
      "complexityRating": 5,
      "computationalCostRating": 3,
      "relatedTo": [
        "tea:technique/fairness-testing",
        "tea:technique/path-specific-counterfactual-fairness-assessment",
        "tea:technique/demographic-parity-assessment"
      ],
      "citesResource": [
        "tea:resource/kusnerCounterfactualFairness2017",
        "tea:resource/DoWhyUserGuide",
        "tea:resource/DoWhyPythonLibrary2026",
        "tea:resource/mkusnerCodeCounterfactualFairness2026",
        "tea:resource/DoWhyExampleNotebook",
        "tea:resource/kimCounterfactualFairnessEvaluation2025"
      ],
      "exampleUseCases": [
        {
          "description": "A law school's admissions office uses a model to predict first-year grades from entrance-test scores and undergraduate grades. Its analysts build a causal model in which race and sex influence both inputs alongside an unobserved knowledge factor, fit it to past cohorts, and compare each applicant's predicted grade under actual and counterfactual race. A systematic shift shows that leaving race out of the inputs did not make the model counterfactually fair.",
          "goal": "Fairness"
        },
        {
          "description": "A credit risk team, working with economists, specifies a causal graph in which an applicant's ethnicity affects income and neighbourhood but not repayment behaviour directly, fits it to its applicant data, and checks whether the approval model's scores change for the counterfactual applicants. The result goes to the model risk committee together with the graph, because the conclusion holds only under that graph.",
          "goal": "Fairness"
        },
        {
          "description": "A public employment service reviewing a model that predicts job-seekers' risk of long-term unemployment from education and work history specifies, with labour-market researchers, how sex and migration background influence those inputs. It tests whether individual risk scores would change under counterfactual sex or migration background before the scores are used to allocate support.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "The verdict rests on a causal model that cannot be checked against data: Kusner et al. note that counterfactual assumptions are generally unfalsifiable, even with experimental data, and should be treated as provisional. Different plausible graphs can give different verdicts, so a result is only as credible as the graph reported with it, and testing alternative graphs is part of the assessment."
        },
        {
          "description": "A common cause left out of the graph, such as school quality affecting both test scores and later grades, biases the counterfactuals without any warning sign. Kilbertus et al. (2019) show that counterfactual fairness is sensitive to such unmeasured confounding and give tools to bound the effect for additive noise models, which adds a further analysis to do."
        },
        {
          "description": "Every effect of the attribute counts as unfair, so a model that legitimately uses an input the attribute influences fails the test. Kusner et al. note that in practice few observed variables are unaffected by the attribute. Where some pathways are acceptable, for example where qualifications differ for reasons a decision may properly reflect, this criterion is stricter than the decision calls for."
        },
        {
          "description": "Computing individual counterfactuals requires a fitted probabilistic model of the unobserved background factors; the original study fitted it in Stan, and DoWhy's counterfactual function needs mechanisms with additive noise and supports only continuous variables. With categorical inputs, many variables or unstructured data such as text and images, the assessment becomes hard to run or yields a spread of counterfactuals rather than one."
        },
        {
          "description": "The counterfactual people are simulated by the fitted causal model, not observed. If its equations fit the data poorly or miss interactions, the counterfactual inputs are implausible and the measured gap reflects the causal model's errors as much as the predictor's; DoWhy's documentation notes counterfactual estimates are approximate for this reason."
        }
      ],
      "sampleClaims": [
        {
          "text": "Under the causal model agreed with the admissions committee, each applicant's predicted first-year grade has the same distribution under their actual and counterfactual race.",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "Under the documented causal graph linking ethnicity, income and neighbourhood, the credit model's approval scores do not change when applicants' ethnicity is counterfactually altered.",
          "domain": "finance",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The unemployment-risk model's individual scores are unchanged under counterfactual sex and migration background, given the causal model reviewed by labour-market researchers, and the sensitivity of that result to unmeasured confounding has been bounded.",
          "domain": "public sector",
          "assuranceGoal": "fairness"
        }
      ]
    },
    {
      "@id": "tea:technique/fairness-testing",
      "@type": "Technique",
      "name": "Fairness Testing",
      "slug": "fairness-testing",
      "description": "Fairness testing checks whether a model treats otherwise identical inputs differently because of a protected attribute, by changing only that attribute, or a name, term or other proxy that signals it, and measuring how often or how much the output changes. In the form introduced by Galhotra, Brun and Meliou (2017), a tester generates inputs from a description of the valid input fields, makes copies of each that differ only in the protected attribute (for example, recorded sex), runs them all through the system as a black box, and reports the causal discrimination score: the share of inputs whose decision changes, sampled until it is known within a chosen margin of error and confidence level. For text, the same test substitutes identity terms or names in otherwise unchanged sentences, such as one religion or ethnicity for another, and reports the average change in the model's score across the substitutions, which Garg et al. (2019) call the counterfactual token fairness gap. Because every other part of the input is held fixed, the test needs no model of how the attribute influences other variables: it measures whether the system itself responds to the attribute, or to the chosen proxy, and the output is a score per attribute with the input pairs that failed.",
      "addressesGoal": [
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/bias-measurement",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/tabular",
        "tea:tag/data-type/text",
        "tea:tag/evidence-type/fairness-metric",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/expertise-needed/evaluation-design",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/technique-type/testing"
      ],
      "complexityRating": 3,
      "computationalCostRating": 3,
      "citesResource": [
        "tea:resource/ThemisSoftwareFairness2026",
        "tea:resource/galhotraFairnessTestingTesting2017",
        "tea:resource/WhatIfToolFeatures",
        "tea:resource/asyrofiBiasFinderMetamorphicTest2021",
        "tea:resource/gargCounterfactualFairnessText2018",
        "tea:resource/LangTestDocumentationBias",
        "tea:resource/wilsonGenderRaceIntersectional2024"
      ],
      "exampleUseCases": [
        {
          "description": "A bank's model validation team tests a credit-approval model before release. For a sample of last year's applications it changes only the applicant's recorded sex, and separately their marital status, re-scores each pair, and reports the share of decisions that flip with a confidence interval, against a release threshold agreed with the compliance function.",
          "goal": "Fairness"
        },
        {
          "description": "A trust-and-safety team checks a toxicity classifier used to hold comments for review by substituting identity terms such as 'gay', 'Muslim' or 'Black' across a set of non-toxic comments. It measures the average change in toxicity score for each term and flags any term whose substitution pushes benign comments over the moderation threshold.",
          "goal": "Fairness"
        },
        {
          "description": "An HR technology supplier tests its CV-ranking service before a client deploys it, by submitting the same CVs under first names and surnames associated with different ethnicities and genders and reporting how often each candidate's rank or shortlisting changes.",
          "goal": "Fairness"
        },
        {
          "description": "A hospital's AI assurance lead tests a symptom-triage assistant with clinical vignettes that differ only in the patient's stated ethnicity. Clinicians first mark which vignettes should be unaffected by ethnicity, and only those pairs count as failures when the urgency rating changes.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "Holding every other input fixed measures only the system's direct response to the attribute or proxy. It does not follow through the effects the attribute has on other inputs, such as career breaks on an employment history, which Garg et al. note makes token substitution narrower than counterfactual fairness defined on a causal model. Where those downstream effects matter, a clean result does not show that individuals were treated fairly."
        },
        {
          "description": "The test covers only what is perturbed. Discrimination through unlisted identity terms, unperturbed proxies, or references to a group that span several words goes undetected; Garg et al. found that mitigation which closed the gap for the listed terms generalised much less to held-out terms. A pass is a pass for the perturbations tried, and the list needs domain review."
        },
        {
          "description": "Generated inputs may be unrealistic. Themis draws inputs uniformly from the input schema, so the score covers combinations that never occur in practice; restricting the test to real inputs or an existing test suite makes the score only as representative as that set, which Galhotra et al. note cannot be given a confidence level."
        },
        {
          "description": "Not every substitution should leave the output unchanged. Garg et al. give 'That's so gay' versus 'That's so straight' as a pair a toxicity model may rightly score differently, and clinical risk can legitimately depend on sex. Without a judgement about which pairs must match, the test raises false alarms or, if such pairs are excluded wholesale, hides real failures."
        },
        {
          "description": "A model can pass and still produce very different outcome or error rates across groups, because the test asks only whether changing the attribute changes the output, not whether outcomes are equal. Galhotra et al. distinguish this causal discrimination from group discrimination, and Garg et al. found that reducing the token fairness gap could worsen the true positive rate, so it does not replace group metrics."
        }
      ],
      "sampleClaims": [
        {
          "text": "Changing only an applicant's recorded sex changes the credit model's decision for fewer than 0.5% of last year's applications, at 95% confidence.",
          "domain": "finance",
          "assuranceGoal": "fairness"
        },
        {
          "text": "Substituting any listed identity term into non-toxic comments changes the moderation classifier's toxicity score by less than 0.05 on average.",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The CV-ranking service returns the same shortlist when names associated with different ethnicities and genders are swapped on otherwise identical CVs.",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The triage assistant's urgency rating does not change when a patient's stated ethnicity is changed in vignettes that clinicians judged should be unaffected by it.",
          "domain": "healthcare",
          "assuranceGoal": "fairness"
        }
      ]
    },
    {
      "@id": "tea:technique/gan-based-tabular-synthetic-data",
      "@type": "Technique",
      "name": "GAN-Based Tabular Synthetic Data",
      "slug": "gan-based-tabular-synthetic-data",
      "description": "Generates synthetic tabular datasets using Generative Adversarial Networks, most commonly through architectures such as CTGAN (Conditional Tabular GAN) and TVAE (Triplet-based Variational Autoencoder). These models learn the joint distribution of mixed-type columns — continuous, discrete, and categorical — by training a generator and discriminator in an adversarial framework, with mode-specific normalisation to handle multimodal continuous distributions and training-by-sampling to address class imbalance. The resulting synthetic tables aim to preserve statistical relationships, correlations, and marginal distributions of the original data whilst containing no real records, supporting privacy-preserving data sharing, model development on sensitive datasets, and augmentation of limited training data.",
      "addressesGoal": [
        "tea:goal/privacy",
        "tea:goal/reliability",
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/neural-networks/generative/gan",
        "tea:tag/applicable-models/architecture/neural-networks/generative/vae",
        "tea:tag/applicable-models/paradigm/generative",
        "tea:tag/applicable-models/paradigm/unsupervised",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/applicable-models/requirements/gradient-access",
        "tea:tag/assurance-goal-category/privacy",
        "tea:tag/assurance-goal-category/privacy/exposure-reduction",
        "tea:tag/assurance-goal-category/privacy/exposure-reduction/data-minimisation",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/robustness",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/pre-processing",
        "tea:tag/data-type/tabular",
        "tea:tag/evidence-type/synthetic-data",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/expertise-needed/privacy-engineering",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/lifecycle-stage/project-design",
        "tea:tag/lifecycle-stage/project-design/data-extraction-or-procurement",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/preprocessing-and-feature-engineering"
      ],
      "complexityRating": 4,
      "computationalCostRating": 4,
      "relatedTo": [
        "tea:technique/statistical-oversampling-methods",
        "tea:technique/synthetic-data-evaluation",
        "tea:technique/differential-privacy",
        "tea:technique/fairness-gan"
      ],
      "citesResource": [
        "tea:resource/CTGANSynthesizerSyntheticData2026",
        "tea:resource/sdv-devSDV2018",
        "tea:resource/SdvdevCTGAN2026",
        "tea:resource/xuModelingTabularData2019",
        "tea:resource/santosHowGenerateRealWorld2023",
        "tea:resource/habibiImbalancedTabularData2023",
        "tea:resource/bourouReviewTabularData2021"
      ],
      "exampleUseCases": [
        {
          "description": "Generating synthetic patient records from hospital databases using CTGAN to enable multi-institution collaborative research on treatment outcomes without sharing identifiable health data across organisational boundaries.",
          "goal": "Privacy"
        },
        {
          "description": "Augmenting a limited fraud detection training set by generating synthetic fraudulent transaction records that preserve the statistical characteristics of rare fraud patterns, improving model recall on underrepresented fraud types.",
          "goal": "Reliability"
        },
        {
          "description": "Creating balanced synthetic datasets for credit scoring by generating additional records for underrepresented demographic groups, enabling fairness testing across protected characteristics without collecting new sensitive data.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "Training instability inherent to GAN architectures (mode collapse, vanishing gradients) can result in synthetic data that fails to capture the full diversity of the original distribution, particularly for rare categories or tail distributions."
        },
        {
          "description": "Requires substantial computational resources and hyperparameter tuning, with training times scaling poorly for datasets with many columns or complex inter-column dependencies."
        },
        {
          "description": "Privacy guarantees are not inherent — without additional mechanisms like differential privacy, GAN-generated data may leak information about training records through memorisation or membership inference attacks."
        },
        {
          "description": "Performance degrades significantly on datasets with high cardinality categorical columns, complex temporal dependencies, or relational structures across multiple tables."
        }
      ],
      "sampleClaims": [
        {
          "text": "The synthetic patient dataset generated by CTGAN preserves statistical correlations between clinical variables whilst containing no records traceable to real patients",
          "domain": "healthcare",
          "assuranceGoal": "privacy"
        },
        {
          "text": "The augmented training dataset includes GAN-generated records for underrepresented demographic groups, achieving balanced representation across all protected characteristics",
          "domain": "finance",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The fraud detection model has been validated on GAN-generated synthetic transaction data that preserves the statistical distribution of rare fraud patterns from the original dataset",
          "domain": "finance",
          "assuranceGoal": "reliability"
        }
      ]
    },
    {
      "@id": "tea:technique/statistical-oversampling-methods",
      "@type": "Technique",
      "name": "Statistical Oversampling Methods",
      "slug": "statistical-oversampling-methods",
      "description": "A family of data augmentation techniques that generate synthetic minority-class examples through geometric interpolation in feature space, addressing class imbalance problems that degrade classifier performance on underrepresented groups. The foundational method, SMOTE (Synthetic Minority Over-sampling Technique), creates new instances by interpolating between existing minority samples and their k-nearest neighbours. Extensions include Borderline-SMOTE (focusing generation near decision boundaries), ADASYN (adaptively weighting harder-to-learn instances), and SVMSMOTE (using support vectors to guide generation). These methods operate directly on feature vectors without requiring neural network training, making them computationally lightweight and applicable to any tabular classification task.",
      "addressesGoal": [
        "tea:goal/fairness",
        "tea:goal/reliability"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/pre-processing",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/robustness",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-type/tabular",
        "tea:tag/evidence-type/synthetic-data",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/preprocessing-and-feature-engineering",
        "tea:tag/applicable-models/requirements/black-box"
      ],
      "complexityRating": 2,
      "computationalCostRating": 1,
      "relatedTo": [
        "tea:technique/sequential-cart-synthesis",
        "tea:technique/synthetic-data-evaluation",
        "tea:technique/gan-based-tabular-synthetic-data"
      ],
      "citesResource": [
        "tea:resource/OversamplingImbalancedlearnUser",
        "tea:resource/ScikitlearncontribImbalancedlearn2026",
        "tea:resource/chawlaSMOTESyntheticMinority2002",
        "tea:resource/heADASYNAdaptiveSynthetic2008",
        "tea:resource/CompareOversamplingSamplers",
        "tea:resource/blagusSMOTEHighdimensionalClassimbalanced2013",
        "tea:resource/wongvorachanComparisonUndersamplingOversampling2023"
      ],
      "exampleUseCases": [
        {
          "description": "Applying SMOTE to oversample underrepresented ethnic groups in a loan approval training dataset, ensuring the classifier has sufficient examples from each demographic group to learn fair decision boundaries.",
          "goal": "Fairness"
        },
        {
          "description": "Using ADASYN to generate synthetic examples of rare manufacturing defect types, improving the reliability of quality control classifiers on edge cases that occur in fewer than 1% of production runs.",
          "goal": "Reliability"
        },
        {
          "description": "Applying Borderline-SMOTE to augment minority-class examples near the decision boundary in a medical diagnosis task, reducing false-negative rates for rare conditions without collecting additional patient data.",
          "goal": "Reliability"
        },
        {
          "description": "Oversampling underrepresented protected groups in a hiring dataset to enable equitable evaluation of candidates across gender and ethnicity, ensuring the model does not simply learn to predict the majority class.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "Interpolation in feature space can generate synthetic instances that fall in regions of the feature space not occupied by the true data distribution, introducing noise or unrealistic combinations — particularly problematic for high-dimensional data."
        },
        {
          "description": "Does not address the root cause of class imbalance (e.g. data collection bias, structural underrepresentation) and may mask rather than resolve underlying fairness issues in the data pipeline."
        },
        {
          "description": "Performance degrades on high-dimensional datasets where the nearest-neighbour assumption breaks down, and oversampling in such spaces can amplify noise dimensions without improving classification."
        },
        {
          "description": "Assumes the minority class forms coherent clusters in feature space; when minority examples are scattered or overlap heavily with majority-class regions, interpolation produces ambiguous or mislabelled synthetic samples."
        }
      ],
      "sampleClaims": [
        {
          "text": "The training dataset has been balanced using SMOTE oversampling to ensure the classifier has sufficient representation of all demographic groups for equitable decision-making",
          "domain": "finance",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The rare defect classifier has been trained on an ADASYN-augmented dataset that maintains the original feature distributions whilst ensuring adequate representation of all defect categories",
          "domain": "manufacturing",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The diagnostic model performance on rare conditions has been improved through Borderline-SMOTE augmentation targeting samples near the decision boundary, without introducing fabricated clinical relationships",
          "domain": "healthcare",
          "assuranceGoal": "reliability"
        }
      ]
    },
    {
      "@id": "tea:technique/sequential-cart-synthesis",
      "@type": "Technique",
      "name": "Sequential CART Synthesis",
      "slug": "sequential-cart-synthesis",
      "description": "Sequential CART synthesis creates an artificial copy of a confidential microdata set (records about individual people or organisations) that can be released in place of the real data. Variables are synthesised one at a time in a chosen order: the first is generated by sampling with replacement from its observed values, and for each later variable a classification or regression tree (CART) is fitted on the real data to predict it from the variables earlier in the order. Each synthetic record is passed down that tree using its already-synthesised values, and the new value is copied from a randomly chosen real record in the leaf it reaches, so the joint distribution of the data is rebuilt as a chain of conditional distributions. Disclosure risk is limited by setting a minimum leaf size, smoothing synthesised continuous values and removing synthetic records that reproduce unique real ones, and several synthetic copies can be released so that analysts can allow for the extra uncertainty that synthesis adds.",
      "addressesGoal": [
        "tea:goal/privacy"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/privacy",
        "tea:tag/assurance-goal-category/privacy/exposure-reduction",
        "tea:tag/assurance-goal-category/privacy/exposure-reduction/data-minimisation",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/data-type/tabular",
        "tea:tag/evidence-type/synthetic-data",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/expertise-needed/privacy-engineering",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/lifecycle-stage/project-design",
        "tea:tag/lifecycle-stage/project-design/data-extraction-or-procurement",
        "tea:tag/lifecycle-stage/project-design/data-analysis"
      ],
      "complexityRating": 3,
      "computationalCostRating": 2,
      "citesResource": [
        "tea:resource/nowokSynthpopBespokeCreation2016",
        "tea:resource/nowokSynthpopGeneratingSynthetic2025",
        "tea:resource/UsingCARTGenerate",
        "tea:resource/GetStartedSynthpop",
        "tea:resource/nowokProvidingBespokeSynthetic2017"
      ],
      "exampleUseCases": [
        {
          "description": "A national longitudinal study that links census, health and education records for a sample of the population cannot let approved researchers take the data off site. Its support team runs CART synthesis to produce a bespoke synthetic extract for each project, so researchers can explore the data and write and test their analysis code at their own institution before the final model is run on the real data in the secure setting.",
          "goal": "Privacy"
        },
        {
          "description": "A hospital trust wants a university team to develop a readmission model without receiving patient records. It releases a CART-synthesised copy of the admissions table with a minimum leaf size of ten and kernel smoothing of continuous values, removes any synthetic record that matches a unique real patient on age, sex and postcode district, and runs a disclosure-risk assessment before release.",
          "goal": "Privacy"
        },
        {
          "description": "A national statistics office publishes a synthetic teaching file of its labour force survey for university courses, generated by sequential CART synthesis with the variable order and minimum leaf sizes chosen with subject experts, and labels every record as synthetic so that no reader mistakes a row for a real respondent.",
          "goal": "Privacy"
        }
      ],
      "limitations": [
        {
          "description": "It gives no formal privacy guarantee. No synthetic record is a real person, but trees can reproduce rare combinations and extreme values, and an intruder who knows that a real record holds the largest value of a variable can bound it from the synthetic maximum. Risk must be measured for each release and reduced with larger leaves, smoothing and removal of unique matches, each of which costs analytical value."
        },
        {
          "description": "Relationships the trees miss disappear from the synthetic data. A tree grown from few records may never split on a variable that matters, so the synthetic data show no association where the real data have one; in the method's original evaluation a regression coefficient for sex was attenuated to zero in this way. Small subgroups and weak effects are the most exposed."
        },
        {
          "description": "Results depend on the order in which variables are synthesised and on which earlier variables predict each later one. A careless order can produce impossible combinations, such as a detailed category that contradicts the summary variable derived from it, so detailed variables should be synthesised before derived ones and the output checked for inconsistencies."
        },
        {
          "description": "Synthetic data cannot reproduce every analysis of the real data. Analyses the synthesiser did not plan for may give different answers, so a release should state which analyses it supports, and users should confirm key findings on the real data, for example through a verification service or secure access."
        }
      ],
      "sampleClaims": [
        {
          "text": "The research extract released to the project team was generated by sequential CART synthesis with a minimum leaf size of ten and smoothing of continuous variables, and contains no record that reproduces a unique combination in the source data.",
          "assuranceGoal": "privacy",
          "domain": "public sector"
        },
        {
          "text": "No confidential microdata left the secure environment during model development: external researchers wrote and tested their code on a synthetic extract, and only the final approved model was run on the real data.",
          "assuranceGoal": "privacy",
          "domain": "government"
        },
        {
          "text": "A disclosure-risk assessment of the synthetic admissions table found no synthetic record matching a unique real patient on the agreed identifying variables.",
          "assuranceGoal": "privacy",
          "domain": "healthcare"
        }
      ]
    },
    {
      "@id": "tea:technique/federated-learning",
      "@type": "Technique",
      "name": "Federated Learning",
      "slug": "federated-learning",
      "description": "Federated learning enables collaborative model training across multiple distributed parties (devices, organisations, or data centres) without requiring centralised data sharing. Participants train models locally on their private datasets and only share model updates (gradients, weights, or aggregated statistics) with a central coordinator. This distributed approach serves multiple purposes: preserving data privacy and sovereignty, reducing communication costs, enabling learning from diverse data sources, improving model robustness through heterogeneous training, and facilitating compliance with data protection regulations whilst maintaining model performance comparable to centralised training.",
      "addressesGoal": [
        "tea:goal/privacy",
        "tea:goal/reliability"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/linear-models",
        "tea:tag/applicable-models/architecture/neural-networks",
        "tea:tag/applicable-models/paradigm/parametric",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/gradient-access",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/assurance-goal-category/privacy",
        "tea:tag/assurance-goal-category/privacy/exposure-reduction",
        "tea:tag/assurance-goal-category/privacy/exposure-reduction/data-minimisation",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/robustness",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/evidence-type/model-artefact",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/software-engineering",
        "tea:tag/expertise-needed/privacy-engineering",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-selection-and-training",
        "tea:tag/data-requirements/no-special-requirements"
      ],
      "complexityRating": 4,
      "computationalCostRating": 5,
      "relatedTo": [
        "tea:technique/differential-privacy",
        "tea:technique/homomorphic-encryption",
        "tea:technique/machine-unlearning",
        "tea:technique/data-poisoning-detection"
      ],
      "citesResource": [
        "tea:resource/openfldevelopersOpenFederatedLearning2020",
        "tea:resource/FlwrlabsFlowerFlower2026",
        "tea:resource/mcmahanCommunicationEfficientLearningDeep2023",
        "tea:resource/beutelFederatedLearningDeepLearningAI2025",
        "tea:resource/dayanFederatedLearningPredicting2021",
        "tea:resource/patiFederatedLearningEnables2022"
      ],
      "exampleUseCases": [
        {
          "description": "Developing a smartphone keyboard prediction model by learning from users' typing patterns without their text ever leaving their devices, enabling personalised predictions whilst maintaining complete data privacy.",
          "goal": "Privacy"
        },
        {
          "description": "Training a medical diagnosis model across multiple hospitals without sharing patient records, ensuring model robustness by learning from diverse patient populations and clinical practices across different institutions.",
          "goal": "Reliability"
        }
      ],
      "limitations": [
        {
          "description": "Communication overhead can be substantial, especially with frequent model updates and large models, potentially limiting scalability and increasing training time compared to centralised approaches."
        },
        {
          "description": "Statistical heterogeneity across participants (non-IID data distributions) can lead to training instability, slower convergence, and reduced model performance compared to centralised training on pooled data."
        },
        {
          "description": "System heterogeneity in computational capabilities, network connectivity, and availability of participating devices can create bottlenecks and introduce bias towards more capable participants."
        },
        {
          "description": "Privacy vulnerabilities remain through gradient leakage attacks, model inversion, and membership inference attacks that can potentially reconstruct sensitive information from shared model updates."
        },
        {
          "description": "Coordination complexity increases with the number of participants, requiring sophisticated aggregation protocols, fault tolerance mechanisms, and secure communication infrastructure."
        }
      ],
      "sampleClaims": [
        {
          "text": "The model training process does not require patient data to leave individual healthcare institutions",
          "domain": "healthcare",
          "assuranceGoal": "privacy"
        },
        {
          "text": "The diagnostic model performs reliably despite learning from patient populations with heterogeneous clinical characteristics across multiple sites",
          "domain": "healthcare",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The keyboard prediction model learns from user typing patterns without transmitting personal text content to central servers",
          "domain": "general",
          "assuranceGoal": "privacy"
        }
      ]
    },
    {
      "@id": "tea:technique/differential-privacy",
      "@type": "Technique",
      "name": "Differential Privacy",
      "slug": "differential-privacy",
      "description": "Differential privacy provides mathematically rigorous privacy protection by adding carefully calibrated random noise to data queries, statistical computations, or machine learning outputs. The technique works by ensuring that the presence or absence of any individual's data has minimal impact on the results - specifically, any query result should be nearly indistinguishable whether or not a particular person's data is included. This is achieved through controlled noise addition that scales with the query's sensitivity and a privacy budget (epsilon) that quantifies the privacy-utility trade-off. The smaller the epsilon, the more noise is added and the stronger the privacy guarantee, but at the cost of reduced accuracy.",
      "addressesGoal": [
        "tea:goal/privacy",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/assurance-goal-category/privacy",
        "tea:tag/assurance-goal-category/privacy/formal-guarantee",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/confidential-verification",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/privacy-guarantee",
        "tea:tag/expertise-needed/cryptography",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/expertise-needed/privacy-engineering",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/preprocessing-and-feature-engineering"
      ],
      "complexityRating": 5,
      "computationalCostRating": 3,
      "relatedTo": [
        "tea:technique/federated-learning",
        "tea:technique/homomorphic-encryption",
        "tea:technique/machine-unlearning",
        "tea:technique/membership-inference-attack-testing",
        "tea:technique/gan-based-tabular-synthetic-data"
      ],
      "citesResource": [
        "tea:resource/nearGuidelinesEvaluatingDifferential2025",
        "tea:resource/googleDifferentialprivacy2019",
        "tea:resource/meta-pytorchOpacus2019",
        "tea:resource/dworkAlgorithmicFoundationsDifferential2014",
        "tea:resource/dworkCalibratingNoiseSensitivity2006",
        "tea:resource/ProgrammingDifferentialPrivacy2024",
        "tea:resource/abowd2020CensusDisclosure2022",
        "tea:resource/erlingssonRAPPOR2014"
      ],
      "exampleUseCases": [
        {
          "description": "Protecting individual privacy in census data analysis by adding calibrated noise to demographic statistics, ensuring households cannot be re-identified whilst maintaining accurate population insights for policy planning.",
          "goal": "Privacy"
        },
        {
          "description": "Publishing differentially private aggregate statistics about model performance across different demographic groups, enabling transparent bias auditing without exposing sensitive individual prediction details or group membership.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Adding noise inherently reduces the accuracy and utility of results, with stronger privacy guarantees (smaller epsilon values) leading to more significant degradation in data quality."
        },
        {
          "description": "Setting the privacy budget (epsilon) requires expertise and careful consideration of the privacy-utility trade-off, with no universal guidelines for appropriate values across different applications."
        },
        {
          "description": "Sequential queries consume the privacy budget cumulatively, potentially requiring careful query planning and potentially prohibiting future analyses once the budget is exhausted."
        },
        {
          "description": "Implementation complexity is high, requiring deep understanding of sensitivity analysis, noise mechanisms, and composition theorems to avoid inadvertent privacy violations."
        },
        {
          "description": "May not protect against all privacy attacks, particularly sophisticated adversaries with auxiliary information or when combined with other data sources that could aid re-identification."
        }
      ],
      "sampleClaims": [
        {
          "text": "The census data analysis results remain statistically indistinguishable whether any single household's data is included or excluded",
          "domain": "public sector",
          "assuranceGoal": "privacy"
        },
        {
          "text": "The medical research system's published statistics provide quantified privacy guarantees that bound the maximum disclosure risk for any individual patient",
          "domain": "healthcare",
          "assuranceGoal": "privacy"
        },
        {
          "text": "The model performance metrics across demographic groups are accompanied by documented privacy budget allocation and noise parameters",
          "domain": "general",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The system's privacy protection level is mathematically bounded and remains effective even under repeated queries within the allocated budget",
          "domain": "general",
          "assuranceGoal": "privacy"
        }
      ]
    },
    {
      "@id": "tea:technique/homomorphic-encryption",
      "@type": "Technique",
      "name": "Homomorphic Encryption",
      "slug": "homomorphic-encryption",
      "description": "Homomorphic encryption allows computation on encrypted data without decrypting it first, producing encrypted results that, when decrypted, match the results of performing the same operations on the plaintext. This enables secure outsourced computation where sensitive data remains encrypted throughout processing. By allowing ML operations on encrypted data, it provides strong privacy guarantees for applications involving highly sensitive information.",
      "addressesGoal": [
        "tea:goal/privacy",
        "tea:goal/transparency",
        "tea:goal/security"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/linear-models",
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/architecture/neural-networks/feedforward",
        "tea:tag/applicable-models/architecture/tree-based",
        "tea:tag/applicable-models/paradigm/discriminative",
        "tea:tag/applicable-models/paradigm/parametric",
        "tea:tag/assurance-goal-category/privacy",
        "tea:tag/assurance-goal-category/privacy/formal-guarantee",
        "tea:tag/assurance-goal-category/security",
        "tea:tag/assurance-goal-category/security/protection",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/confidential-verification",
        "tea:tag/data-requirements/no-special-requirements",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/privacy-guarantee",
        "tea:tag/expertise-needed/cryptography",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/lifecycle-stage/system-deployment",
        "tea:tag/lifecycle-stage/system-deployment/system-implementation"
      ],
      "complexityRating": 5,
      "computationalCostRating": 5,
      "relatedTo": [
        "tea:technique/differential-privacy",
        "tea:technique/federated-learning",
        "tea:technique/membership-inference-attack-testing"
      ],
      "citesResource": [
        "tea:resource/openfhe-developmentdevelopersWelcomeOpenFHEsDocumentation2023",
        "tea:resource/zama-aiConcreteml2022",
        "tea:resource/microsoftSEAL2018",
        "tea:resource/gentryFullyHomomorphicEncryption2009",
        "tea:resource/GettingStartedConcrete2025",
        "tea:resource/kimSecureLogisticRegression2018",
        "tea:resource/blattOptimizedHomomorphicEncryption2020"
      ],
      "exampleUseCases": [
        {
          "description": "Enabling a cloud-based medical diagnosis service to process encrypted patient data and return encrypted results without the cloud provider ever accessing actual medical information, ensuring complete patient privacy during outsourced computation.",
          "goal": "Privacy"
        },
        {
          "description": "Enabling transparent audit of algorithmic decision-making by allowing regulators to verify model computations on encrypted data, providing accountability whilst protecting the proprietary nature of both the algorithm and the underlying data.",
          "goal": "Transparency"
        },
        {
          "description": "Protecting ML model intellectual property and confidential inference inputs during cloud deployment by running encrypted inference, ensuring that neither the client sensitive input data nor the server proprietary model weights and architecture are exposed to the cloud provider or the counterparty, enabling secure outsourced inference without requiring mutual trust assumptions.",
          "goal": "Security"
        }
      ],
      "limitations": [
        {
          "description": "Extremely computationally expensive, often 100-1000x slower than unencrypted computation, making it impractical for real-time applications or large-scale data processing."
        },
        {
          "description": "Limited range of operations supported efficiently, with complex operations like divisions, comparisons, and non-polynomial functions being particularly challenging or impossible to implement."
        },
        {
          "description": "Implementation requires deep cryptographic expertise to avoid security vulnerabilities, choose appropriate parameters, and optimise performance for specific use cases."
        },
        {
          "description": "Memory and storage requirements are significantly higher than traditional computation, as encrypted data typically requires much more space than plaintext equivalents."
        },
        {
          "description": "Current fully homomorphic encryption schemes have practical limitations on computation depth before noise accumulation requires expensive bootstrapping operations to refresh ciphertexts."
        }
      ],
      "sampleClaims": [
        {
          "text": "The cloud-based service processes patient data without the service provider ever accessing the underlying medical information",
          "domain": "healthcare",
          "assuranceGoal": "privacy"
        },
        {
          "text": "The system's computational outputs are mathematically guaranteed to match results that would be obtained from unencrypted processing",
          "domain": "general",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The financial analysis platform maintains data confidentiality throughout all computational operations performed by third-party infrastructure",
          "domain": "finance",
          "assuranceGoal": "security"
        },
        {
          "text": "The public sector system allows regulatory oversight of algorithmic decisions whilst protecting both citizen data and proprietary model parameters from disclosure",
          "domain": "public sector",
          "assuranceGoal": "transparency"
        }
      ]
    },
    {
      "@id": "tea:technique/quantile-regression",
      "@type": "Technique",
      "name": "Quantile Regression",
      "slug": "quantile-regression",
      "description": "Quantile regression estimates specific percentiles (quantiles) of the target variable rather than just predicting the average outcome. For example, instead of predicting 'average house price = £300,000', it can predict 'there's a 10% chance the price will be below £250,000, 50% chance below £300,000, and 90% chance below £380,000'. This technique reveals how input features affect different parts of the outcome distribution - perhaps property size strongly influences luxury homes (90th percentile) but barely affects budget properties (10th percentile). By capturing the full conditional distribution, quantile regression provides rich uncertainty information and enables robust prediction intervals.",
      "addressesGoal": [
        "tea:goal/reliability",
        "tea:goal/transparency",
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/linear-models/regression",
        "tea:tag/applicable-models/architecture/neural-networks",
        "tea:tag/applicable-models/architecture/tree-based/gradient-boosting",
        "tea:tag/applicable-models/paradigm/parametric",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/performance-by-group",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/uncertainty-quantification",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/confidence-and-limits",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-type/tabular",
        "tea:tag/evidence-type/prediction-interval",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-selection-and-training"
      ],
      "complexityRating": 3,
      "computationalCostRating": 2,
      "relatedTo": [
        "tea:technique/conformal-prediction",
        "tea:technique/bootstrapping",
        "tea:technique/jackknife-resampling",
        "tea:technique/platt-scaling"
      ],
      "citesResource": [
        "tea:resource/Statsmodelsregressionquantile_regressionQuantReg",
        "tea:resource/statsmodelsStatsmodels2011",
        "tea:resource/koenkerRegressionQuantiles1978",
        "tea:resource/QuantileRegression",
        "tea:resource/nielsenUsingQuantileRegression2005"
      ],
      "exampleUseCases": [
        {
          "description": "Predicting patient recovery times after surgery by estimating multiple quantiles (e.g., 25th, 50th, 75th percentiles), enabling doctors to communicate realistic timeframes: 'Most patients recover within 2-4 weeks, but some may take up to 8 weeks', providing robust uncertainty estimates for treatment planning.",
          "goal": "Reliability"
        },
        {
          "description": "Revealing how income inequality affects different segments of society by showing how education's impact varies across income quantiles - demonstrating that education benefits high earners much more than low earners, providing transparent insights into systemic inequalities.",
          "goal": "Transparency"
        },
        {
          "description": "Ensuring equitable loan amount predictions across demographic groups by verifying that the spread of predicted loan amounts (difference between 90th and 10th percentiles) is consistent across protected groups, preventing discriminatory practices in lending ranges.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "Computationally intensive when fitting multiple quantiles simultaneously, especially for large datasets or complex models, as each quantile requires separate optimization."
        },
        {
          "description": "May produce crossing quantiles without proper constraints, where predicted 90th percentile values are lower than 50th percentile values, creating logically inconsistent and unusable prediction intervals."
        },
        {
          "description": "Sensitive to outliers and heavy-tailed distributions, particularly in extreme quantiles (e.g., 5th or 95th percentiles), which can lead to unstable and unreliable estimates."
        },
        {
          "description": "Requires careful selection of quantile levels and may need domain expertise to interpret results meaningfully, as different quantiles may reveal conflicting patterns in feature relationships."
        },
        {
          "description": "Less effective with small datasets where extreme quantiles cannot be reliably estimated due to insufficient data points in the tails of the distribution."
        }
      ],
      "sampleClaims": [
        {
          "text": "The flood forecasting model provides distinct uncertainty bounds for extreme and typical rainfall scenarios without assuming symmetric error distributions",
          "domain": "environmental",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The lending system's predicted loan amounts reveal how applicant characteristics affect outcomes differently for small versus large loans",
          "domain": "finance",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The model's uncertainty estimates span consistently across protected groups when predicting both low-risk and high-risk outcomes",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The patient recovery time predictions distinguish between typical cases and outlier cases without relying on normally distributed residuals",
          "domain": "healthcare",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The system communicates how treatment effectiveness varies across the full spectrum of patient outcomes rather than only average effects",
          "domain": "healthcare",
          "assuranceGoal": "transparency"
        }
      ]
    },
    {
      "@id": "tea:technique/conformal-prediction",
      "@type": "Technique",
      "name": "Conformal Prediction",
      "slug": "conformal-prediction",
      "description": "Conformal prediction provides mathematically guaranteed uncertainty quantification by creating prediction sets that contain the true outcome with a specified probability (e.g., exactly 95% coverage). The technique works by measuring how 'strange' or 'nonconforming' new predictions are compared to calibration data - if a prediction seems unusual, it gets wider intervals. For example, in medical diagnosis, instead of saying 'likely cancer', it might say 'possible diagnoses: {cancer, benign tumour} with 95% confidence'. This distribution-free method works with any underlying model (neural networks, random forests, etc.) and requires no assumptions about data distribution, making it a robust framework for reliable uncertainty estimates in high-stakes applications.",
      "addressesGoal": [
        "tea:goal/reliability",
        "tea:goal/transparency",
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/performance-by-group",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/uncertainty-quantification",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/confidence-and-limits",
        "tea:tag/data-requirements/calibration-set",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/prediction-interval",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/lifecycle-stage/system-deployment",
        "tea:tag/lifecycle-stage/system-deployment/system-implementation"
      ],
      "complexityRating": 4,
      "computationalCostRating": 2,
      "relatedTo": [
        "tea:technique/bootstrapping",
        "tea:technique/quantile-regression",
        "tea:technique/deep-ensembles"
      ],
      "citesResource": [
        "tea:resource/mapiedevelopersMAPIEModelAgnostic2021",
        "tea:resource/scikit-learn-contribMAPIE2021",
        "tea:resource/shaferTutorialConformalPrediction2007",
        "tea:resource/PlotPredictionSets",
        "tea:resource/olssonEstimatingDiagnosticUncertainty2022"
      ],
      "exampleUseCases": [
        {
          "description": "Creating prediction sets for drug discovery that guarantee 95% coverage, such as 'this compound will likely have activity against {target A, target B, target C}', ensuring reliable decision-making in costly experimental validation.",
          "goal": "Reliability"
        },
        {
          "description": "Providing transparent multi-class predictions in judicial risk assessment by showing all plausible risk categories with guaranteed coverage, enabling judges to see the full range of possibilities rather than just a single point estimate.",
          "goal": "Transparency"
        },
        {
          "description": "Ensuring fair uncertainty quantification across demographic groups in college admissions by verifying that prediction set sizes (number of possible outcomes) are consistent across protected groups, preventing discriminatory overconfidence for certain populations.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "Prediction sets can be unnecessarily wide when nonconformity scores vary greatly across the feature space, leading to conservative intervals that reduce practical utility."
        },
        {
          "description": "Requires a held-out calibration set separate from training data, reducing the amount of data available for model training, which can impact performance on small datasets."
        },
        {
          "description": "Guarantees only hold under the exchangeability assumption - if test data distribution differs significantly from calibration data, coverage guarantees may be violated."
        },
        {
          "description": "For multi-class problems, prediction sets may include many classes when the model is uncertain, making decisions difficult when sets contain opposing outcomes."
        },
        {
          "description": "Computational cost increases with the number of calibration samples, and efficient implementation requires careful design for large-scale or real-time applications."
        }
      ],
      "sampleClaims": [
        {
          "text": "The diagnostic system's prediction sets contain the correct outcome with a guaranteed minimum coverage rate across all patient presentations",
          "domain": "healthcare",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The system's uncertainty estimates maintain their specified validity guarantees regardless of the underlying data distribution",
          "domain": "general",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The model communicates uncertainty by providing a set of plausible outcomes rather than a single point prediction",
          "domain": "finance",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The prediction sets achieve equivalent coverage rates across demographic groups without requiring distributional assumptions",
          "domain": "public sector",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The autonomous system's safety-critical predictions are accompanied by statistically guaranteed confidence bounds",
          "domain": "autonomous systems",
          "assuranceGoal": "reliability"
        }
      ]
    },
    {
      "@id": "tea:technique/platt-scaling",
      "@type": "Technique",
      "name": "Platt Scaling",
      "slug": "platt-scaling",
      "description": "Platt scaling turns a classifier's raw scores into calibrated probabilities, meaning that among the cases given a probability of 0.3, about 30 per cent turn out to be positive. It was introduced for support vector machines, whose outputs are distances from a decision boundary rather than probabilities, and applies to any binary classifier that produces a real-valued score. After the classifier is trained, a two-parameter logistic (sigmoid) curve, P(y = 1 | f) = 1 / (1 + exp(A·f + B)), is fitted by maximum likelihood to map each score f to a probability, using labelled cases the classifier was not trained on, taken from a held-out set or from cross-validation folds. The fitted curve is strictly monotonic, so the order of cases and ranking measures such as the area under the ROC curve are unchanged; only the probability attached to each case moves. The output is a recalibrated model, assessed with a reliability diagram (predicted probability plotted against observed frequency) and the Brier score or log loss before and after.",
      "addressesGoal": [
        "tea:goal/reliability",
        "tea:goal/transparency",
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/calibration",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/confidence-and-limits",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/performance-by-group",
        "tea:tag/data-requirements/calibration-set",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/model-artefact",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/lifecycle-stage/system-deployment",
        "tea:tag/lifecycle-stage/system-deployment/model-updating-or-deprovisioning"
      ],
      "complexityRating": 1,
      "computationalCostRating": 1,
      "citesResource": [
        "tea:resource/116ProbabilityCalibration",
        "tea:resource/Scikitlearn",
        "tea:resource/plattProbabilitiesSVMachines2000",
        "tea:resource/ProbabilityCalibrationCurves",
        "tea:resource/liouAssessingCalibrationBias2024"
      ],
      "exampleUseCases": [
        {
          "description": "A retail bank's credit-risk team finds that its gradient-boosted default model ranks applicants well but squeezes predicted default probabilities towards the middle of the range. Before the probabilities feed expected-loss provisioning, the team fits Platt scaling on a held-out year of loan outcomes and checks on a reliability diagram that predicted and observed default rates agree in every score decile.",
          "goal": "Reliability"
        },
        {
          "description": "A benefits agency uses a linear support vector machine to flag claims for manual review, but its margin scores mean nothing to caseworkers. The team applies Platt scaling so the review screen can show the probability that a claim needs correcting, publishes the calibration curve in the caseworker guidance, and explains that the figure is a rate across similar claims rather than a verdict on the individual.",
          "goal": "Transparency"
        },
        {
          "description": "A hospital network recalibrates a deployed malnutrition-risk model by fitting a two-parameter logistic map to the model's log-odds on recent admissions, then compares calibration intercept and slope separately for Black and White patients and for men and women, to check that the same risk score means the same likelihood of malnutrition in each group before the scores guide dietitian referrals.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "The sigmoid shape is an assumption. It corrects the S-shaped distortion typical of support vector machines and boosted trees, whose probabilities bunch towards the middle, but not the reverse distortion of overconfident models such as naive Bayes, whose probabilities pile up near 0 and 1. Where the reliability diagram shows that pattern, a flexible method such as isotonic regression is needed."
        },
        {
          "description": "It works best when the classifier's scores for the two classes are spread in a similar way (roughly normal with equal variance). In highly imbalanced problems this often fails, and a two-parameter fit can leave the rare class poorly calibrated, which an overall score such as the Brier score can hide."
        },
        {
          "description": "The curve must be fitted on labelled cases that played no part in training. The classifier separates its own training data better than new data, so a curve fitted to training scores overstates confidence in use; the cost is a held-out calibration set taken from scarce labelled data, or cross-validation with several model fits."
        },
        {
          "description": "A single curve fitted across the whole population does not guarantee calibration within each subgroup. Fitting a separate curve per group needs group membership at prediction time, which may be unavailable or unlawful to use, and enough labelled cases in every group to estimate two parameters reliably."
        },
        {
          "description": "It is defined for two classes. For multiclass problems each class is calibrated against the rest and the resulting probabilities are renormalised to sum to one, adding two parameters per class; for multiclass neural networks, temperature scaling, which fits one parameter shared by all classes, is the simpler alternative."
        }
      ],
      "sampleClaims": [
        {
          "text": "After Platt scaling on a held-out year of loan outcomes, the default model's predicted probabilities agree with observed default rates in every score decile, within the tolerance set in the model risk policy.",
          "assuranceGoal": "reliability",
          "domain": "finance"
        },
        {
          "text": "Recalibrating the defect classifier with Platt scaling left its ranking of parts, measured by the area under the ROC curve on the test set, unchanged while reducing its log loss.",
          "assuranceGoal": "reliability",
          "domain": "manufacturing"
        },
        {
          "text": "The probability shown to caseworkers for each flagged claim is calibrated against held-out review outcomes, so a displayed 30 per cent corresponds to roughly 30 in 100 similar claims needing correction.",
          "assuranceGoal": "transparency",
          "domain": "public sector"
        },
        {
          "text": "After recalibration, the malnutrition-risk model's calibration intercept and slope do not differ materially between patients grouped by race or by sex.",
          "assuranceGoal": "fairness",
          "domain": "healthcare"
        }
      ]
    },
    {
      "@id": "tea:technique/temperature-scaling",
      "@type": "Technique",
      "name": "Temperature Scaling",
      "slug": "temperature-scaling",
      "description": "Temperature scaling adjusts a model's confidence by applying a single parameter (temperature) to its predictions. When a model is too confident in its wrong answers, temperature scaling can fix this by making the predictions more realistic. It works by dividing the model's outputs by the temperature value before converting them to probabilities. Higher temperatures make the model less confident, whilst lower temperatures increase confidence. The technique maintains the model's accuracy whilst ensuring that when it says it's 90% confident, it's actually right about 90% of the time.",
      "addressesGoal": [
        "tea:goal/reliability",
        "tea:goal/transparency",
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/neural-networks",
        "tea:tag/applicable-models/paradigm/discriminative",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/probabilistic-output",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/performance-by-group",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/calibration",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/confidence-and-limits",
        "tea:tag/applicable-models/requirements/model-internals",
        "tea:tag/data-requirements/calibration-set",
