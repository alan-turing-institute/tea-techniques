        "tea:resource/andersZennitChr5tphrZennit2026",
        "tea:resource/bachPixelWiseExplanationsNonLinear2015",
        "tea:resource/TutorialImplementingLayerWise",
        "tea:resource/montavonLayerWiseRelevancePropagation2019",
        "tea:resource/bohleLayerWiseRelevancePropagation2019"
      ],
      "exampleUseCases": [
        {
          "description": "Identifying which pixels in chest X-rays contribute to pneumonia detection, helping radiologists verify AI diagnoses by highlighting anatomical regions the model considers relevant.",
          "goal": "Explainability"
        },
        {
          "description": "Debugging a neural network's misclassification of handwritten digits by tracing relevance through layers to identify which input pixels caused the error and which network layers amplified it.",
          "goal": "Explainability"
        },
        {
          "description": "Providing transparent explanations for automated credit scoring decisions by showing which financial features received positive or negative relevance scores, enabling clear regulatory reporting.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Requires different propagation rules for each layer type, making implementation complex for new architectures."
        },
        {
          "description": "Can produce negative relevance scores which may be difficult to interpret intuitively."
        },
        {
          "description": "Rule selection (LRP-ε, LRP-γ, etc.) significantly affects results and requires domain expertise."
        },
        {
          "description": "Limited to feedforward networks and may not work well with modern architectures like transformers without substantial modifications."
        }
      ],
      "sampleClaims": [
        {
          "text": "The diagnostic model's predictions are decomposable into quantified contributions from individual imaging features throughout the network's processing pathway",
          "domain": "healthcare",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The credit assessment system's decisions are traceable to specific financial indicators with their positive and negative relevance scores documented for regulatory review",
          "domain": "finance",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The visual perception system's classification errors can be traced backwards through network layers to identify which input regions and intermediate representations contributed to the misclassification",
          "domain": "autonomous systems",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The quality inspection model documents how each pixel in defect images propagates through the neural network to influence the final classification outcome",
          "domain": "manufacturing",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The environmental monitoring system's predictions are explainable through feature-level contribution scores that sum to the total prediction value",
          "domain": "environmental",
          "assuranceGoal": "explainability"
        }
      ]
    },
    {
      "@id": "tea:technique/contextual-decomposition",
      "@type": "Technique",
      "name": "Contextual Decomposition",
      "slug": "contextual-decomposition",
      "description": "Contextual Decomposition explains LSTM and RNN predictions by decomposing the final hidden state into contributions from individual inputs and their interactions. Unlike simpler attribution methods, it separates the direct contribution of specific words or phrases from the contextual effects of surrounding words. This is particularly useful for understanding how sequential models process language, as it can identify whether a word's influence comes from its individual meaning or from its interaction with nearby words in the sequence.",
      "addressesGoal": [
        "tea:goal/explainability",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/assurance-goal-category/explainability",
        "tea:tag/assurance-goal-category/explainability/representation-analysis/decomposition",
        "tea:tag/assurance-goal-category/explainability/attribution-methods/model-specific",
        "tea:tag/assurance-goal-category/explainability/explains/feature-importance",
        "tea:tag/assurance-goal-category/explainability/explains/internal-mechanisms",
        "tea:tag/assurance-goal-category/explainability/property/completeness",
        "tea:tag/assurance-goal-category/explainability/property/fidelity",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/decision-reasons",
        "tea:tag/data-requirements/no-special-requirements",
        "tea:tag/data-type/text",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/explanatory-scope/local",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/applicable-models/architecture/neural-networks/recurrent",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/applicable-models/requirements/architecture-specific",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation"
      ],
      "complexityRating": 5,
      "computationalCostRating": 3,
      "relatedTo": [
        "tea:technique/layer-wise-relevance-propagation",
        "tea:technique/deeplift",
        "tea:technique/integrated-gradients",
        "tea:technique/attention-weight-analysis"
      ],
      "citesResource": [
        "tea:resource/murdochContextualDecompositionJamiemurdochContextualDecomposition2026",
        "tea:resource/singhHierarchicalNeuralnetInterpretations2026",
        "tea:resource/jamesmurdochWordImportanceContextual2018",
        "tea:resource/ContextualDecompositionDemo",
        "tea:resource/r.InterpretingPatientSpecificRisk2019"
      ],
      "exampleUseCases": [
        {
          "description": "Analysing why an LSTM-based spam filter flagged an email by decomposing contributions from individual words ('free', 'urgent') versus their contextual interactions ('free trial' together).",
          "goal": "Explainability"
        },
        {
          "description": "Understanding how a medical text classifier diagnoses conditions from clinical notes by separating direct symptom mentions from contextual medical reasoning patterns.",
          "goal": "Explainability"
        },
        {
          "description": "Providing transparent explanations for automated content moderation decisions by showing which words and phrase interactions contributed to toxicity detection.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Primarily designed for LSTM and simple RNN architectures, not suitable for modern transformers or attention-based models."
        },
        {
          "description": "Not widely implemented in standard machine learning libraries, often requiring custom implementation."
        },
        {
          "description": "Computational overhead increases significantly with sequence length and model depth."
        },
        {
          "description": "May not scale well to very complex models or capture all types of feature interactions in deep networks."
        }
      ],
      "sampleClaims": [
        {
          "text": "The clinical text classifier's predictions are attributable to specific medical terms independent of their surrounding context",
          "domain": "healthcare",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The sentiment analysis model's outputs distinguish between individual word meanings and their contextual interactions within phrases",
          "domain": "finance",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The content moderation system's decisions are explainable through phrase-level contribution analysis showing how word combinations influence toxicity detection",
          "domain": "general",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The document classification system's reasoning process separates direct keyword importance from sequential dependencies in the text",
          "domain": "public sector",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The natural language command interpreter provides transparent decomposition of how individual words and their contextual relationships drive action selection",
          "domain": "autonomous systems",
          "assuranceGoal": "transparency"
        }
      ]
    },
    {
      "@id": "tea:technique/taylor-decomposition",
      "@type": "Technique",
      "name": "Taylor Decomposition",
      "slug": "taylor-decomposition",
      "description": "Taylor Decomposition is a mathematical technique that explains neural network predictions by computing first-order and higher-order derivatives of the network's output with respect to input features. It decomposes the prediction into relevance scores that indicate how much each input feature and feature interaction contributes to the final decision. The method uses Layer-wise Relevance Propagation (LRP) principles to trace prediction contributions backwards through the network layers, providing precise mathematical attributions for each input element.",
      "addressesGoal": [
        "tea:goal/explainability"
      ],
      "hasTag": [
        "tea:tag/assurance-goal-category/explainability",
        "tea:tag/assurance-goal-category/explainability/representation-analysis/decomposition",
        "tea:tag/assurance-goal-category/explainability/attribution-methods/gradient-based",
        "tea:tag/assurance-goal-category/explainability/explains/feature-importance",
        "tea:tag/assurance-goal-category/explainability/explains/internal-mechanisms",
        "tea:tag/assurance-goal-category/explainability/property/completeness",
        "tea:tag/assurance-goal-category/explainability/property/fidelity",
        "tea:tag/applicable-models/requirements/model-internals",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/explanatory-scope/local",
        "tea:tag/technique-type/algorithmic",
