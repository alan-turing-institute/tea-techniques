      "sourceType": "technical_paper",
      "authors": [
        "David Bau",
        "Bolei Zhou",
        "Aditya Khosla",
        "Aude Oliva",
        "Antonio Torralba"
      ],
      "publicationDate": "2017-7"
    },
    {
