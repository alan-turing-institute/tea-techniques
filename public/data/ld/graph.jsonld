      "@id": "tea:resource/DatasetCardsHugging",
      "@type": "Resource",
      "name": "Dataset Cards — Hugging Face Hub documentation",
      "citationKey": "DatasetCardsHugging",
      "url": "https://huggingface.co/docs/hub/datasets-cards",
