      "@id": "tea:resource/gohMultimodalNeuronsArtificial2021",
      "@type": "Resource",
      "name": "Multimodal Neurons in Artificial Neural Networks",
      "citationKey": "gohMultimodalNeuronsArtificial2021",
      "url": "https://doi.org/10.23915/distill.00030",
      "sourceType": "application_paper",
      "authors": [
        "Gabriel Goh",
