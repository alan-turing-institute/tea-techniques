      "@id": "tea:resource/lomonacoAvalancheEndtoEndLibrary2021",
      "@type": "Resource",
      "name": "Avalanche: an End-to-End Library for Continual Learning",
      "citationKey": "lomonacoAvalancheEndtoEndLibrary2021",
      "url": "https://github.com/ContinualAI/avalanche",
