        "tea:resource/ResamplingMonteCarlo"
      ],
      "exampleUseCases": [
        {
          "description": "Estimating uncertainty in financial risk models by resampling historical data to understand how predictions might vary under different historical scenarios.",
          "goal": "Reliability"
        },
        {
          "description": "Providing confidence intervals for medical diagnosis predictions to help doctors understand the reliability of AI recommendations and make more informed treatment decisions.",
          "goal": "Transparency"
        },
        {
          "description": "Assessing whether prediction uncertainty is consistent across different demographic groups in hiring algorithms, identifying if the model is systematically more uncertain for certain populations.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "Computationally expensive as it requires training multiple models on resampled datasets."
        },
        {
          "description": "Does not account for uncertainty in model structure or architecture choices."
        },
        {
          "description": "Cannot detect systematically missing data patterns or biases present in the original dataset."
        },
        {
          "description": "Assumes that the original dataset is representative of the population of interest."
        }
      ],
      "sampleClaims": [
        {
          "text": "The financial risk model's uncertainty estimates are robust to random variation in the historical data sample",
          "domain": "finance",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The clinical decision support system communicates prediction variability through confidence bounds derived from data resampling",
          "domain": "healthcare",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The environmental model's uncertainty quantification does not rely on distributional assumptions about measurement errors",
          "domain": "environmental",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The hiring algorithm's prediction stability is consistent across demographic groups when assessed using resampled training data",
          "domain": "public sector",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The system's confidence intervals reflect genuine variability in model predictions across different data samples",
          "domain": "general",
          "assuranceGoal": "transparency"
        }
      ]
    },
    {
      "@id": "tea:technique/jackknife-resampling",
      "@type": "Technique",
      "name": "Jackknife Resampling",
      "slug": "jackknife-resampling",
      "description": "Jackknife resampling (also called leave-one-out resampling) assesses model stability and uncertainty by systematically removing one data point at a time and retraining the model on the remaining data. Unlike bootstrapping which samples with replacement, jackknife creates n different models by excluding each of the n data points once. This systematic approach reveals how individual points influence results, provides robust estimates of prediction variance, and identifies unusually influential observations that may be outliers or leverage points affecting model reliability.",
      "addressesGoal": [
        "tea:goal/reliability",
        "tea:goal/transparency",
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/performance-by-group",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/uncertainty-quantification",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/confidence-and-limits",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation"
      ],
      "complexityRating": 3,
      "computationalCostRating": 5,
      "relatedTo": [
        "tea:technique/bootstrapping",
        "tea:technique/cross-validation",
        "tea:technique/influence-functions"
      ],
      "citesResource": [
        "tea:resource/scikit-learndevelopersScikitlearnModel_selectionLeaveOneOut2007",
        "tea:resource/Scikitlearn",
        "tea:resource/quenouilleNOTESBIASESTIMATION1956",
        "tea:resource/JackknifeLectureNotes"
      ],
      "exampleUseCases": [
        {
          "description": "Evaluating how removing individual countries from a global climate model affects predictions, identifying which regions have outsized influence and providing robust uncertainty estimates for climate projections used in policy decisions.",
          "goal": "Reliability"
        },
        {
          "description": "Providing transparent uncertainty estimates in medical risk prediction by showing how individual patient records influence model predictions, enabling clinicians to understand prediction stability and confidence intervals for treatment decisions.",
          "goal": "Transparency"
        },
        {
          "description": "Ensuring fair model evaluation in hiring algorithms by systematically testing how removing candidates from different demographic groups affects model performance, revealing whether certain populations disproportionately influence the model's behaviour.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "Extremely computationally intensive for large datasets, requiring training of n separate models for n data points, making it impractical for datasets with thousands or millions of observations."
        },
        {
          "description": "May underestimate uncertainty compared to bootstrapping or other resampling methods, as it provides only n different samples rather than a broader exploration of the data distribution."
        },
        {
          "description": "Assumes that removing single data points provides meaningful insights into model stability, which may not hold when multiple correlated observations drive model behaviour."
        },
        {
          "description": "Can be sensitive to the choice of performance metric used for evaluation, as different metrics may show different patterns of sensitivity to individual data points."
        },
        {
          "description": "Provides limited insight into model behaviour on truly novel data, as each jackknife sample is only minimally different from the full training set."
        }
      ],
      "sampleClaims": [
        {
          "text": "The environmental model's uncertainty estimates do not depend on assumptions about sampling distribution or resampling variability",
          "domain": "environmental",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The clinical prediction model's performance stability is quantified by systematically examining the influence of each individual patient record",
          "domain": "healthcare",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The credit risk model's predictions are traceable to specific historical loan records that most strongly influence assessment outcomes",
          "domain": "finance",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The hiring model's performance is not disproportionately dependent on individual candidates from particular demographic groups",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The public benefit allocation system identifies individual case records that exert unusual influence on eligibility determinations",
          "domain": "public sector",
          "assuranceGoal": "fairness"
        }
      ]
    },
    {
      "@id": "tea:technique/cross-validation",
      "@type": "Technique",
      "name": "Cross-validation",
      "slug": "cross-validation",
      "description": "Cross-validation evaluates model performance and robustness by systematically partitioning data into multiple subsets (folds) and training/testing repeatedly on different combinations. Common approaches include k-fold (splitting into k equal parts), stratified (preserving class distributions), and leave-one-out variants. By testing on multiple independent holdout sets, it reveals how performance varies across different data subsamples, provides robust estimates of generalisation ability, and helps detect overfitting or model instability that single train-test splits might miss.",
      "addressesGoal": [
        "tea:goal/reliability",
        "tea:goal/fairness",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/technique-type/testing",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/performance-assessment",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/performance-by-group",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/assessment-results",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation"
      ],
      "complexityRating": 2,
      "computationalCostRating": 3,
      "relatedTo": [
        "tea:technique/bootstrapping",
        "tea:technique/jackknife-resampling",
        "tea:technique/permutation-tests",
        "tea:technique/conformal-prediction"
      ],
      "citesResource": [
        "tea:resource/scikit-learndevelopersCrossvalidationEvaluatingEstimator2007",
        "tea:resource/Scikitlearn",
        "tea:resource/kohaviStudyCrossValidationBootstrap1995",
        "tea:resource/stoneCrossValidatoryChoiceAssessment1974",
        "tea:resource/VisualizingCrossvalidationBehavior",
        "tea:resource/varoquauxCrossvalidationFailureSmall2018"
      ],
      "exampleUseCases": [
        {
          "description": "Using 10-fold cross-validation to estimate a healthcare prediction model's true accuracy and detect overfitting, ensuring robust performance estimates that generalise beyond the specific training sample to new patient populations.",
          "goal": "Reliability"
        },
        {
          "description": "Providing transparent model evaluation in regulatory submissions by showing consistent performance across multiple validation folds, demonstrating to auditors that model performance claims are not cherry-picked from a single favourable test set.",
          "goal": "Transparency"
        },
        {
          "description": "Ensuring fair model evaluation across demographic groups by using stratified cross-validation that maintains representative proportions of protected classes in each fold, revealing whether performance is consistent across different population segments.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "Computationally expensive for large datasets or complex models, requiring multiple training runs that scale linearly with the number of folds."
        },
        {
          "description": "Can provide overly optimistic performance estimates when data has dependencies or structure (e.g., time series, grouped observations) that violate independence assumptions."
        },
        {
          "description": "May not reflect real-world performance if the training data distribution differs significantly from future deployment conditions or population shifts."
        },
        {
          "description": "Choice of fold number (k) involves a bias-variance trade-off: fewer folds reduce computational cost but increase variance in estimates, whilst more folds increase computation but may introduce bias."
        },
        {
          "description": "Standard cross-validation doesn't account for temporal ordering in sequential data, potentially leading to data leakage where future information influences past predictions."
        }
      ],
      "sampleClaims": [
        {
          "text": "The model's performance estimate is robust to the particular train-test partition used",
          "domain": "general",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The fraud detection system generalizes consistently across different subsets of historical transaction data",
          "domain": "finance",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The diagnostic model's validation results are reproducible across multiple independent holdout sets",
          "domain": "healthcare",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The system maintains equitable performance across demographic groups when evaluated on different data partitions",
          "domain": "public sector",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The model's accuracy claims reflect genuine predictive capability rather than overfitting to a single test set",
          "domain": "general",
          "assuranceGoal": "transparency"
        }
      ]
    },
    {
      "@id": "tea:technique/area-under-precision-recall-curve",
      "@type": "Technique",
      "name": "Area Under Precision-Recall Curve",
      "slug": "area-under-precision-recall-curve",
      "description": "Area Under Precision-Recall Curve (AUPRC) measures model performance by plotting precision (the proportion of positive predictions that are correct) against recall (the proportion of actual positives that are correctly identified) at various classification thresholds, then calculating the area under the resulting curve. Unlike accuracy or AUC-ROC, AUPRC is particularly valuable for imbalanced datasets where the minority class is of primary interest---a perfect score is 1.0, whilst random performance equals the positive class proportion. By focusing on the precision-recall trade-off, it provides a more informative assessment than overall accuracy for scenarios where false positives and false negatives have different costs, especially when positive examples are rare.",
      "addressesGoal": [
        "tea:goal/reliability",
        "tea:goal/transparency",
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/applicable-models/requirements/probabilistic-output",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/performance-by-group",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/performance-assessment",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/assessment-results",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/technique-type/metric",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation"
      ],
      "acronym": "AUPRC",
      "complexityRating": 2,
      "computationalCostRating": 2,
      "relatedTo": [
        "tea:technique/bootstrapping",
        "tea:technique/equal-opportunity-difference",
        "tea:technique/cross-validation"
      ],
      "citesResource": [
        "tea:resource/PrecisionRecallFmeasures",
        "tea:resource/Scikitlearn",
        "tea:resource/davisRelationshipPrecisionRecallROC2006",
        "tea:resource/scikit-learndevelopersScikitlearnPrecisionRecall2007",
        "tea:resource/ozennePrecisionRecallCurve2015"
      ],
      "exampleUseCases": [
        {
          "description": "Evaluating fraud detection models where genuine transactions far outnumber fraudulent ones, using AUPRC to optimise the balance between catching fraud (high recall) and minimising false alarms (high precision) for cost-effective operations.",
          "goal": "Reliability"
        },
        {
          "description": "Providing transparent performance metrics for rare disease detection systems to medical regulators, where AUPRC clearly shows model effectiveness on the minority positive class rather than being masked by high accuracy on negative cases.",
          "goal": "Transparency"
        },
        {
          "description": "Ensuring fair evaluation of loan default prediction across demographic groups by comparing AUPRC scores, revealing whether models perform equally well at identifying high-risk borrowers regardless of protected characteristics.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "More sensitive to class distribution than ROC curves, making it difficult to compare models across datasets with different positive class proportions or to set universal performance thresholds."
        },
        {
          "description": "Can be overly optimistic on extremely imbalanced datasets where even random predictions may achieve seemingly high AUPRC scores due to the small positive class size."
        },
        {
          "description": "Provides limited insight into performance at specific operating points, requiring additional analysis to determine optimal threshold selection for deployment."
        },
        {
          "description": "Interpolation methods for calculating the area under the curve can vary between implementations, potentially leading to slightly different scores for the same model."
        },
        {
          "description": "Less interpretable than simple metrics like precision or recall at a fixed threshold, making it harder to communicate performance to non-technical stakeholders."
        }
      ],
      "sampleClaims": [
        {
          "text": "The fraud detection model maintains consistent performance at identifying fraudulent transactions across different precision-recall operating points",
          "domain": "finance",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The diagnostic system's ability to detect rare conditions is quantified independently of its performance on common cases",
          "domain": "healthcare",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The model's performance at identifying minority class instances is equitable across demographic groups",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The autonomous system's detection capabilities for safety-critical events are robust across different tolerance thresholds for false alarms",
          "domain": "autonomous systems",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The credit risk model's performance metrics account for the imbalance between default and non-default cases in the portfolio",
          "domain": "finance",
          "assuranceGoal": "transparency"
        }
      ]
    },
    {
      "@id": "tea:technique/safety-envelope-testing",
      "@type": "Technique",
      "name": "Safety Envelope Testing",
      "slug": "safety-envelope-testing",
      "description": "Safety envelope testing systematically evaluates AI system performance at the boundaries of its intended operational domain to identify potential failure modes before deployment. The technique involves defining the system's operational design domain (ODD), creating test scenarios that approach or exceed these boundaries, and measuring performance degradation as conditions become more challenging. By testing edge cases, environmental extremes, and boundary conditions, it reveals where the system transitions from safe to unsafe operation, enabling the establishment of clear operational limits and safety margins for deployment.",
      "addressesGoal": [
        "tea:goal/safety",
        "tea:goal/reliability"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/robustness",
        "tea:tag/assurance-goal-category/safety",
        "tea:tag/assurance-goal-category/safety/verification",
        "tea:tag/data-requirements/test-scenarios",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/boundary-analysis",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/expertise-needed/safety-engineering",
        "tea:tag/expertise-needed/evaluation-design",
        "tea:tag/technique-type/testing",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation"
      ],
      "complexityRating": 4,
      "computationalCostRating": 4,
      "relatedTo": [
        "tea:technique/red-teaming",
        "tea:technique/out-of-domain-detection",
        "tea:technique/runtime-monitoring-and-circuit-breakers"
      ],
      "citesResource": [
        "tea:resource/RoadVehiclesTest",
        "tea:resource/koopmanChallengesAutonomousVehicle2016",
        "tea:resource/heSystemSafetyAnalysis2022a"
      ],
      "exampleUseCases": [
        {
          "description": "Testing autonomous vehicle perception systems at the limits of weather conditions, lighting, and sensor coverage to establish safe operational boundaries and determine when human intervention is required.",
          "goal": "Safety"
        },
        {
          "description": "Evaluating medical AI diagnostic systems with edge cases near decision boundaries to ensure reliable performance and identify when the system should defer to human specialists.",
          "goal": "Reliability"
        },
        {
          "description": "Assessing financial trading algorithms under extreme market conditions and volatility to prevent catastrophic losses and ensure system shutdown protocols activate appropriately.",
          "goal": "Safety"
        }
      ],
      "limitations": [
        {
          "description": "Requires comprehensive domain expertise to identify relevant boundary conditions and edge cases that could affect system safety."
        },
        {
          "description": "May be computationally expensive and time-consuming, especially for complex systems with high-dimensional operational domains."
        },
        {
          "description": "Difficult to achieve complete coverage of all possible boundary conditions, potentially missing critical edge cases."
        },
        {
          "description": "Results may not generalise to novel scenarios that fall outside the tested boundary conditions."
        },
        {
          "description": "Establishing appropriate safety thresholds and performance criteria requires careful calibration based on domain-specific risk tolerance."
        }
      ],
      "sampleClaims": [
        {
          "text": "The autonomous vehicle system recognizes when environmental conditions approach the limits of its validated operational envelope and initiates appropriate fallback behaviors",
          "domain": "autonomous systems",
          "assuranceGoal": "safety"
        },
        {
          "text": "The diagnostic system's performance degradation is characterized across the full range of patient presentation complexity, establishing clear thresholds for specialist referral",
          "domain": "healthcare",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The forecasting model maintains quantified accuracy bounds under progressively extreme weather conditions up to documented operational limits",
          "domain": "environmental",
          "assuranceGoal": "safety"
        },
        {
          "text": "The trading algorithm's decision quality is measured systematically across market volatility conditions, with defined cutoffs for automated trading suspension",
          "domain": "finance",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The quality control system's inspection reliability has been tested at the boundaries of lighting, part orientation, and surface condition variations expected in production",
          "domain": "manufacturing",
          "assuranceGoal": "safety"
        }
      ]
    },
    {
      "@id": "tea:technique/algorithm-review-boards",
      "@type": "Technique",
      "name": "Algorithm Review Boards",
      "slug": "algorithm-review-boards",
      "description": "An algorithm review board is a standing, multidisciplinary body inside an organisation that examines proposed AI systems or AI research projects at set points and decides whether, and on what conditions, they may proceed. The literature also calls these bodies AI ethics boards or AI review boards. They differ from an Institutional Review Board (IRB), which protects the human subjects of research, because they also weigh harms to the people a system will affect and to society. A risk-based triage decides which projects need full review; the project team then submits a written account of the system's purpose, data, foreseeable harms and planned mitigations, and members drawn from technical, legal, ethical and domain backgrounds, sometimes with people from affected communities, question the team and iterate on that account with them. The board approves, approves with conditions such as a monitoring plan or a re-review date, or rejects, and the output is a dated decision record with its reasons and conditions that later reviews and audits can check against what was built.",
      "addressesGoal": [
        "tea:goal/general",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/data-requirements/no-special-requirements",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/decision-record",
        "tea:tag/evidence-type/governance-framework",
        "tea:tag/evidence-type/qualitative-report",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/expertise-needed/ethics",
        "tea:tag/expertise-needed/regulatory-compliance",
        "tea:tag/expertise-needed/stakeholder-engagement",
        "tea:tag/expertise-needed/governance-and-audit",
        "tea:tag/technique-type/process",
        "tea:tag/assurance-goal-category/general",
        "tea:tag/assurance-goal-category/general/governance-and-review",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/audit-trail",
        "tea:tag/lifecycle-stage/other/cross-cutting",
        "tea:tag/lifecycle-stage/project-design",
        "tea:tag/lifecycle-stage/project-design/project-planning",
        "tea:tag/lifecycle-stage/system-deployment",
        "tea:tag/lifecycle-stage/system-deployment/system-implementation"
      ],
      "complexityRating": 4,
      "computationalCostRating": 1,
      "relatedTo": [
        "tea:technique/human-in-the-loop-safeguards",
        "tea:technique/model-cards",
        "tea:technique/model-development-audit-trails"
      ],
      "citesResource": [
        "tea:resource/LookingWeLeap2022",
        "tea:resource/schuettHowDesignAI2025",
        "tea:resource/jordanDesigningArtificialIntelligence2019",
        "tea:resource/bernsteinEthicsSocietyReview2021",
        "tea:resource/ESRProcessToolkit",
        "tea:resource/hadleyInvestigatingAlgorithmReview2024",
        "tea:resource/bedoyaFrameworkOversightLocal2022"
      ],
      "exampleUseCases": [
        {
          "description": "A hospital group's algorithm review board examines a sepsis early-warning model before a ward pilot. It approves the pilot on condition of a monitoring plan for alert rates and missed cases, names who may switch the model off, and sets a re-review once six months of local performance data are in, before any wider roll-out.",
          "goal": "General"
        },
        {
          "description": "A bank's board reviews a proposed credit-limit model before launch. It asks the team for its disparate-impact analysis by protected group and for evidence that applicants can contest a decision, and withholds approval until both are supplied, so the decision to deploy rests with a body outside the development team.",
          "goal": "General"
        },
        {
          "description": "A university AI research programme releases grant funding only after each project has passed an ethics and society review, in which researchers state the risks their work poses to society and to particular groups, commit to mitigations, and revise them with an interdisciplinary faculty panel.",
          "goal": "General"
        },
        {
          "description": "A government department publishes the board's decision record for a benefits-triage tool, giving the reasons for approval, the conditions attached and the re-review date, so that its oversight committee and the public can see what was examined, by whom and when, and check later that the conditions were met.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Review adds time and cost to every project that goes through it, and organisations under commercial pressure may route work around the board or narrow its remit, so the board's coverage, not just its existence, needs to be shown."
        },
        {
          "description": "Its judgements are only as good as its membership. A board without the relevant technical, domain or community expertise will miss harms that fall outside what its members know, and a board drawn mainly from inside the team's own reporting line is open to group-think."
        },
        {
          "description": "Independence is hard to keep inside an organisation. Practitioners report tension between profit and the cost of responsible-AI review, and a board can come under pressure to approve projects that leadership has already committed to, which weakens it most where review matters most."
        },
        {
          "description": "Without authority to stop or delay a project, and a way to check that its conditions are met, a board's recommendations can be ignored. Evidence from a board is strong only when its decision record shows what it could block and what happened to its conditions."
        },
        {
          "description": "There is no agreed measure of whether a board works, and review can become box-ticking. A record that a project was reviewed shows that a process ran, not that the review was substantive or that its concerns were addressed."
        }
      ],
      "sampleClaims": [
        {
          "text": "Every high-risk AI system was reviewed and approved by the organisation's algorithm review board before operational use, and the board could have blocked deployment",
          "domain": "general",
          "assuranceGoal": "general"
        },
        {
          "text": "The conditions the review board attached to the credit-limit model's approval, including a disparate-impact analysis by protected group and a re-review date, were met before and after launch",
          "domain": "finance",
          "assuranceGoal": "general"
        },
        {
          "text": "The clinical decision-support model was deployed under a monitoring plan and re-review schedule set by a multidisciplinary review board independent of the development team",
          "domain": "healthcare",
          "assuranceGoal": "general"
        },
        {
          "text": "The diagnostic AI system's development and deployment decisions are traceable to dated board decision records that state the risks assessed, the reasons for approval and the conditions attached",
          "domain": "healthcare",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The review board's decision record for the risk assessment tool, with its reasons and conditions, is available to the oversight body and the public",
          "domain": "public sector",
          "assuranceGoal": "transparency"
        }
      ]
    },
    {
      "@id": "tea:technique/red-teaming",
      "@type": "Technique",
      "name": "Red Teaming",
      "slug": "red-teaming",
      "description": "Red teaming is a structured adversarial evaluation process in which a dedicated team systematically probes an AI/ML system to discover vulnerabilities and failure modes. Unlike individual testing techniques (such as prompt injection testing, jailbreak resistance testing, or safety envelope testing), red teaming defines the organisational methodology: team composition, campaign planning, attack taxonomy, and reporting structure. The red team coordinates diverse attack vectors — including prompt manipulation, adversarial examples, edge case exploitation, and social engineering scenarios — into a coherent assessment programme. Results feed into risk registers and remediation plans rather than pass/fail metrics.",
      "addressesGoal": [
        "tea:goal/general",
        "tea:goal/safety",
        "tea:goal/security",
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/data-requirements/no-special-requirements",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/qualitative-report",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/security",
        "tea:tag/expertise-needed/governance-and-audit",
        "tea:tag/technique-type/process",
        "tea:tag/technique-type/testing",
        "tea:tag/assurance-goal-category/general",
        "tea:tag/assurance-goal-category/general/governance-and-review",
        "tea:tag/assurance-goal-category/safety",
        "tea:tag/assurance-goal-category/safety/hazard-identification",
        "tea:tag/assurance-goal-category/security",
        "tea:tag/assurance-goal-category/security/vulnerability-testing",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/bias-measurement",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation"
      ],
      "complexityRating": 4,
      "computationalCostRating": 3,
      "relatedTo": [
        "tea:technique/adversarial-training-evaluation",
        "tea:technique/jailbreak-resistance-testing",
        "tea:technique/prompt-injection-testing",
        "tea:technique/safety-envelope-testing",
        "tea:technique/algorithm-review-boards"
      ],
      "citesResource": [
        "tea:resource/editorOWASPGenAIRed",
        "tea:resource/microsoftPyRITPythonRisk2024",
        "tea:resource/ganguliRedTeamingLanguage2022",
        "tea:resource/doraRedTeamingLLM2025",
        "tea:resource/changRedTeamingChatGPT2025"
      ],
      "exampleUseCases": [
        {
          "description": "Testing a content moderation AI by attempting to make it generate harmful outputs through creative prompt injection, jailbreaking techniques, and edge case scenarios to identify safety vulnerabilities before deployment.",
          "goal": "Safety"
        },
        {
          "description": "Probing a medical diagnosis AI system with adversarial examples and edge cases to identify failure modes that could lead to incorrect diagnoses, ensuring the system fails gracefully rather than confidently providing wrong information.",
          "goal": "Reliability"
        },
        {
          "description": "Systematically testing a hiring algorithm with inputs designed to reveal hidden biases, using adversarial examples to check if the system can be manipulated to discriminate against protected groups or favour certain demographics unfairly.",
          "goal": "Fairness"
        },
        {
          "description": "Systematically testing AI systems for security vulnerabilities including prompt injection, data exfiltration, jailbreaking, and model manipulation by simulating adversarial attacks. This helps identify security weaknesses before deployment and provides documented evidence for compliance with regulatory requirements such as EU AI Act Article 55 and ISO 42001 adversarial testing mandates.",
          "goal": "Security"
        }
      ],
      "limitations": [
        {
          "description": "Requires highly specialized expertise in both AI/ML systems and adversarial attack methods, making it expensive and difficult to scale across organizations."
        },
        {
          "description": "Limited by the creativity and knowledge of red team members - can only discover vulnerabilities that testers think to explore, potentially missing novel attack vectors."
        },
        {
          "description": "Time-intensive process that may not be feasible for rapid development cycles or resource-constrained projects, potentially delaying beneficial system deployments."
        },
        {
          "description": "May not generalize to real-world adversarial scenarios, as red team attacks may differ significantly from actual malicious use patterns or user behaviours."
        },
        {
          "description": "Risk of false confidence if red teaming is incomplete or superficial, leading organizations to believe systems are safer than they actually are."
        }
      ],
      "sampleClaims": [
        {
          "text": "The medical AI system maintains safe behavior when subjected to edge case scenarios and adversarial inputs designed to elicit harmful clinical recommendations",
          "domain": "healthcare",
          "assuranceGoal": "safety"
        },
        {
          "text": "The financial advisory system resists attempts to extract confidential client information through social engineering scenarios and multi-turn manipulation strategies",
          "domain": "finance",
          "assuranceGoal": "security"
        },
        {
          "text": "The public benefits allocation system withstands systematic probing designed to reveal exploitable pathways for discriminatory outcomes against protected groups",
          "domain": "public sector",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The autonomous vehicle control system fails gracefully rather than catastrophically when exposed to creative adversarial scenarios that exploit edge cases in perception and decision-making",
          "domain": "autonomous systems",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The conversational AI assistant resists goal misalignment attacks and jailbreak attempts that probe for ways to circumvent safety constraints through iterative prompt refinement",
          "domain": "general",
          "assuranceGoal": "security"
        }
      ]
    },
    {
      "@id": "tea:technique/human-in-the-loop-safeguards",
      "@type": "Technique",
      "name": "Human-in-the-Loop Safeguards",
      "slug": "human-in-the-loop-safeguards",
      "description": "Human-in-the-loop safeguards establish systematic checkpoints where human experts review, validate, or override AI/ML system decisions before they take effect. This governance approach combines automated efficiency with human judgement by defining clear intervention criteria (such as uncertainty thresholds, risk levels, or sensitive contexts) that trigger mandatory human oversight. By incorporating domain expertise, ethical considerations, and contextual understanding that machines may lack, these safeguards help ensure that critical decisions maintain appropriate human accountability whilst preserving the benefits of automated processing for routine cases.",
      "addressesGoal": [
        "tea:goal/general",
        "tea:goal/safety",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/data-requirements/no-special-requirements",
