        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/technique-type/testing",
        "tea:tag/explanatory-scope/local"
      ],
      "relatedTo": [
        "tea:technique/epistemic-uncertainty-quantification",
        "tea:technique/chain-of-thought-faithfulness-evaluation",
        "tea:technique/out-of-domain-detection"
      ],
      "citesResource": [
        "tea:resource/RagasDocumentation",
        "tea:resource/VibrantlabsaiRagasSupercharge2026",
        "tea:resource/esRAGAsAutomatedEvaluation2024",
        "tea:resource/EvaluateSimpleRAG",
        "tea:resource/hindiEnhancingPrecisionInterpretability2025",
        "tea:resource/heASTRIDAutomatedScalable2025"
      ],
      "exampleUseCases": [
        {
          "description": "Evaluating a technical support knowledge system at a software company to ensure it retrieves relevant troubleshooting documentation and generates accurate solutions without fabricating configuration steps or commands not present in official documentation.",
          "goal": "Reliability"
        },
        {
          "description": "Assessing whether a legal research assistant properly cites source documents when generating case summaries, enabling lawyers to verify information and trace conclusions back to authoritative sources.",
          "goal": "Transparency"
        },
        {
          "description": "Evaluating a scientific literature review system to verify generated research summaries accurately synthesize findings across papers, clearly indicating contradictory results or missing evidence in the knowledge base.",
          "goal": "Explainability"
        },
        {
          "description": "Evaluating a clinical decision support system that retrieves relevant medical literature and patient records to ensure generated treatment recommendations accurately reflect evidence-based guidelines without extrapolating beyond available clinical data.",
          "goal": "Reliability"
        },
        {
          "description": "Assessing a government benefits information chatbot to verify it retrieves relevant policy documents and accurately communicates eligibility criteria without hallucinating benefits, amounts, or requirements that could mislead citizens seeking assistance.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Evaluation requires high-quality ground truth datasets with known correct retrievals and answers, which may be expensive or impossible to create for specialized domains."
        },
        {
          "description": "Faithfulness assessment can be subjective and difficult to automate, often requiring human judgment to determine whether responses accurately represent retrieved context."
        },
        {
          "description": "Trade-offs between retrieval precision and recall mean optimizing for one metric may degrade the other, requiring domain-specific balancing decisions."
        },
        {
          "description": "Metrics may not capture subtle quality issues like incomplete answers, misleading emphasis, or failure to synthesize information from multiple retrieved sources."
        },
        {
          "description": "Evaluating multi-hop reasoning—where answers require synthesising information across multiple retrieved documents—is particularly challenging, as standard metrics may not capture whether the system correctly chains information or makes unsupported logical leaps."
        },
        {
          "description": "Difficult to isolate whether poor performance stems from retrieval failures (finding wrong documents), generation failures (misusing correct documents), or interaction effects, complicating diagnosis and improvement efforts."
        }
      ],
      "sampleClaims": [
        {
          "text": "The legal research system's generated case summaries are traceable to specific retrieved source documents with verifiable citations",
          "domain": "public sector",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The clinical decision support system generates treatment recommendations that accurately reflect the retrieved evidence-based guidelines without extrapolating beyond available medical literature",
          "domain": "healthcare",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The customer support assistant explicitly indicates when retrieved knowledge base articles do not contain sufficient information to answer user queries",
          "domain": "general",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The research literature assistant's generated summaries distinguish between findings directly supported by retrieved papers and those requiring synthesis across multiple sources",
          "domain": "general",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The financial advisory chatbot's investment recommendations are attributable to specific sections of retrieved regulatory documents and market analyses",
          "domain": "finance",
          "assuranceGoal": "explainability"
        }
      ]
    },
    {
      "@id": "tea:technique/reward-hacking-detection",
      "@type": "Technique",
      "name": "Reward Hacking Detection",
      "slug": "reward-hacking-detection",
      "description": "Reward hacking is when an agent trained to maximise a proxy reward (a reward function or learned reward model that only approximates what its designers want) raises that proxy by exploiting its gaps while the intended outcome stalls or gets worse. Reward hacking detection tests a trained policy for this by scoring it against both the proxy it was optimised for and an independent measure of the intended objective that the optimiser never saw, such as a hand-written true reward in a simulator, a held-out 'gold' reward model or human ratings. The scoring is repeated at every training checkpoint, or across models of increasing size, because the change can be abrupt: the originating study found capability thresholds at which an agent's behaviour shifts and its true reward falls sharply while its proxy reward keeps rising. Where the intended objective cannot be scored in operation, the same study flags a policy as aberrant when its action distribution diverges too far from that of a trusted policy that people have already checked, with the alarm threshold set on policies whose true reward is known. The output is a pair of proxy and true-reward curves showing where they part, or an anomaly score for each candidate policy.",
      "addressesGoal": [
        "tea:goal/reliability",
        "tea:goal/safety"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/architecture/neural-networks/transformer/llm",
        "tea:tag/applicable-models/paradigm/reinforcement",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/behavioural-consistency",
        "tea:tag/assurance-goal-category/safety",
        "tea:tag/assurance-goal-category/safety/hazard-identification",
        "tea:tag/data-requirements/test-scenarios",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/evidence-type/visualisation",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/evaluation-design",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/technique-type/testing",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-selection-and-training",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation"
      ],
      "relatedTo": [
        "tea:technique/chain-of-thought-faithfulness-evaluation",
        "tea:technique/adversarial-training-evaluation",
        "tea:technique/constitutional-ai-evaluation",
        "tea:technique/red-teaming"
      ],
      "citesResource": [
        "tea:resource/panEffectsRewardMisspecification2022",
        "tea:resource/gaoScalingLawsReward2023",
        "tea:resource/panRewardmisspecificationCodePan2026"
      ],
      "exampleUseCases": [
        {
          "description": "A transport authority training a reinforcement-learning ramp-metering controller in a traffic simulator rewards it on mean vehicle speed, but also logs average commute time for all drivers at every checkpoint. Checkpoints where speed keeps improving while commute time worsens (for example by holding merging cars back indefinitely) are rejected before any field trial.",
          "goal": "Reliability"
        },
        {
          "description": "A team fine-tuning a customer-support language model with reinforcement learning from human feedback scores each checkpoint with its training reward model and with a held-out reward model and a sample of human ratings that the training loop never sees, and stops training at the point where the training reward keeps rising but the held-out scores fall.",
          "goal": "Reliability"
        },
        {
          "description": "Before an insulin-dosing agent trained against a simulator reward goes to clinical evaluation, the developers score every candidate policy on a separate true objective, time spent in the safe blood-glucose range, and exclude any policy whose simulator reward is high but whose time in range is lower than that of the clinically reviewed baseline policy.",
          "goal": "Safety"
        },
        {
          "description": "A public-health modelling unit that replaces a reviewed epidemic-response policy with a larger retrained one compares the new policy's actions with the reviewed policy's across simulated outbreaks. A divergence score above the threshold set on earlier policies with known outcomes sends the new policy to expert review instead of adoption, because its true outcome cannot be scored before deployment.",
          "goal": "Safety"
        }
      ],
      "limitations": [
        {
          "description": "Everything rests on the independent measure of the intended objective. When that measure is itself a proxy (a gold reward model, or a small sample of human ratings), a policy can exploit it too, and the comparison then only detects divergence between two imperfect measures. Collecting enough human ratings at every checkpoint is expensive, which is why studies substitute a gold reward model."
        },
        {
          "description": "It detects gaming only along the dimensions the true measure scores. A policy that exploits something the true objective does not capture (a side effect, a safety constraint, a user group not represented in the ratings) passes the check, so a clean result is evidence about the measured objective only."
        },
        {
          "description": "The trusted-policy detector is weak and inconsistent. In the originating benchmark every baseline detector scored an area under the ROC curve below 60% on at least one task, and no detector was best on all tasks, so a quiet detector is not evidence that hacking is absent."
        },
        {
          "description": "The trusted-policy detector flags difference, not harm. It needs a policy that people have already verified, and comparable action distributions from both policies, and a candidate that is genuinely better than the trusted policy can diverge from it and be flagged, which makes false alarms likely when the trusted policy is only moderately good."
        },
        {
          "description": "Because the onset of reward hacking can be abrupt as capability grows, checking a few checkpoints or one model size can miss it. The comparison has to be repeated at every checkpoint and model size that might be deployed, which multiplies evaluation cost, especially when the true measure needs human raters."
        }
      ],
      "sampleClaims": [
        {
          "text": "Across all training checkpoints, gains in the proxy reward were matched by gains on a held-out measure of the intended objective, with no checkpoint where the two diverged beyond the agreed tolerance",
          "domain": "general",
          "assuranceGoal": "reliability"
        },
        {
          "text": "Training of the support model was stopped before the point at which held-out human ratings began to fall while the training reward continued to rise",
          "domain": "general",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The insulin-dosing policy selected for clinical evaluation achieved its simulator reward without reducing time spent in the safe glucose range below that of the reviewed baseline policy",
          "domain": "healthcare",
          "assuranceGoal": "safety"
        },
        {
          "text": "The retrained policy's actions do not diverge from the human-verified reference policy beyond an alarm threshold calibrated on policies with known outcomes",
          "domain": "public sector",
          "assuranceGoal": "safety"
        }
      ]
    },
    {
      "@id": "tea:technique/toxicity-detection",
      "@type": "Technique",
      "name": "Toxicity Detection",
      "slug": "toxicity-detection",
      "description": "Toxicity detection uses automated classifiers and human review to identify harmful, offensive, or dangerous content in model outputs. This technique employs tools trained to detect toxic language, hate speech, threats, and other harmful content through targeted testing with adversarial prompts. Detection covers explicit toxicity (slurs, threats, graphic content) and implicit harm (manipulative advice, dangerous instructions). For bias and fairness evaluation of model outputs, see related techniques such as few-shot fairness evaluation and demographic parity assessment.",
      "addressesGoal": [
        "tea:goal/safety",
        "tea:goal/reliability"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/architecture/neural-networks/transformer/llm",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/applicable-models/paradigm/generative",
        "tea:tag/assurance-goal-category/safety",
        "tea:tag/assurance-goal-category/safety/verification",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/behavioural-consistency",
        "tea:tag/data-type/text",
        "tea:tag/data-requirements/no-special-requirements",
        "tea:tag/technique-type/testing",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/evidence-type/qualitative-report",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/expertise-needed/linguistics",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/evaluation-design",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation"
      ],
      "relatedTo": [
        "tea:technique/few-shot-fairness-evaluation",
        "tea:technique/prompt-injection-testing",
        "tea:technique/runtime-monitoring-and-circuit-breakers",
        "tea:technique/jailbreak-resistance-testing"
      ],
      "citesResource": [
        "tea:resource/PerspectiveAPIDocumentation",
        "tea:resource/hanuUnitaryaiDetoxifyTrained2020",
        "tea:resource/gehmanRealToxicityPromptsEvaluatingNeural2020",
        "tea:resource/leesNewGenerationPerspective2022",
        "tea:resource/SampleRequestsPerspective",
        "tea:resource/muralikumarHumancenteredEvaluationToxicity2023",
        "tea:resource/nakkaEvaluationGooglePerspective2025"
      ],
      "exampleUseCases": [
        {
          "description": "Screening a chatbot's responses for toxic language, hate speech, and harmful content before deployment in public-facing applications where vulnerable users including children might interact with it.",
          "goal": "Safety"
        },
        {
          "description": "Screening an AI writing assistant for educational content to ensure it maintains appropriate language and doesn't generate offensive material that could be harmful in classroom or academic settings.",
          "goal": "Reliability"
        },
        {
          "description": "Screening a mental health support chatbot to ensure it doesn't generate stigmatising language about mental health conditions, substance use, or marginalised communities, which could cause harm to vulnerable patients seeking help.",
          "goal": "Safety"
        }
      ],
      "limitations": [
        {
          "description": "Toxicity classifiers themselves may have biases, potentially flagging legitimate discussions of sensitive topics or minority language patterns as toxic."
        },
        {
          "description": "Context-dependent nature of toxicity makes automated detection challenging, as the same phrase may be harmful or harmless depending on usage context."
        },
        {
          "description": "Evolving language and cultural differences mean toxicity definitions change over time and vary across communities, requiring constant updating."
        },
        {
          "description": "Sophisticated models may generate subtle bias or coded language that evades automated detection while still being harmful."
        },
        {
          "description": "Comprehensive toxicity detection often requires human review to validate automated findings and handle edge cases, which is resource-intensive and may not scale to high-volume applications or real-time content generation."
        },
        {
          "description": "Toxicity classifiers require large labeled datasets of harmful content for training and validation, which are expensive to create, emotionally taxing for annotators, and raise ethical concerns about exposing people to harmful material."
        },
        {
          "description": "Configuring detection thresholds involves tradeoffs between false positives (over-censoring legitimate content) and false negatives (missing harmful content), with different stakeholders often disagreeing on acceptable balance points."
        },
        {
          "description": "Detection performance often degrades significantly for non-English languages, code-switching, dialects, and internet slang, limiting effectiveness for global or multilingual applications."
        }
      ],
      "sampleClaims": [
        {
          "text": "The mental health support assistant does not generate stigmatising language about psychiatric conditions or marginalised communities when responding to vulnerable patients",
          "domain": "healthcare",
          "assuranceGoal": "safety"
        },
        {
          "text": "The customer service chatbot's responses are free from offensive content and hate speech when users introduce adversarial or provocative queries",
          "domain": "finance",
          "assuranceGoal": "safety"
        },
        {
          "text": "The public-facing chatbot maintains appropriate language standards and does not produce harmful outputs when deployed in educational environments with young users",
          "domain": "public sector",
          "assuranceGoal": "reliability"
        }
      ]
    },
    {
      "@id": "tea:technique/isotonic-regression-calibration",
      "@type": "Technique",
      "name": "Isotonic Regression Calibration",
      "slug": "isotonic-regression-calibration",
      "description": "Isotonic regression calibration turns a classifier's scores into calibrated probabilities by fitting a step-shaped function that never decreases as the score rises. Unlike a fixed curve, it assumes nothing about the shape of the miscalibration except that a higher score should never mean a lower chance of the positive outcome, so it can correct any distortion that leaves the cases in the right order. It is fitted on labelled cases the classifier was not trained on: the cases are sorted by score, and the pool-adjacent-violators algorithm repeatedly merges neighbouring groups whose observed positive rates are out of order, until the rates rise steadily with the score. Each merged group's observed rate becomes the calibrated probability for scores in its range, and the result is assessed with a reliability diagram (predicted probability plotted against observed frequency) and the Brier score before and after.",
      "addressesGoal": [
        "tea:goal/reliability",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/calibration",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/confidence-and-limits",
        "tea:tag/data-requirements/calibration-set",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/model-artefact",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/lifecycle-stage/system-deployment",
        "tea:tag/lifecycle-stage/system-deployment/model-updating-or-deprovisioning"
      ],
      "complexityRating": 2,
      "computationalCostRating": 1,
      "citesResource": [
        "tea:resource/116ProbabilityCalibration",
        "tea:resource/Scikitlearn",
        "tea:resource/zadroznyTransformingClassifierScores2002",
        "tea:resource/ProbabilityCalibrationCurves",
        "tea:resource/walshPredictingSuicideAttempts2018"
      ],
      "exampleUseCases": [
        {
          "description": "A clinical research team builds a random forest on electronic health records to predict which adolescents will attempt suicide. The forest ranks patients well, but its vote shares are not probabilities, so the team fits isotonic regression on held-out records and reports calibration slope, intercept and Brier score before the risk estimates are used to prioritise clinical follow-up.",
          "goal": "Reliability"
        },
        {
          "description": "An insurer's pricing team applies isotonic recalibration to the output of its claim-probability model, fitted on a large portfolio, so that within each band of predicted risk the average prediction equals the observed claim rate on the calibration data and no group of policyholders systematically subsidises another.",
          "goal": "Reliability"
        },
        {
          "description": "An online marketplace scores listings for fraud with a naive Bayes text classifier whose probabilities cluster near 0 and 1, and analysts had been treating them as near-certainties. With tens of thousands of labelled past cases available, the team fits isotonic calibration so the review queue shows probabilities that match observed fraud rates, and shares the reliability diagram with the analysts.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "It needs plenty of calibration data. With fewer than about a thousand labelled cases the step function follows noise in the calibration set, and the two-parameter curve of Platt scaling usually does as well or better; isotonic regression pays off when calibration data are plentiful."
        },
        {
          "description": "The output is a step function, so many different scores receive exactly the same probability. These ties discard distinctions the model made within a step, can change ranking measures such as the area under the ROC curve after calibration, and matter when a decision threshold falls inside a wide step."
        },
        {
          "description": "It relies on the classifier's ordering being right: a higher score must never mean a lower chance of the outcome. Where the model ranks cases wrongly over some range of scores, isotonic regression cannot repair the ranking and instead flattens that range into a single probability."
        },
        {
          "description": "Probabilities at the extremes rest on little data. The outermost steps can be fitted from a handful of cases and may sit at or near 0 or 1, and common implementations clip scores beyond the range seen in calibration to the end values, so the most extreme predictions are the least trustworthy."
        }
      ],
      "sampleClaims": [
        {
          "text": "The recalibrated suicide-attempt risk model's predicted probabilities match observed attempt rates across risk deciles in held-out records, with calibration slope and intercept within pre-agreed bounds.",
          "assuranceGoal": "reliability",
          "domain": "healthcare"
        },
        {
          "text": "Within each band of predicted claim probability, the average prediction equals the observed claim rate on the calibration data, so no band of policyholders systematically subsidises another.",
          "assuranceGoal": "reliability",
          "domain": "finance"
        },
        {
          "text": "The fraud probabilities shown to analysts were recalibrated on more than 10,000 labelled past cases, and the reliability diagram is published alongside the review tool.",
          "assuranceGoal": "transparency",
          "domain": "e-commerce"
        }
      ]
    },
    {
      "@id": "tea:technique/scenario-based-simulation-testing",
      "@type": "Technique",
      "name": "Scenario-Based Simulation Testing",
      "slug": "scenario-based-simulation-testing",
      "description": "Scenario-based simulation testing checks an automated system, most often an automated driving system, by running it through a planned set of situations in a simulator and judging each run against criteria fixed in advance. Scenarios are written at three levels of detail: a functional scenario describes a situation in words (a car cuts in ahead on a motorway), a logical scenario turns it into parameters with ranges (speeds, gaps, road friction), and a concrete scenario fixes one value for every parameter so that the run can be reproduced exactly. Functional scenarios are derived from hazard analysis and from the operational design domain (the conditions the system is designed to work in), and concrete scenarios are sampled from the logical ranges, either to cover the whole range or to seek out rare, critical combinations. Each concrete scenario is executed with the system under test in the loop, and pass or fail is decided against its expected behaviour, such as no collision, or by criticality measures such as time-to-collision, giving a record of which situations the system handles and which it does not. ISO 34502 sets out this process as a safety evaluation framework for automated driving systems.",
      "addressesGoal": [
        "tea:goal/safety"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/safety",
        "tea:tag/assurance-goal-category/safety/verification",
        "tea:tag/data-requirements/test-scenarios",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/evidence-type/boundary-analysis",
        "tea:tag/expertise-needed/safety-engineering",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/expertise-needed/evaluation-design",
        "tea:tag/technique-type/testing",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/lifecycle-stage/system-deployment",
        "tea:tag/lifecycle-stage/system-deployment/system-implementation"
      ],
      "complexityRating": 4,
      "computationalCostRating": 4,
      "citesResource": [
        "tea:resource/RoadVehiclesTesta",
        "tea:resource/CarlasimulatorScenario_runnerTraffic2026",
        "tea:resource/menzelScenariosDevelopmentTest2018",
        "tea:resource/CreateNewScenario",
        "tea:resource/scanlonWaymoSimulatedDriving2021"
      ],
      "exampleUseCases": [
        {
          "description": "A developer of a motorway driving function derives cut-in, cut-out and stopped-vehicle scenarios from its hazard analysis, gives each logical scenario ranges for speeds, gaps and road friction, and runs several thousand sampled concrete scenarios in simulation for every software release, holding back any release in which a run ends in a collision the function was required to avoid.",
          "goal": "Safety"
        },
        {
          "description": "A robotaxi operator rebuilds the fatal crashes recorded over a decade in the city where it operates as concrete simulation scenarios, and replays each one with its driving system in place of first one human driver and then the other, so that it can show regulators how the system behaves in the crash types that actually occur in its operating area.",
          "goal": "Safety"
        },
        {
          "description": "An operator of an autonomous passenger ferry tests its collision-avoidance planner on head-on, crossing and overtaking encounters described in the international collision regulations, varying the other vessel's speed, bearing and visibility in a ship simulator, and checks in every run that the ferry keeps its required passing distance and makes the manoeuvre the regulations call for.",
          "goal": "Safety"
        }
      ],
      "limitations": [
        {
          "description": "The evidence covers only the scenarios that were specified. Real operating conditions cannot be listed exhaustively, so a clean result shows that the system handles the catalogue, not that it is safe; the safety argument depends on how completely the functional scenarios were derived from the hazard analysis and operational design domain, which needs independent review."
        },
        {
          "description": "Results are only as credible as the simulation. If the models of sensors, vehicle dynamics or other road users have not been validated against the real world, a system can pass in simulation and fail in operation, so key scenarios should be repeated on a test track or against recorded real data."
        },
        {
          "description": "How concrete scenarios are sampled shapes what the results mean. Covering whole parameter ranges ignores how often each situation occurs, and searching for critical corner cases finds failures efficiently but over-represents rare situations, so neither supports a statement about real-world accident rates unless results are weighted by how often scenarios occur."
        },
        {
          "description": "Pass criteria encode a judgement about acceptable behaviour. 'No collision' misses near misses and lucky escapes, while criticality measures such as time-to-collision need thresholds that the developer must choose and justify, and the verdicts change with them."
        },
        {
          "description": "Building scenario catalogues, simulation environments and behaviour models for other road users takes specialist effort and substantial computing, and ISO 34502 covers automated driving on limited-access highways only, so other road types and other domains must adapt the framework themselves."
        }
      ],
      "sampleClaims": [
        {
          "text": "The motorway driving function passed every concrete scenario sampled from the cut-in, cut-out and stopped-vehicle logical scenarios derived from the hazard analysis, with no collisions and minimum time-to-collision above the agreed threshold.",
          "assuranceGoal": "safety",
          "domain": "autonomous systems"
        },
        {
          "text": "In simulated reconstructions of the fatal crashes recorded in its operating area, the driving system avoided every crash in which it replaced the driver who initiated the conflict.",
          "assuranceGoal": "safety",
          "domain": "transport"
        },
        {
