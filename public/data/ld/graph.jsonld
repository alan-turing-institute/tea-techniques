      "@id": "tea:resource/blanco-justiciaDigitalForgettingLarge2025",
      "@type": "Resource",
      "name": "Digital forgetting in large language models: A survey of unlearning methods",
      "citationKey": "blanco-justiciaDigitalForgettingLarge2025",
      "url": "https://link.springer.com/article/10.1007/s10462-024-11078-6",
      "sourceType": "technical_paper",
      "authors": [
        "Alberto Blanco-Justicia",
        "Najeeb Jebreel",
        "Benet Manzanares-Salor",
        "David Sánchez",
        "Josep Domingo-Ferrer",
