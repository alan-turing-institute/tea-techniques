      "@id": "tea:resource/aif360developersAif360sklearninprocessingAdversarialDebiasingAif3600612018",
      "@type": "Resource",
      "name": "aif360.sklearn.inprocessing.AdversarialDebiasing — aif360 0.6.1 ...",
      "citationKey": "aif360developersAif360sklearninprocessingAdversarialDebiasingAif3600612018",
