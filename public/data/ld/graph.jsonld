        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/evidence-type/model-artefact",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/explanatory-scope/global",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-selection-and-training",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/data-requirements/access-to-training-data"
      ],
      "complexityRating": 3,
      "computationalCostRating": 2,
      "relatedTo": [
        "tea:technique/model-distillation",
        "tea:technique/neuron-activation-analysis",
        "tea:technique/integrated-gradients"
      ],
      "citesResource": [
        "tea:resource/TrimInsignificantWeights",
        "tea:resource/horseeeLLMPruner2023",
        "tea:resource/TensorflowModeloptimization2026",
        "tea:resource/hanLearningBothWeights2015",
        "tea:resource/lecunOptimalBrainDamage1989",
        "tea:resource/PruningTutorialPyTorch",
        "tea:resource/tuDeepNeuralNetwork2019"
      ],
      "exampleUseCases": [
        {
          "description": "Compressing a medical imaging model from 100MB to 15MB for deployment on edge devices in remote clinics, enabling healthcare professionals to audit the remaining critical feature detectors and understand which anatomical patterns drive diagnoses whilst maintaining diagnostic accuracy.",
          "goal": "Explainability"
        },
        {
          "description": "Reducing an autonomous vehicle perception model to ensure predictable inference times under 50ms for safety-critical decisions, removing non-essential neurons to guarantee consistent computational behaviour whilst maintaining object detection accuracy for pedestrian safety.",
          "goal": "Safety"
        }
      ],
      "limitations": [
        {
          "description": "Determining optimal pruning ratios requires extensive experimentation as over-pruning can cause dramatic accuracy degradation, whilst under-pruning provides minimal benefits, making the process time-consuming and resource-intensive."
        },
        {
          "description": "Structured pruning often requires specific hardware or software framework support to realise computational benefits, limiting deployment flexibility and potentially necessitating model architecture changes."
        },
        {
          "description": "Pruned models may exhibit reduced robustness to out-of-distribution inputs or adversarial attacks, as removing neurons can eliminate defensive redundancy that helped handle edge cases."
        },
        {
          "description": "The iterative pruning and fine-tuning process can be computationally expensive, sometimes requiring more resources than training the original model, particularly for large-scale networks."
        },
        {
          "description": "Pruning criteria based on weight magnitudes or gradients may not align with interpretability goals, potentially removing neurons that contribute to model transparency whilst retaining complex, opaque pathways."
        }
      ],
      "sampleClaims": [
        {
          "text": "The medical imaging model's inference time is bounded by a simplified architecture that guarantees processing within device constraints",
          "domain": "healthcare",
          "assuranceGoal": "safety"
        },
        {
          "text": "The diagnostic system's decision-making relies on a sparse set of identifiable feature detectors that clinical experts can inspect",
          "domain": "healthcare",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The edge-deployed model executes within deterministic memory and processing budgets required for real-time safety-critical operation",
          "domain": "general",
          "assuranceGoal": "safety"
        }
      ]
    },
    {
      "@id": "tea:technique/neuron-activation-analysis",
      "@type": "Technique",
      "name": "Neuron Activation Analysis",
      "slug": "neuron-activation-analysis",
      "description": "Neuron activation analysis examines the firing patterns of individual neurons in neural networks by probing them with diverse inputs and analysing their activation responses. This technique helps understand what concepts, features, or patterns different neurons have learned to recognise, providing insights into the model's internal representations. For large language models, this can reveal neurons specialised for linguistic concepts, semantic categories, or even potentially harmful patterns, enabling targeted interventions and deeper model understanding.",
      "addressesGoal": [
        "tea:goal/explainability",
        "tea:goal/safety",
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/neural-networks",
        "tea:tag/applicable-models/requirements/model-internals",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/assurance-goal-category/explainability",
        "tea:tag/assurance-goal-category/explainability/explains/data-patterns",
        "tea:tag/assurance-goal-category/explainability/explains/internal-mechanisms",
        "tea:tag/assurance-goal-category/explainability/property/comprehensibility",
        "tea:tag/assurance-goal-category/explainability/representation-analysis/concept-identification",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/bias-diagnosis",
        "tea:tag/assurance-goal-category/safety",
        "tea:tag/assurance-goal-category/safety/hazard-analysis",
        "tea:tag/data-type/text",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/evidence-type/visualisation",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/deep-learning",
        "tea:tag/explanatory-scope/global",
        "tea:tag/explanatory-scope/local",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/data-requirements/no-special-requirements",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation"
      ],
      "complexityRating": 5,
      "computationalCostRating": 4,
      "relatedTo": [
        "tea:technique/concept-activation-vectors",
        "tea:technique/model-pruning",
        "tea:technique/causal-mediation-analysis-in-language-models"
      ],
      "citesResource": [
        "tea:resource/eccodevelopersEcco2020",
        "tea:resource/jalammarEcco2020",
        "tea:resource/TransformerLens2026",
        "tea:resource/dalalValueLabeledData2024",
        "tea:resource/bauNetworkDissectionQuantifying2017",
        "tea:resource/NeuronActivationAnalysis",
        "tea:resource/gohMultimodalNeuronsArtificial2021",
        "tea:resource/gurneeFindingNeuronsHaystack2023"
      ],
      "exampleUseCases": [
        {
          "description": "Analysing GPT-based models to identify specific neurons that activate on toxic or harmful content, enabling targeted interventions to reduce model toxicity whilst preserving general language capabilities for safer AI deployment.",
          "goal": "Safety"
        },
        {
          "description": "Examining activation patterns in multilingual language models to detect neurons that exhibit systematic biases when processing text from different linguistic communities, revealing implicit representation inequalities that could affect downstream applications.",
          "goal": "Fairness"
        },
        {
          "description": "Investigating individual neurons in medical language models to understand which clinical concepts and medical knowledge representations drive diagnostic suggestions, enabling healthcare professionals to validate the model's medical reasoning pathways.",
          "goal": "Explainability"
        }
      ],
      "limitations": [
        {
          "description": "Many neurons exhibit polysemantic behaviour, representing multiple unrelated concepts simultaneously, making it difficult to assign clear interpretable meanings to individual neural units."
        },
        {
          "description": "Important model behaviours are often distributed across many neurons rather than localised in single units, requiring analysis of neural circuits and interactions that can be exponentially complex."
        },
        {
          "description": "Computational costs scale dramatically with modern large language models containing billions of parameters, making comprehensive neuron-by-neuron analysis prohibitively expensive for complete model understanding."
        },
        {
          "description": "Neuron activation patterns are highly context-dependent, with the same neuron potentially serving different roles based on surrounding input context, complicating consistent interpretation across diverse scenarios."
        },
        {
          "description": "Interpretation of activation patterns often relies on subjective human analysis without rigorous validation methods, potentially leading to confirmation bias or misattribution of neural functions."
        }
      ],
      "sampleClaims": [
        {
          "text": "The language model's internal representations reveal which individual computational units respond to specific semantic concepts relevant to clinical diagnosis",
          "domain": "healthcare",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The content moderation system's harmful output patterns are attributable to identifiable neurons that can be selectively modified without degrading general language capabilities",
          "domain": "general",
          "assuranceGoal": "safety"
        },
        {
          "text": "The multilingual model's neurons do not exhibit systematic activation biases when processing text from different linguistic communities",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The financial risk assessment model's internal computational units encode interpretable market concepts rather than opaque statistical artifacts",
          "domain": "finance",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The model's specialized neurons for toxic content detection activate consistently across diverse phrasings and contexts of harmful patterns",
          "domain": "general",
          "assuranceGoal": "safety"
        }
      ]
    },
    {
      "@id": "tea:technique/prompt-robustness-testing",
      "@type": "Technique",
      "name": "Prompt Robustness Testing",
      "slug": "prompt-robustness-testing",
      "description": "Prompt robustness testing measures how much a language model's answers, or its performance on a task, change when the prompt is varied in ways that should not matter: rewording an instruction, changing formatting, punctuation or capitalisation, reordering elements, or introducing the typos and synonym swaps real users make. The tester starts from a set of task prompts with known correct answers, generates variants of each that keep its meaning, either from templates of plausible formats or with automated perturbation tools such as PromptBench, and runs the model on every variant. The result is reported as the spread of performance across variants, for example the gap between the best and worst format or the drop in accuracy under perturbation, together with the variants that changed the answer. Reporting the spread rather than one score matters because results from a single prompt template are brittle: on one widely used open model, accuracy differed by up to 76 points across formatting changes that kept the meaning.",
      "addressesGoal": [
        "tea:goal/reliability",
        "tea:goal/explainability"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/neural-networks/transformer/llm",
        "tea:tag/applicable-models/paradigm/generative",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/explainability",
        "tea:tag/assurance-goal-category/explainability/explains/decision-boundaries",
        "tea:tag/assurance-goal-category/explainability/uncertainty-analysis/sensitivity-testing",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/robustness",
        "tea:tag/data-requirements/no-special-requirements",
        "tea:tag/data-type/text",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/expertise-needed/evaluation-design",
        "tea:tag/expertise-needed/linguistics",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/explanatory-scope/global",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/technique-type/testing"
      ],
      "relatedTo": [
        "tea:technique/prompt-injection-testing",
        "tea:technique/red-teaming",
        "tea:technique/adversarial-training-evaluation"
      ],
      "citesResource": [
        "tea:resource/promptbenchdevelopersPromptbenchIntroductionPromptbench2023",
        "tea:resource/MicrosoftPromptbenchUnified2026",
        "tea:resource/zhuPromptRobustEvaluatingRobustness2023",
        "tea:resource/mizrahiStateWhatArt2024",
        "tea:resource/PromptAttackPromptbench",
        "tea:resource/sclarQuantifyingLanguageModels2023",
        "tea:resource/yildirimPromptSensitivityLarge2026"
      ],
      "exampleUseCases": [
        {
          "description": "A digital health provider testing a symptom-triage chatbot rewrites each benchmark scenario as a brief layperson message, a detailed account, a clinician's summary and an anxious message, and checks that the urgency category stays the same across all four, treating any change as a failure to investigate before release.",
          "goal": "Reliability"
        },
        {
          "description": "A public-sector team choosing between candidate language models for classifying citizen enquiries evaluates each across a set of plausible prompt formats and instruction paraphrases, and compares models on worst-format and average accuracy rather than on a single prompt, because the ranking of models can change with the template.",
          "goal": "Reliability"
        },
        {
          "description": "A bank validating a model that summarises suspicious-transaction reports checks that the risk category it extracts does not change when the same activity is described with different terminology, abbreviations or layout, as reports from different branches would be.",
          "goal": "Reliability"
        },
        {
          "description": "A support team testing a request-routing model varies one element of each request at a time to separate the words that change the routing decision from formatting changes that should not, and uses the result to write guidance on how customers should phrase requests.",
          "goal": "Explainability"
        }
      ],
      "limitations": [
        {
          "description": "The space of possible prompt variants is unbounded, so a test samples it. A model can pass on every variant tried and still fail on a phrasing nobody generated, and the conclusion holds only for the kinds of variation the test set covers."
        },
        {
          "description": "Whether a variant keeps the meaning of the original is a judgement. Automated perturbations such as typos and synonym swaps can change meaning or produce text no user would write, especially in specialised language, so variant sets need checking by someone who knows the domain."
        },
        {
          "description": "Results do not transfer between models: which formats work well correlated only weakly across models in a large study, and robustness to one domain's phrasing says little about another's. The test has to be rerun for each model version, each prompt template change and each domain."
        },
        {
          "description": "Every variant multiplies the number of model calls, and for open-ended answers each response may need scoring by a domain expert rather than against a fixed label. Testing many formats across many examples and candidate models quickly becomes costly."
        },
        {
          "description": "It shows that outputs are brittle, not why. Choosing the best-scoring template on the same variants used to test it gives an optimistic estimate of how that template will perform on new inputs, so template selection and the final robustness measurement need separate data."
        }
      ],
      "sampleClaims": [
        {
          "text": "The triage assistant assigns the same urgency category to each benchmark scenario whether the patient's description is brief, detailed, clinical or anxious in style",
          "domain": "healthcare",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The enquiry-classification model's accuracy stays within a stated margin of its mean across every prompt template and instruction paraphrase in the evaluation set",
          "domain": "public sector",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The risk category extracted from suspicious-transaction reports does not change when the same activity is described with different terminology or layout",
          "domain": "finance",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The changes that alter the routing model's decisions have been identified and are changes to the content of a request, not to its formatting",
          "domain": "general",
          "assuranceGoal": "explainability"
        }
      ]
    },
    {
      "@id": "tea:technique/causal-mediation-analysis-in-language-models",
      "@type": "Technique",
      "name": "Causal Mediation Analysis in Language Models",
      "slug": "causal-mediation-analysis-in-language-models",
      "description": "Causal mediation analysis in language models is a mechanistic interpretability technique that systematically investigates how specific internal components (neurons, attention heads, or layers) causally contribute to model outputs. By performing controlled interventions—such as activating, deactivating, or modifying specific components—researchers can trace the causal pathways through which information flows and transforms within the model. This approach goes beyond correlation to establish causal relationships, enabling researchers to understand not just what features influence outputs, but how and why they do so through specific computational pathways.",
      "addressesGoal": [
        "tea:goal/explainability",
        "tea:goal/safety"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/neural-networks/transformer",
        "tea:tag/applicable-models/architecture/neural-networks/transformer/llm",
        "tea:tag/applicable-models/paradigm/generative",
        "tea:tag/applicable-models/requirements/model-internals",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/assurance-goal-category/explainability",
        "tea:tag/assurance-goal-category/explainability/causal-analysis/mediation-analysis",
        "tea:tag/assurance-goal-category/explainability/explains/causal-pathways",
        "tea:tag/assurance-goal-category/explainability/explains/internal-mechanisms",
        "tea:tag/assurance-goal-category/explainability/property/causality",
        "tea:tag/assurance-goal-category/explainability/property/fidelity",
        "tea:tag/assurance-goal-category/safety",
        "tea:tag/assurance-goal-category/safety/hazard-analysis",
        "tea:tag/data-type/text",
        "tea:tag/evidence-type/causal-analysis",
        "tea:tag/explanatory-scope/global",
        "tea:tag/explanatory-scope/local",
        "tea:tag/expertise-needed/causal-inference",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/deep-learning",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/data-requirements/no-special-requirements"
      ],
      "complexityRating": 5,
      "computationalCostRating": 4,
      "relatedTo": [
        "tea:technique/attention-weight-analysis",
        "tea:technique/integrated-gradients",
        "tea:technique/neuron-activation-analysis"
      ],
      "citesResource": [
        "tea:resource/PyveneDocumentation",
        "tea:resource/PyveneLibraryUnderstanding2026",
        "tea:resource/gehrmannCausalMediationAnalysisCodeVig2026",
        "tea:resource/vigCausalMediationAnalysis2020",
        "tea:resource/CausalTracingROME",
        "tea:resource/finlaysonCausalAnalysisSyntactic2021",
        "tea:resource/mengLocatingEditingFactual2022"
      ],
      "exampleUseCases": [
        {
          "description": "Investigating causal pathways in content moderation models to understand how specific attention mechanisms contribute to flagging potentially harmful content, enabling verification that safety decisions rely on appropriate features rather than spurious correlations and ensuring robust content filtering.",
          "goal": "Safety"
        },
        {
          "description": "Tracing causal pathways in large language models performing mathematical reasoning tasks to understand how intermediate steps are computed and stored, revealing which components are responsible for different aspects of logical inference and enabling validation of reasoning processes.",
          "goal": "Explainability"
        }
      ],
      "limitations": [
        {
          "description": "Requires sophisticated understanding of model architecture to design meaningful interventions, as poorly chosen intervention points may yield misleading causal conclusions or fail to capture relevant computational pathways."
        },
        {
          "description": "Results are highly dependent on the validity of underlying causal assumptions, which can be difficult to verify in complex, high-dimensional neural network spaces where multiple causal pathways may interact."
        },
        {
          "description": "Comprehensive causal analysis requires extensive computational resources, particularly for large models, as each intervention requires separate forward passes and multiple intervention combinations for robust conclusions."
        },
        {
          "description": "Distinguishing between direct causal effects and indirect effects mediated through other components can be challenging, potentially leading to oversimplified causal narratives that miss important intermediate processes."
        },
        {
          "description": "Causal relationships identified in specific contexts or datasets may not generalise to different domains, tasks, or model versions, requiring careful validation across diverse scenarios to ensure robust findings."
        }
      ],
      "sampleClaims": [
        {
          "text": "The language model's outputs are traceable to specific internal computational pathways rather than distributed correlations",
          "domain": "general",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The content moderation system's flagging decisions depend on appropriate features through verifiable causal mechanisms",
          "domain": "public sector",
          "assuranceGoal": "safety"
        },
        {
          "text": "The model's reasoning process flows through identifiable intermediate representations that can be independently validated",
          "domain": "healthcare",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The system's harmful output generation is attributable to specific intervening mechanisms that can be isolated and addressed",
          "domain": "general",
          "assuranceGoal": "safety"
        }
      ]
    },
    {
      "@id": "tea:technique/concept-activation-vectors",
      "@type": "Technique",
      "name": "Concept Activation Vectors",
      "slug": "concept-activation-vectors",
      "description": "Concept Activation Vectors (CAVs), also known as Testing with Concept Activation Vectors (TCAV), identify mathematical directions in neural network representation space that correspond to human-understandable concepts such as 'stripes', 'young', or 'medical equipment'. The technique works by finding linear directions that separate activations of concept examples from non-concept examples, then measuring how much these concept directions influence the model's predictions. This provides quantitative answers to questions like 'How much does the concept of youth affect this model's hiring decisions?' enabling systematic bias detection and model understanding.",
      "addressesGoal": [
        "tea:goal/explainability",
        "tea:goal/fairness",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/neural-networks",
        "tea:tag/applicable-models/requirements/gradient-access",
        "tea:tag/applicable-models/requirements/model-internals",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/assurance-goal-category/explainability",
        "tea:tag/assurance-goal-category/explainability/explains/causal-pathways",
        "tea:tag/assurance-goal-category/explainability/explains/internal-mechanisms",
        "tea:tag/assurance-goal-category/explainability/property/causality",
        "tea:tag/assurance-goal-category/explainability/property/comprehensibility",
        "tea:tag/assurance-goal-category/explainability/representation-analysis/concept-identification",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/bias-diagnosis",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/decision-reasons",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/explanatory-scope/global",
        "tea:tag/explanatory-scope/local",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation"
      ],
      "acronym": "CAVs",
      "complexityRating": 4,
      "computationalCostRating": 3,
      "relatedTo": [
        "tea:technique/neuron-activation-analysis",
        "tea:technique/prototype-and-criticism-models",
        "tea:technique/gradient-weighted-class-activation-mapping",
        "tea:technique/embedding-bias-analysis"
      ],
      "citesResource": [
        "tea:resource/ConceptbasedInterpretabilityTCAV",
        "tea:resource/TcavOfficialTCAV2026",
        "tea:resource/meta-pytorchCaptum2019",
        "tea:resource/schmalwasserFastCAVEfficientComputation2025",
        "tea:resource/kimInterpretabilityFeatureAttribution2018",
        "tea:resource/TCAVImageClassification",
        "tea:resource/cloughGlobalLocalInterpretability2019",
        "tea:resource/m.ConceptAttributionExplaining2020"
      ],
      "exampleUseCases": [
        {
          "description": "Auditing a medical imaging model to verify it focuses on diagnostic features (like 'tumour characteristics') rather than irrelevant concepts (like 'scanner type' or 'patient positioning') when classifying chest X-rays, ensuring clinical decisions rely on medically relevant information.",
          "goal": "Explainability"
        },
        {
          "description": "Testing whether a hiring algorithm's resume screening decisions are influenced by concepts related to protected characteristics such as 'gender-associated names', 'prestigious universities', or 'employment gaps', enabling systematic bias detection and compliance verification.",
          "goal": "Fairness"
        },
        {
          "description": "Providing regulatory-compliant explanations for financial lending decisions by quantifying how concepts like 'debt-to-income ratio', 'employment stability', and 'credit history length' influence loan approval models, with precise sensitivity scores for audit documentation.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Requires clearly defined concept examples and non-concept examples, which can be challenging to obtain for abstract or subjective concepts."
        },
        {
          "description": "Assumes that meaningful concept directions exist as linear separable directions in the model's internal representation space, which may not hold for all concepts."
        },
        {
          "description": "Results depend heavily on which network layer is examined, as different layers capture different levels of abstraction and concept representation."
        },
        {
          "description": "Computational cost grows significantly with model size and number of concepts tested, though recent advances like FastCAV address this limitation."
        },
        {
          "description": "Interpretation requires domain expertise to define meaningful concepts and understand the significance of sensitivity scores in practical contexts."
        }
      ],
      "sampleClaims": [
        {
          "text": "The model's classification decisions are quantifiably linked to human-interpretable concepts rather than opaque internal representations",
          "domain": "general",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The hiring system's candidate evaluations are demonstrably independent of concepts associated with protected characteristics",
          "domain": "public sector",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The diagnostic model's sensitivity to clinically relevant concepts is documented with quantitative influence scores",
          "domain": "healthcare",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The credit assessment model's reliance on demographic-related concepts is measurable and within acceptable bounds",
          "domain": "finance",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The vision system's object recognition depends on semantically meaningful visual concepts aligned with domain expertise",
          "domain": "autonomous systems",
          "assuranceGoal": "explainability"
        }
      ]
    },
    {
      "@id": "tea:technique/reweighing",
      "@type": "Technique",
      "name": "Reweighing",
      "slug": "reweighing",
      "description": "Reweighing is a pre-processing method, from Kamiran and Calders (2012), that removes the statistical association between a protected attribute and the outcome label in training data by giving each training example a weight, without changing any feature values or labels. For every combination of group and label (for example, women who were hired), the weight is the number of examples that combination would have if group and label were independent, divided by the number it actually has: the group's share of the data times the label's share, over the combination's observed share. Combinations rarer than independence predicts, such as positive outcomes in a disadvantaged group, are weighted up and over-represented ones are weighted down, so that in the weighted data every group has the same rate of positive labels. A model is then trained on the original data using these weights; the outputs are the weighted training set and a small table of weights that records exactly how each group-label combination was adjusted.",
      "addressesGoal": [
        "tea:goal/fairness",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/pre-processing",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/audit-trail",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/modified-dataset",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/preprocessing-and-feature-engineering",
        "tea:tag/technique-type/algorithmic"
      ],
      "complexityRating": 2,
      "computationalCostRating": 1,
      "relatedTo": [
        "tea:technique/disparate-impact-remover",
        "tea:technique/relabelling",
        "tea:technique/preferential-sampling"
      ],
      "citesResource": [
        "tea:resource/aif360developersAif360sklearnpreprocessingReweighingAif3600612018",
        "tea:resource/trusted-aiAIF3602018",
        "tea:resource/kamiranDataPreprocessingTechniques2012",
        "tea:resource/AIF360TutorialDetecting",
        "tea:resource/parkComparisonMethodsReduce2021",
        "tea:resource/mosteiroBiasDiscoveryMachine2022"
      ],
      "exampleUseCases": [
        {
          "description": "A bank's model team finds that in the historical loan decisions used as training labels, applicants from one ethnic group were approved far less often than others. Before retraining its approval model it computes reweighing weights, so that approved applicants from that group count for more and refused ones for less, trains with them as sample weights, and compares the approval-rate gap and accuracy on held-out data against the unweighted model.",
          "goal": "Fairness"
        },
        {
          "description": "A health insurer's analytics team building a model to target postpartum depression outreach from Medicaid claims compares reweighing by race with simply removing race from the inputs. It reports each option's disparate impact ratio (the ratio of positive-prediction rates between groups) and predictive performance to its clinical governance group before choosing one.",
          "goal": "Fairness"
        },
        {
          "description": "A recruitment platform training a shortlisting model on past hiring outcomes, in which women were hired into senior engineering roles less often than men, applies reweighing by sex before training so that the weighted history shows equal hiring rates, then checks shortlisting rates by sex on a held-out set of applications.",
          "goal": "Fairness"
        },
        {
          "description": "An auditor reviewing a benefits-fraud model asks for the table of reweighing weights kept with the training run. A weight of 1.8 on one nationality group's not-fraud cases shows how far that group's historical labels departed from independence, and the table records exactly how the training data were adjusted, so the auditor can reconstruct the intervention without rerunning it.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Its target is fixed: equal rates of positive labels across groups in the weighted training data (statistical parity). It does not aim at equal error rates such as equal opportunity, and the weights are computed once, before training, so they cannot respond to where the trained model actually errs. An adaptive variant (Krasanakis et al., 2018) re-estimates weights during training for error-rate criteria, but it has no maintained implementation."
        },
        {
          "description": "It removes all association between group and label, including any part a legitimate factor explains. Kamiran and Calders give the example of car insurance, where more accidents among men may justify different outcomes by sex; reweighing erases that difference too, so it over-corrects wherever some gap between groups is warranted."
        },
        {
          "description": "The learning algorithm must accept example weights; where it cannot, the data have to be resampled instead, which is a different method. Only the training data are balanced, so the trained model's predictions are not guaranteed to be: outcome rates by group must be measured on held-out data after training rather than assumed."
        },
        {
          "description": "When a group-label combination is rare its weight is large (a combination with a tenth of its expected count gets a weight of ten), so a handful of examples can dominate training. This raises variance and amplifies any labelling errors in exactly the group the method is meant to protect, and it bites hardest with small or intersectional groups."
        }
      ],
      "sampleClaims": [
        {
          "text": "The approval model was trained on loan history reweighed so that every ethnic group has the same approval rate in the weighted data, and its approval-rate gap on held-out applicants is reported alongside its accuracy.",
          "domain": "finance",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The postpartum depression outreach model, trained with reweighing by race, has a disparate impact ratio within the agreed range on held-out patients.",
          "domain": "healthcare",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The shortlisting model's training data were reweighed by sex before training, and shortlisting rates by sex on held-out applications fall within the agreed tolerance.",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The adjustment made to the fraud model's training data is recorded as a table of weights for each group and label, kept with the training run, from which an auditor can reconstruct how the data were changed.",
          "domain": "public sector",
          "assuranceGoal": "transparency"
        }
      ]
    },
    {
      "@id": "tea:technique/disparate-impact-remover",
      "@type": "Technique",
      "name": "Disparate Impact Remover",
      "slug": "disparate-impact-remover",
      "description": "Disparate Impact Remover is a preprocessing technique that transforms feature values in a dataset to reduce statistical dependence between features and protected attributes (like race or gender). The method modifies non-protected features through mathematical transformations that preserve the utility of the data whilst reducing correlations that could lead to discriminatory outcomes. This approach specifically targets the '80% rule' disparate impact threshold by adjusting feature distributions to ensure more equitable treatment across demographic groups in downstream model predictions.",
      "addressesGoal": [
        "tea:goal/fairness",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/pre-processing",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/assessment-results",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/tabular",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/preprocessing-and-feature-engineering",
        "tea:tag/evidence-type/modified-dataset"
      ],
      "complexityRating": 3,
      "computationalCostRating": 2,
      "relatedTo": [
        "tea:technique/reweighing",
        "tea:technique/relabelling",
        "tea:technique/preferential-sampling",
        "tea:technique/attribute-removal-fairness-through-unawareness"
      ],
      "citesResource": [
        "tea:resource/holisticaidevelopersDisparateImpactRemover2023",
        "tea:resource/aif360developersAif360algorithmspreprocessingDisparateImpactRemoverAif3602018",
        "tea:resource/holistic-aiHolisticai2023",
        "tea:resource/trusted-aiAIF3602018",
        "tea:resource/feldmanCertifyingRemovingDisparate2015",
        "tea:resource/AIF360DemoDisparate",
        "tea:resource/friedlerComparativeStudyFairnessenhancing2019",
        "tea:resource/raftopoulosEvaluatingFairnessStrategies2025"
      ],
      "exampleUseCases": [
        {
          "description": "Transforming features in a credit scoring dataset where variables like 'years of employment' and 'education level' are correlated with race, applying mathematical transformations to reduce these correlations whilst preserving the predictive value for creditworthiness assessment.",
          "goal": "Fairness"
        },
        {
          "description": "Preprocessing a recruitment dataset where features like 'previous job titles' and 'university attended' correlate with gender, modifying these features to ensure the '80% rule' is met whilst maintaining useful information for predicting job performance.",
          "goal": "Fairness"
        },
        {
          "description": "Preprocessing financial lending data to provide transparent bias metrics showing the quantified reduction in correlation between protected attributes and creditworthiness features, enabling institutions to demonstrate compliance with the 80% rule and explain their fairness interventions to regulators.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Feature transformations may reduce model accuracy by removing or distorting important predictive information during the debiasing process."
        },
        {
          "description": "Only addresses measured protected attributes and cannot eliminate bias that operates through unmeasured proxy variables."
        },
        {
          "description": "Effectiveness depends on the specific transformation method chosen and may not generalise well to different datasets or domains."
        },
        {
          "description": "May create artificial feature distributions that don't reflect real-world data patterns, potentially causing issues in model deployment."
        }
      ],
      "sampleClaims": [
        {
          "text": "The model's input features exhibit reduced statistical dependence on protected demographic attributes",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The credit assessment system meets the 80% rule threshold for equitable treatment across demographic groups",
          "domain": "finance",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The hiring system's feature correlations with protected attributes are quantifiably documented and minimized",
          "domain": "general",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The lending model's feature transformations preserve creditworthiness information whilst reducing demographic correlations",
          "domain": "finance",
          "assuranceGoal": "fairness"
        }
      ]
    },
    {
      "@id": "tea:technique/fairness-gan",
      "@type": "Technique",
      "name": "Fairness GAN",
      "slug": "fairness-gan",
      "description": "A data generation technique that employs Generative Adversarial Networks (GANs) to create fair synthetic datasets by learning to generate data representations that preserve utility whilst obfuscating protected attributes. Unlike traditional GANs, Fairness GANs incorporate fairness constraints into the training objective, ensuring that the generated data maintains statistical parity across demographic groups. The technique can be used for data augmentation to balance underrepresented groups or to create privacy-preserving synthetic datasets that remove demographic bias from training data.",
      "addressesGoal": [
        "tea:goal/fairness",
        "tea:goal/privacy"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/neural-networks/generative/gan",
        "tea:tag/applicable-models/paradigm/generative",
        "tea:tag/applicable-models/paradigm/unsupervised",
        "tea:tag/applicable-models/requirements/gradient-access",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/pre-processing",
        "tea:tag/assurance-goal-category/privacy",
        "tea:tag/assurance-goal-category/privacy/exposure-reduction",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/fairness-metric",
        "tea:tag/evidence-type/synthetic-data",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/lifecycle-stage/project-design",
        "tea:tag/lifecycle-stage/project-design/data-extraction-or-procurement",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/preprocessing-and-feature-engineering"
      ],
      "complexityRating": 5,
      "computationalCostRating": 5,
      "relatedTo": [
        "tea:technique/fair-bayesian-optimisation",
        "tea:technique/fair-adversarial-networks",
        "tea:technique/gan-based-tabular-synthetic-data"
      ],
      "citesResource": [
        "tea:resource/arsalanTabFairGAN2026",
        "tea:resource/sattigeriFairnessGAN2018",
        "tea:resource/xuFairGANFairnessawareGenerative2018",
        "tea:resource/ramachandranpillaiBtGANGeneratingFair2024",
        "tea:resource/lequyFairFinGANFairnessAwareSynthetic2026"
      ],
      "exampleUseCases": [
        {
          "description": "Generating balanced synthetic datasets for medical research by creating additional samples from underrepresented demographic groups, ensuring equal representation across ethnicity and gender whilst maintaining the statistical properties needed for robust model training.",
          "goal": "Fairness"
        },
        {
          "description": "Creating privacy-preserving synthetic datasets for financial services that remove demographic identifiers whilst preserving the underlying patterns needed for credit risk assessment, allowing secure data sharing between institutions without exposing sensitive customer information.",
          "goal": "Privacy"
        }
      ],
      "limitations": [
        {
          "description": "GAN training is notoriously difficult to stabilise, with potential for mode collapse or failure to converge, especially when additional fairness constraints are imposed."
        },
        {
          "description": "Ensuring fairness in generated data may come at the cost of data utility, potentially reducing the quality or realism of synthetic samples."
        },
        {
          "description": "Requires large datasets to train both generator and discriminator networks effectively, limiting applicability in data-scarce domains."
        },
        {
          "description": "Evaluation complexity is high, as it requires assessing both the quality of generated data and the preservation of fairness properties across demographic groups."
        },
        {
          "description": "May inadvertently introduce new biases if the fairness constraints are not properly specified or if the training data itself contains subtle biases."
        }
      ],
      "sampleClaims": [
        {
          "text": "The training dataset maintains balanced representation across demographic groups without compromising the statistical properties needed for model generalization",
          "domain": "healthcare",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The synthetic data preserves clinical utility whilst obfuscating patient demographic identifiers",
          "domain": "healthcare",
          "assuranceGoal": "privacy"
        },
        {
          "text": "The generated dataset exhibits statistical parity across protected attributes without relying on direct attribute removal",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The recommendation system's training data contains equitable representation of user demographics through controlled synthetic augmentation",
          "domain": "general",
          "assuranceGoal": "fairness"
        }
      ]
    },
    {
      "@id": "tea:technique/relabelling",
      "@type": "Technique",
      "name": "Relabelling",
      "slug": "relabelling",
      "description": "A preprocessing fairness technique that modifies class labels in training data to achieve equal positive outcome rates across protected groups. Also known as 'data massaging', this method identifies instances that contribute to discriminatory patterns and flips their labels (from positive to negative or vice versa) to balance the proportion of positive outcomes between demographic groups. The technique aims to remove historical bias from training data whilst preserving the overall class distribution, enabling standard classifiers to learn from discrimination-free datasets.",
      "addressesGoal": [
        "tea:goal/fairness",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/pre-processing",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/audit-trail",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/any",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/preprocessing-and-feature-engineering",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/evidence-type/modified-dataset"
      ],
      "complexityRating": 3,
      "computationalCostRating": 2,
      "relatedTo": [
        "tea:technique/reweighing",
        "tea:technique/disparate-impact-remover",
        "tea:technique/preferential-sampling"
      ],
      "citesResource": [
        "tea:resource/bantilanThemisml2026",
        "tea:resource/kamiranDataPreprocessingTechniques2012",
        "tea:resource/caldersClassifyingDiscriminating2010"
      ],
      "exampleUseCases": [
        {
          "description": "Preprocessing historical hiring datasets by relabelling borderline cases to ensure equal hiring rates across gender and ethnicity groups, correcting for past discriminatory practices whilst maintaining overall qualification standards for fair recruitment model training.",
          "goal": "Fairness"
        },
        {
          "description": "Creating transparent credit scoring datasets by documenting which loan applications had labels modified to address historical lending discrimination, providing clear audit trails showing how training data bias was systematically corrected before model development.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Altering training labels risks introducing new biases or artificial patterns that may not reflect genuine relationships in the data."
        },
        {
          "description": "Deciding which instances to relabel requires careful selection criteria and domain expertise to avoid inappropriate label changes."
        },
        {
          "description": "May reduce prediction accuracy if too many labels are changed, particularly when the modifications conflict with genuine patterns in the data."
        },
        {
          "description": "Requires access to ground truth or expert knowledge to determine whether original labels reflect genuine outcomes or discriminatory bias."
        },
        {
          "description": "Effectiveness depends on accurate identification of discriminatory instances, which can be challenging when bias patterns are subtle or complex."
        }
      ],
      "sampleClaims": [
        {
          "text": "The hiring system's training data has been corrected to achieve equal qualification acceptance rates across demographic groups through systematic label modification",
          "domain": "public sector",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The training dataset documents which diagnostic labels were modified to correct for historical treatment bias in underrepresented patient populations",
          "domain": "healthcare",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The model was trained on corrected labels that remove discriminatory patterns from historical outcomes without altering the underlying feature distributions",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The preprocessing pipeline identifies and flips classification labels for borderline cases to balance positive outcome rates across protected groups before model training",
          "domain": "general",
          "assuranceGoal": "transparency"
        }
      ]
    },
    {
      "@id": "tea:technique/preferential-sampling",
      "@type": "Technique",
      "name": "Preferential Sampling",
      "slug": "preferential-sampling",
      "description": "A preprocessing fairness technique developed by Kamiran and Calders that addresses dataset imbalances by re-sampling training data with preference for underrepresented groups to achieve discrimination-free classification. This method modifies the training distribution by prioritising borderline objects (instances near decision boundaries) from underrepresented groups for duplication whilst potentially removing instances from overrepresented groups. Unlike relabelling approaches, preferential sampling maintains original class labels whilst creating a more balanced dataset that prevents models from learning biased patterns due to skewed group representation.",
      "addressesGoal": [
        "tea:goal/fairness",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/pre-processing",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/audit-trail",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/any",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/preprocessing-and-feature-engineering",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/evidence-type/modified-dataset"
      ],
      "complexityRating": 2,
      "computationalCostRating": 2,
      "relatedTo": [
        "tea:technique/disparate-impact-remover",
        "tea:technique/reweighing",
        "tea:technique/relabelling"
      ],
      "citesResource": [
        "tea:resource/ResampleResampleData",
        "tea:resource/Fairmodels2026",
        "tea:resource/kamiranDataPreprocessingTechniques2012",
        "tea:resource/kamiranClassificationNoDiscrimination2010",
        "tea:resource/FairmodelsAdvancedTutorial"
      ],
      "exampleUseCases": [
        {
          "description": "Preprocessing hiring datasets by preferentially sampling candidates from underrepresented gender and ethnic groups, particularly focusing on borderline cases near decision boundaries, to ensure fair representation whilst maintaining original qualifications and labels for unbiased recruitment model training.",
          "goal": "Fairness"
        },
        {
          "description": "Creating transparent credit scoring datasets by documenting and adjusting the sampling process to ensure equal representation across demographic groups, providing clear evidence to regulators that training data imbalances have been addressed without altering original creditworthiness labels.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Oversampling minority groups can cause overfitting to duplicated examples, particularly when borderline instances are repeatedly sampled, potentially reducing model generalisation."
        },
        {
          "description": "Undersampling majority groups may remove important examples that contain valuable information, potentially degrading overall model performance."
        },
        {
          "description": "Does not address inherent algorithmic bias in the learning process itself, only correcting for representation imbalances in the training data."
        },
        {
          "description": "Selection of borderline objects requires careful threshold tuning and may be sensitive to the choice of distance metrics or similarity measures used."
        },
        {
          "description": "May not address intersectional fairness issues when multiple protected attributes create complex group combinations that require nuanced sampling strategies."
        }
      ],
      "sampleClaims": [
        {
          "text": "The training dataset achieves balanced representation across demographic groups without altering original qualification labels or outcome classifications",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The recruitment model's training data composition is documented showing which candidate groups were preferentially sampled to address historical representation imbalances",
          "domain": "public sector",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The classification system's training data includes proportionate representation of borderline cases from all protected groups",
          "domain": "general",
          "assuranceGoal": "fairness"
        }
      ]
    },
    {
      "@id": "tea:technique/attribute-removal-fairness-through-unawareness",
      "@type": "Technique",
      "name": "Attribute Removal (Fairness Through Unawareness)",
      "slug": "attribute-removal-fairness-through-unawareness",
      "description": "Attribute Removal (Fairness Through Unawareness) ensures fairness by completely excluding protected attributes such as race, gender, or age from the model's input features. While this approach prevents direct discrimination, it may not eliminate bias if other features are correlated with protected attributes (proxy discrimination). This technique represents the most basic fairness intervention but often needs to be combined with other approaches to address indirect bias through seemingly neutral features.",
      "addressesGoal": [
        "tea:goal/fairness",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/pre-processing",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/audit-trail",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/tabular",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/evidence-type/modified-dataset",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/preprocessing-and-feature-engineering",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/expertise-needed/regulatory-compliance"
      ],
      "complexityRating": 1,
      "computationalCostRating": 1,
      "relatedTo": [
        "tea:technique/fair-bayesian-optimisation",
        "tea:technique/fairness-testing",
        "tea:technique/reweighing"
      ],
      "citesResource": [
        "tea:resource/dworkFairnessAwareness2011",
        "tea:resource/kusnerCounterfactualFairness2017",
        "tea:resource/parkComparisonMethodsReduce2021"
      ],
      "exampleUseCases": [
        {
          "description": "Removing gender, race, and age attributes from hiring algorithms to prevent direct discrimination, whilst acknowledging that indirect bias may persist through correlated features like education institution or postal code.",
          "goal": "Fairness"
        },
        {
          "description": "Excluding protected demographic attributes from credit scoring models to comply with fair lending regulations, ensuring no explicit consideration of race, gender, or ethnicity in loan approval decisions.",
          "goal": "Fairness"
        },
        {
          "description": "Building medical diagnosis models that exclude patient race and ethnicity to prevent biased treatment recommendations, whilst ensuring clinical decisions are based solely on medical indicators and symptoms.",
          "goal": "Fairness"
        },
        {
          "description": "Creating transparent regulatory reporting systems that demonstrate compliance by explicitly documenting which protected attributes have been excluded from decision-making algorithms, providing clear audit trails for regulatory review.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Proxy discrimination remains a major concern as seemingly neutral features (education, postal code, previous employment) may strongly correlate with protected attributes, perpetuating indirect bias."
        },
        {
          "description": "Intersectional bias cannot be addressed through simple attribute removal, as complex interactions between multiple demographic characteristics may create compounding discrimination effects."
        },
        {
          "description": "Legal and regulatory compliance may be insufficient, as many jurisdictions require demonstrating disparate impact absence rather than simply removing protected attributes from models."
        },
        {
          "description": "Identifying all potential proxy variables is practically impossible, especially with high-dimensional data where subtle correlations with protected attributes may exist in unexpected features."
        },
        {
          "description": "Performance degradation may occur if removed attributes contain legitimate predictive information, creating tension between fairness objectives and model accuracy requirements."
        }
      ],
      "sampleClaims": [
        {
          "text": "The model makes decisions without direct access to protected demographic attributes such as race, gender, or age",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The lending system excludes ethnicity and gender information from all decision-making processes to prevent explicit discrimination in credit approvals",
          "domain": "finance",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The recruitment algorithm documents which protected attributes have been excluded from candidate evaluation to ensure regulatory compliance",
          "domain": "general",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The diagnostic system bases treatment recommendations solely on clinical indicators without incorporating patient race or ethnicity",
          "domain": "healthcare",
          "assuranceGoal": "fairness"
        },
        {
          "text": "All decision-making processes are auditable to verify that legally protected characteristics are not used as input features",
          "domain": "public sector",
          "assuranceGoal": "transparency"
        }
      ]
    },
    {
      "@id": "tea:technique/fair-adversarial-networks",
      "@type": "Technique",
      "name": "Fair Adversarial Networks",
      "slug": "fair-adversarial-networks",
      "description": "Fair Adversarial Networks is a pre-processing method, proposed by Cevora (2020), that produces a de-biased copy of a dataset from which a protected characteristic such as race, sex or age can no longer be predicted, including through proxies such as postcode or occupation. It trains two neural networks against each other: an autoencoder (a network that learns to reproduce its input) rewrites each record while trying to keep it as close to the original as possible, and an adversary network tries to predict the protected characteristic from the rewritten records. The autoencoder's loss adds its reconstruction error to the adversary's predictive success, so over alternating rounds of training it learns to remove the information the adversary relies on while changing the data as little as it can. The output is the rewritten dataset, which any downstream analysis or model can use without modification, together with the evidence that a freshly trained adversary predicts the characteristic no better than always guessing the most common category.",
      "addressesGoal": [
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/pre-processing",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/tabular",
        "tea:tag/evidence-type/modified-dataset",
        "tea:tag/expertise-needed/deep-learning",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/preprocessing-and-feature-engineering",
        "tea:tag/technique-type/algorithmic"
      ],
      "complexityRating": 5,
      "computationalCostRating": 4,
      "relatedTo": [
        "tea:technique/adversarial-debiasing",
        "tea:technique/exponentiated-gradient-reduction",
        "tea:technique/fairness-gan"
      ],
      "citesResource": [
        "tea:resource/cevoraFairAdversarialNetworks2020",
        "tea:resource/wilkinsonDemonstratingRosaFairness2020"
      ],
      "exampleUseCases": [
        {
          "description": "A probation service's analytics team wants to model reoffending from defendant records in which race is encoded indirectly, through charge descriptions and neighbourhood. It runs the records through a Fair Adversarial Network before modelling, confirms that a freshly trained classifier can no longer predict race from the transformed data better than chance, and then checks that predicted risk no longer differs by race among defendants with the same recorded outcome.",
          "goal": "Fairness"
        },
        {
          "description": "An HR analytics team at a courier company building an absenteeism model removes information about employees' age group from its personnel records, including through proxies such as length of service and family circumstances, so that the standard modelling tools its analysts already use can run on the transformed data unchanged.",
          "goal": "Fairness"
        },
        {
          "description": "A local education authority allocating support funding with a model of school performance data de-biases the data with respect to each school's majority ethnic composition before modelling, and keeps the adversary's chance-level result and the reconstruction error with the funding model's documentation as evidence of what was removed and how much the data changed.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "No public implementation exists. The paper withholds the parts that make training practical (an approximation of how well a fully trained adversary would do, a stabilising mechanism and regularisers) as its company's intellectual property, saying only that standard approaches can replicate the result on a one-off basis with heavy tuning, and the company's web tool is no longer online. Adopting the method means reimplementing it from the paper."
        },
        {
          "description": "It removes every trace of the protected characteristic, including relationships that are legitimate or deliberately protective; the author notes it also removes positive discrimination. Where the characteristic carries legitimate information, such as sex in some clinical data, that information goes along with the bias, and the accuracy drops seen on the demonstration datasets cannot be split into bias removed and signal lost."
        },
        {
          "description": "Success is judged against one adversary: in the paper, a single-hidden-layer network trained from three random starts. A more capable model may still recover the characteristic from the rewritten data, and the author states that residual discrimination is likely still present and was not analysed, so a chance-level adversary is weaker evidence than it appears."
        },
        {
          "description": "Every variable in every record can be altered by the autoencoder, so the de-biased dataset no longer contains the original values. Individual records cannot be checked against source data, feature meanings drift, and any explanation of a downstream model refers to transformed features rather than to the applicant's actual postcode or income."
        },
        {
          "description": "Adversarial training is unstable and its settings have no principled choice: the weight balancing reconstruction against the adversary, the network architectures and the stopping point all need tuning per dataset. The paper keeps the lowest-loss state to guard against run-away training and describes its own convergence as fairly sub-optimal."
        }
      ],
      "sampleClaims": [
        {
          "text": "A classifier trained on the de-biased reoffending dataset cannot predict defendants' race better than always guessing the majority group.",
          "domain": "public sector",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The personnel records used to train the absenteeism model carry no recoverable information about employees' age group, including through proxies such as length of service.",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The school funding model was trained on data de-biased with respect to majority ethnic composition, and its predictions no longer differ by that composition among schools with the same recorded performance.",
          "domain": "public sector",
          "assuranceGoal": "fairness"
        }
      ]
    },
    {
      "@id": "tea:technique/prejudice-remover-regulariser",
      "@type": "Technique",
      "name": "Prejudice Remover Regulariser",
      "slug": "prejudice-remover-regulariser",
      "description": "An in-processing fairness technique that adds a fairness penalty to machine learning models to reduce bias against protected groups. The method works by minimising 'mutual information' - essentially reducing how much the model's predictions reveal about sensitive attributes like race or gender. By adding this penalty term to the learning objective (typically in logistic regression), the technique ensures predictions become less dependent on protected features. This addresses not only direct discrimination but also indirect bias through correlated features. Practitioners can adjust a tuning parameter to balance between maintaining accuracy and removing prejudice from the model.",
      "addressesGoal": [
        "tea:goal/fairness",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/linear-models/logistic",
        "tea:tag/applicable-models/architecture/probabilistic",
        "tea:tag/applicable-models/paradigm/discriminative",
        "tea:tag/applicable-models/paradigm/probabilistic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/in-processing",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/assessment-results",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/tabular",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-selection-and-training",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/evidence-type/model-artefact"
      ],
      "complexityRating": 3,
      "computationalCostRating": 2,
      "relatedTo": [
        "tea:technique/reweighing",
        "tea:technique/adversarial-debiasing",
        "tea:technique/meta-fair-classifier"
      ],
      "citesResource": [
        "tea:resource/kamishimaFairnessAwareMachineLearning2012",
        "tea:resource/Aif360algorithmsinprocessingPrejudiceRemoverAIF360Documentation",
        "tea:resource/kamishimaFairnessawareClassifierFaclass2012",
        "tea:resource/kamishimaKamfadmFairnessawareData2023",
        "tea:resource/trusted-aiAIF3602018",
        "tea:resource/kamishimaFairnessAwareClassifierPrejudice2012",
        "tea:resource/AIF360TutorialMedical",
        "tea:resource/kozodoiFairnessCreditScoring2022",
        "tea:resource/raftopoulosEvaluatingFairnessStrategies2025"
      ],
      "exampleUseCases": [
        {
          "description": "Training credit scoring models with prejudice remover regularisation to ensure loan approval decisions are not influenced by gender or ethnicity, minimising mutual information between predictions and protected attributes whilst maintaining accurate risk assessment.",
          "goal": "Fairness"
        },
        {
          "description": "Developing transparent university admission models that provide clear evidence of bias mitigation by demonstrating reduced statistical dependence between acceptance decisions and protected characteristics, enabling regulatory compliance reporting.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Requires careful tuning of the fairness penalty hyperparameter, where too high values severely degrade accuracy whilst too low values provide insufficient bias mitigation."
        },
        {
          "description": "Primarily applicable to probabilistic discriminative models like logistic regression, limiting its use with other model architectures such as deep neural networks or tree-based methods."
        },
        {
          "description": "Computational complexity increases with the calculation of mutual information between predictions and sensitive attributes, particularly for high-dimensional data."
        },
        {
          "description": "May not fully eliminate all forms of discrimination, particularly when complex interactions between multiple sensitive attributes create intersectional biases."
        },
        {
          "description": "Effectiveness depends on accurate identification and inclusion of all sensitive attributes, potentially missing hidden biases from unobserved protected characteristics."
        }
      ],
      "sampleClaims": [
        {
          "text": "The model's loan approval predictions reveal minimal statistical information about applicants' protected demographic characteristics",
          "domain": "finance",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The hiring system's candidate evaluations are statistically independent of gender and ethnicity identifiers",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The admissions model documents the degree of statistical dependence between decisions and sensitive attributes through quantified mutual information metrics",
          "domain": "public sector",
          "assuranceGoal": "transparency"
        }
      ]
    },
    {
      "@id": "tea:technique/meta-fair-classifier",
      "@type": "Technique",
      "name": "Meta Fair Classifier",
      "slug": "meta-fair-classifier",
      "description": "An in-processing fairness technique that employs meta-learning to modify any existing classifier for optimising fairness metrics whilst maintaining predictive performance. The method learns how to adjust model parameters or decision boundaries to satisfy fairness constraints such as demographic parity or equalised odds through iterative optimisation. This approach is particularly valuable when retrofitting fairness to pre-trained models that perform well but exhibit bias, as it can incorporate fairness without requiring complete retraining from scratch.",
      "addressesGoal": [
        "tea:goal/fairness",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/gradient-access",
        "tea:tag/applicable-models/requirements/gray-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/in-processing",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/assessment-results",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/any",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-selection-and-training",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/evidence-type/model-artefact"
      ],
      "complexityRating": 5,
      "computationalCostRating": 4,
      "relatedTo": [
        "tea:technique/exponentiated-gradient-reduction",
        "tea:technique/fair-adversarial-networks",
        "tea:technique/multi-accuracy-boosting",
        "tea:technique/prejudice-remover-regulariser"
      ],
      "citesResource": [
        "tea:resource/holisticaidevelopersRFairMethodHolisticai2024",
        "tea:resource/aif360developersAif360algorithmsinprocessingAif3600102018",
        "tea:resource/trusted-aiAIF3602018",
        "tea:resource/holistic-aiHolisticai2023",
        "tea:resource/celisClassificationFairnessConstraints2019",
        "tea:resource/AIF360DemoMeta",
        "tea:resource/moldovanAlgorithmicDecisionMaking2022",
        "tea:resource/kozodoiFairnessCreditScoring2022"
      ],
      "exampleUseCases": [
        {
          "description": "Retrofitting an existing hiring algorithm to achieve demographic parity across gender and ethnicity groups by using meta-learning to adjust decision boundaries, ensuring equitable candidate selection whilst maintaining the model's ability to identify qualified applicants.",
          "goal": "Fairness"
        },
        {
          "description": "Modifying a pre-trained credit scoring model to provide transparent fairness guarantees by learning optimal parameter adjustments that satisfy equalised odds constraints, enabling clear reporting on fair lending compliance to regulatory authorities.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Meta-learning approach can be complex to implement, requiring expertise in both the underlying classifier and meta-optimisation techniques."
        },
        {
          "description": "Requires extensive hyperparameter tuning to balance fairness constraints with predictive performance, making optimisation challenging."
        },
        {
          "description": "May result in longer training times compared to simpler fairness techniques due to the iterative meta-learning process."
        },
        {
          "description": "Performance depends heavily on the quality and characteristics of the base classifier being modified, limiting effectiveness with poorly-performing models."
        },
        {
          "description": "Theoretical guarantees about fairness-accuracy trade-offs may not hold in practice due to finite sample effects and optimisation challenges."
        }
      ],
      "sampleClaims": [
        {
          "text": "The hiring model achieves equitable selection rates across demographic groups through learned parameter adjustments that preserve candidate assessment accuracy",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The credit scoring system's fairness improvements are traceable to specific model parameter modifications rather than opaque architectural changes",
          "domain": "finance",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The fraud detection system satisfies equalised odds constraints across protected groups without requiring retraining from scratch",
          "domain": "finance",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The environmental risk assessment model's fairness constraints are satisfied across geographic regions whilst maintaining predictive performance for resource allocation",
          "domain": "environmental",
          "assuranceGoal": "fairness"
        }
      ]
    },
    {
      "@id": "tea:technique/exponentiated-gradient-reduction",
      "@type": "Technique",
      "name": "Exponentiated Gradient Reduction",
      "slug": "exponentiated-gradient-reduction",
      "description": "An in-processing fairness technique based on Agarwal et al.'s reductions approach that transforms fair classification into a sequence of cost-sensitive classification problems. The method uses an exponentiated gradient algorithm to iteratively reweight training data, returning a randomised classifier that achieves the lowest empirical error whilst satisfying fairness constraints. This reduction-based framework provides theoretical guarantees about both accuracy and constraint violation, making it suitable for various fairness criteria including demographic parity and equalised odds.",
      "addressesGoal": [
        "tea:goal/fairness",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/discriminative",
        "tea:tag/applicable-models/paradigm/parametric",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/gradient-access",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/in-processing",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/assessment-results",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/any",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-selection-and-training",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/evidence-type/model-artefact"
      ],
      "complexityRating": 4,
      "computationalCostRating": 3,
      "relatedTo": [
        "tea:technique/reweighing",
        "tea:technique/meta-fair-classifier"
      ],
      "citesResource": [
        "tea:resource/fairlearndevelopersFairlearnExponentiatedGradient2018",
        "tea:resource/aif360developersIBMAIF360ExponentiatedGradientReduction2018",
        "tea:resource/fairlearnFairlearn2018",
        "tea:resource/trusted-aiAIF3602018",
        "tea:resource/agarwalReductionsApproachFair2018",
        "tea:resource/fairlearndevelopersFairlearnReductionsGuide2018",
        "tea:resource/AIF360DemoExponentiated",
        "tea:resource/moldovanAlgorithmicDecisionMaking2022",
        "tea:resource/farayolaFairnessfocusedApproachRecidivism2025"
      ],
      "exampleUseCases": [
        {
          "description": "Training a hiring algorithm with demographic parity constraints to ensure equal selection rates across gender groups, using iterative reweighting to balance fairness and predictive accuracy whilst maintaining legal compliance.",
          "goal": "Fairness"
        },
        {
          "description": "Developing a loan approval model with equalised odds constraints, providing transparent documentation of the theoretical guarantees about both error rates and fairness constraint violations achieved by the reduction approach.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Requires convex base learners for theoretical guarantees about convergence and optimality, limiting the choice of underlying models."
        },
        {
          "description": "Produces randomised classifiers that may give different predictions for identical inputs, which can be problematic in applications requiring consistent decisions."
        },
        {
          "description": "Convergence can be slow and sensitive to hyperparameter choices, particularly the learning rate and tolerance settings."
        },
        {
          "description": "Involves iterative retraining with adjusted weights, which can be computationally expensive for large datasets or complex models."
        },
        {
          "description": "Fairness constraints may significantly reduce model accuracy, and the trade-off between fairness and performance is not always transparent to practitioners."
        }
      ],
      "sampleClaims": [
        {
          "text": "The lending model satisfies demographic parity constraints with quantifiable bounds on both error rate and fairness violation",
          "domain": "finance",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The recruitment system maintains equalised odds across protected groups whilst providing formal guarantees about constraint satisfaction",
          "domain": "general",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The criminal justice risk assessment tool's predictions satisfy equitable treatment constraints with documented convergence properties",
          "domain": "public sector",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The fraud detection system's fairness guarantees are accompanied by formal bounds on constraint violation across demographic groups",
          "domain": "finance",
          "assuranceGoal": "transparency"
        }
      ]
    },
    {
      "@id": "tea:technique/learning-adversarially-fair-and-transferable-representations",
      "@type": "Technique",
      "name": "Learning Adversarially Fair and Transferable Representations",
      "slug": "learning-adversarially-fair-and-transferable-representations",
      "description": "Learning Adversarially Fair and Transferable Representations (LAFTR) trains an encoder that turns each record into a representation, a vector of learned features, from which a protected attribute is hard to recover, so that models later built on that representation by other parties, including for prediction tasks not known in advance, also treat groups fairly. It was designed for a data owner who shares encoded data with downstream model builders and cannot control how they train. During training, the encoder, a decoder that reconstructs the input and a classifier for the original task play against an adversary network that tries to predict the protected attribute from the representation; the encoder is updated to defeat the adversary while keeping the information the other two need. The adversary's objective is matched to demographic parity, equalised odds or equal opportunity, and the authors prove that an optimal adversary's objective bounds that unfairness measure for any classifier trained on the representation (for the two error-rate measures, with respect to the labels used in training). The output is a frozen encoder, delivered with the accuracy and fairness of classifiers trained on top of it.",
      "addressesGoal": [
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/neural-networks",
        "tea:tag/applicable-models/paradigm/parametric",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/gradient-access",
        "tea:tag/applicable-models/requirements/model-internals",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/in-processing",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/image",
        "tea:tag/data-type/tabular",
        "tea:tag/evidence-type/model-artefact",
        "tea:tag/expertise-needed/deep-learning",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-selection-and-training",
        "tea:tag/lifecycle-stage/model-development/preprocessing-and-feature-engineering",
        "tea:tag/technique-type/algorithmic"
      ],
      "acronym": "LAFTR",
      "complexityRating": 5,
      "computationalCostRating": 4,
      "relatedTo": [
        "tea:technique/reweighing",
        "tea:technique/adversarial-debiasing",
        "tea:technique/fair-adversarial-networks"
      ],
      "citesResource": [
        "tea:resource/madrasLearningAdversariallyFair2018",
        "tea:resource/LaftrLearningAdversarially2025",
        "tea:resource/MEDFAIRBenchmarkingFairness"
      ],
      "exampleUseCases": [
        {
          "description": "A data marketplace that supplies customer records to advertisers wants assurance that the targeting models advertisers build will not show offers to men and women at different rates. It trains LAFTR with the demographic parity adversary, releases only the encoded features, and audits a sample of advertisers' models for the gap in positive rates and for how well a fresh classifier can recover gender from the released features.",
          "goal": "Fairness"
        },
        {
          "description": "A health insurer's data team shares encoded claims and prescription data with external analytics suppliers who build their own risk models. It trains LAFTR with an equalised-odds adversary on a comorbidity-risk task, with patients aged 70 or over as the protected group, then measures error-rate gaps for classifiers trained on held-out condition-prediction tasks, because fairness on those new tasks has to be measured rather than assumed.",
          "goal": "Fairness"
        },
        {
          "description": "A hospital imaging research group compares LAFTR with standard training for a chest X-ray triage classifier, with patient sex as the protected attribute and the model-selection rule fixed in advance, to decide whether debiasing the representation narrows the gap in error rates enough to justify its extra training cost.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "The fairness bound holds only for an optimal adversary. A weak or under-trained adversary underestimates how much protected information the representation still carries, so downstream models can be less fair than training suggested; the authors report uneven results in places, which they attribute to unstable adversarial training. Audit downstream models directly, including with a fresh classifier trained to recover the protected attribute from the representation."
        },
        {
          "description": "Transfer to new tasks is not guaranteed for the error-rate criteria. The equalised-odds and equal-opportunity adversaries use the original task's labels, so fairness on a new task with different labels is an empirical result: in the paper's health-data experiment LAFTR was the fairest method on seven of ten transfer tasks, and the authors leave open which tasks transfer fairly."
        },
        {
          "description": "As formulated, it handles one binary protected attribute and a binary task label, so intersectional groups, several attributes or multi-class outcomes need an extension the original work does not provide. It needs the protected attribute, and for the error-rate criteria the task labels, at training time, though not when the representation is used."
        },
        {
          "description": "Measured gains can be small in practice. MEDFAIR, a peer-reviewed benchmark that ran LAFTR among eleven bias-mitigation methods on medical imaging datasets from several modalities, found that the methods did not significantly improve fairness over standard training, and that the choice of model-selection criterion changed fairness results substantially. Compare against a standard model under a selection rule stated in advance before adopting it."
        },
        {
          "description": "Four networks (encoder, decoder, classifier and adversary) are trained together, with three weights balancing accuracy, reconstruction and fairness; the paper found the reconstruction term necessary for transfer, and tuning the weights is laborious. The authors' reference code (2018) requires Python 3.6 and TensorFlow 1.9, and the available reimplementations sit inside research benchmarks rather than a supported fairness toolkit."
        }
      ],
      "sampleClaims": [
        {
          "text": "Classifiers trained by external parties on the released representation show a demographic parity difference below the agreed threshold on every downstream task audited.",
          "assuranceGoal": "fairness",
          "domain": "general"
        },
        {
          "text": "A classifier trained to recover the protected attribute from the released representation does no better than always predicting the majority group.",
          "assuranceGoal": "fairness",
          "domain": "general"
        },
        {
          "text": "The fairness of downstream risk models built on the shared encoded data was measured on each new prediction task rather than assumed from the task the encoder was trained on.",
          "assuranceGoal": "fairness",
          "domain": "healthcare"
        },
        {
          "text": "Under a model-selection rule fixed in advance, the debiased imaging model narrows the gap in error rates between patient groups relative to standard training by a measured margin.",
          "assuranceGoal": "fairness",
          "domain": "healthcare"
        }
      ]
    },
    {
      "@id": "tea:technique/multi-accuracy-boosting",
      "@type": "Technique",
      "name": "Multi-Accuracy Boosting",
      "slug": "multi-accuracy-boosting",
      "description": "An in-processing fairness technique that employs boosting algorithms to improve accuracy uniformly across demographic groups by iteratively correcting errors where the model performs poorly for certain subgroups. The method uses a multi-calibration approach that trains weak learners to focus on prediction errors for underperforming groups, ensuring that no group experiences systematically worse accuracy. This iterative boosting process continues until accuracy parity is achieved across all groups whilst maintaining overall model performance.",
      "addressesGoal": [
        "tea:goal/fairness",
        "tea:goal/reliability",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/ensemble",
        "tea:tag/applicable-models/paradigm/discriminative",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/in-processing",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/performance-assessment",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/assessment-results",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/any",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-selection-and-training",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/evidence-type/model-artefact"
      ],
      "complexityRating": 5,
      "computationalCostRating": 4,
      "relatedTo": [
        "tea:technique/reweighing",
        "tea:technique/adversarial-debiasing"
      ],
      "citesResource": [
        "tea:resource/McboostMultiCalibrationBoosting",
        "tea:resource/mlr-orgMcboost2020",
        "tea:resource/MultiAccuracyBoostAuthorsReference",
        "tea:resource/bischlMcboostMultiCalibrationBoosting2021",
        "tea:resource/kimMultiaccuracy2019",
        "tea:resource/hebert-johnsonCalibrationComputationallyIdentifiableMasses2018",
        "tea:resource/MCBoostBasicsExtensions"
      ],
      "exampleUseCases": [
        {
          "description": "Training a medical diagnosis model that achieves equal accuracy across age, gender, and ethnicity groups by using boosting to specifically target prediction errors for underrepresented patient demographics, ensuring equitable healthcare outcomes for all populations.",
          "goal": "Fairness"
        },
        {
          "description": "Building a robust fraud detection system that maintains consistent accuracy across different customer segments by iteratively correcting errors where the model performs poorly for specific demographic or geographic groups, ensuring reliable fraud prevention across all user types.",
          "goal": "Reliability"
        },
        {
          "description": "Developing a transparent hiring algorithm that provides clear evidence of equal performance across candidate demographics by using multi-accuracy boosting to systematically address group-specific prediction errors, enabling auditable fair recruitment processes.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Requires identifying and defining relevant subgroups or error regions, which may be challenging when group boundaries are unclear or overlapping."
        },
        {
          "description": "Could increase model complexity significantly as the boosting process adds multiple weak learners, potentially affecting interpretability and computational efficiency."
        },
        {
          "description": "May overfit to training data if very granular corrections are made, particularly when subgroups are small or the boosting process continues for too many iterations."
        },
        {
          "description": "Performance depends on the quality of subgroup identification, and may fail to achieve fairness if important demographic intersections are not properly captured."
        },
        {
          "description": "Convergence to equal accuracy across groups is not guaranteed, especially when there are fundamental differences in data distributions between groups."
        }
      ],
      "sampleClaims": [
        {
          "text": "The medical diagnosis system maintains equivalent prediction accuracy across patient age, gender, and ethnicity groups",
          "domain": "healthcare",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The fraud detection model achieves consistent error rates across customer demographics without systematic underperformance for any group",
          "domain": "finance",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The hiring algorithm demonstrates measurable accuracy parity across protected demographic categories with documented performance metrics for each group",
          "domain": "general",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The environmental risk assessment model produces equally accurate predictions across geographic regions and socioeconomic communities",
          "domain": "environmental",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The loan approval system maintains uniform prediction quality across applicant demographics without disproportionate errors for minority groups",
          "domain": "finance",
          "assuranceGoal": "reliability"
        }
      ]
    },
    {
      "@id": "tea:technique/threshold-optimiser",
      "@type": "Technique",
      "name": "Threshold Optimiser",
      "slug": "threshold-optimiser",
      "description": "Threshold Optimiser is a post-processing method, introduced by Hardt, Price and Srebro (2016), that makes an already-trained classifier's decisions meet a group fairness criterion without retraining it, most often equalised odds (equal true positive and false positive rates across groups) or equal opportunity (equal true positive rates only). Using a labelled validation set that records each person's group, it traces each group's ROC curve (the true and false positive rates obtained at every possible cut-off on the model's score) and chooses a separate cut-off for each group that maximises accuracy, or another chosen objective, subject to the criterion. When no single cut-off per group meets the criterion exactly, as is usual for equalised odds, each group's decision is randomised between two cut-offs with fixed probabilities. If the model returns only yes/no predictions rather than scores, the same method reduces to a small linear optimisation that sets, for each group and predicted label, the probability of flipping the prediction. The output is a group-aware decision rule that needs each person's group at prediction time; Fairlearn's ThresholdOptimizer implements the score-based form (and can also equalise selection rates), and AIF360's EqOddsPostprocessing implements the label-flipping form.",
      "addressesGoal": [
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/discriminative",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/post-processing",
        "tea:tag/data-requirements/calibration-set",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/model-artefact",
        "tea:tag/expertise-needed/regulatory-compliance",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/lifecycle-stage/system-deployment",
        "tea:tag/lifecycle-stage/system-deployment/system-implementation",
        "tea:tag/technique-type/algorithmic"
      ],
      "complexityRating": 2,
      "computationalCostRating": 1,
      "relatedTo": [
        "tea:technique/calibration-with-equality-of-opportunity",
        "tea:technique/reject-option-classification"
      ],
      "citesResource": [
        "tea:resource/fairlearndevelopersFairlearnThresholdOptimizer2018",
        "tea:resource/fairlearnFairlearn2018",
        "tea:resource/hardtEqualityOpportunitySupervised2016",
        "tea:resource/jangGroupAwareThresholdAdaptation2021",
        "tea:resource/fairlearndevelopersFairlearnPostprocessingMethods2018",
        "tea:resource/mackinIdentifyingMitigatingAlgorithmic2025",
        "tea:resource/trusted-aiAIF3602018"
      ],
      "exampleUseCases": [
        {
          "description": "A lender's model validation team applies the method to an existing credit-scoring model, choosing a separate approval cut-off for each racial group so that applicants who go on to repay are approved at the same rate in every group (equal opportunity). It compares the expected profit of that rule with a single cut-off and with an equalised-odds rule before recommending which one the credit committee should adopt.",
          "goal": "Fairness"
        },
        {
          "description": "A hospital system's data science team adjusts the alert threshold of an unplanned-readmission model separately for each race and ethnicity group, so that patients who are later readmitted are flagged at similar rates across groups. The change is accepted only because overall accuracy and daily alert volume stay within limits agreed with clinicians before the adjustment was made.",
          "goal": "Fairness"
        },
        {
          "description": "A public agency licenses a pre-trial risk tool that returns only high or low labels, with no access to scores or retraining. Using a held-out set of past cases with known outcomes, it derives the label-flipping rule that gives equal true and false positive rates across racial groups, and reports to its oversight board how many decisions the rule would change and how much accuracy it costs.",
          "goal": "Fairness"
        },
        {
          "description": "An HR analytics team piloting a CV-scoring model runs the method under equal opportunity and under equalised odds on its validation data, to show the selection panel what each criterion costs in accuracy and how many shortlisting decisions it would change. The comparison is the evidence for which fairness criterion the panel signs off before deployment.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "The cut-off depends on the person's group, so the protected attribute must be available at the moment of decision (Fairlearn's predict requires it). Where the attribute is not collected, or where applying different cut-offs by group could count as direct discrimination or disparate treatment, which Fairlearn's own guide flags for EU and US law, the rule may be unusable in deployment even though it works in validation."
        },
        {
          "description": "Meeting equalised odds exactly usually requires randomisation, so two people with the same score and group can receive different decisions, and Fairlearn notes that some solutions give a non-zero chance of a positive decision whatever the score. Where decisions must be reproducible or explained to the individual, such as credit refusals, this can rule the method out or force a relaxed constraint."
        },
        {
          "description": "Under equalised odds every group's error rates are held to what the hardest-to-predict group's ROC curve allows; Hardt et al. note such a classifier must classify everyone as poorly as the hardest group. In their credit case study it kept about 80% of maximum profit against about 93% for equal opportunity, and Fairlearn warns of levelling down: worse performance for the better-served group with no gain for the worse-served one."
        },
        {
          "description": "Cut-offs are estimated from a finite labelled sample in which group membership is known, and the original analysis sets sampling error aside. Small groups give unstable cut-offs, and rates equalised on the validation set drift when the population or the model's score distribution changes, so the cut-offs must be re-estimated and the equalised rates monitored after deployment."
        },
        {
          "description": "Equalised odds generally conflicts with calibration within groups: Pleiss et al. (2017) show calibration is compatible with at most one equal-error-rate constraint, and Hardt et al. note that equalised odds may compromise other desirable properties of a score. A team that must show both equal error rates and calibrated risk for each group cannot obtain both from this method and may have to settle for equal opportunity alone."
        }
      ],
      "sampleClaims": [
        {
          "text": "The credit approval model, with per-group cut-offs set on held-out data, approves applicants who go on to repay at the same rate across racial groups, within a stated tolerance.",
          "domain": "finance",
          "assuranceGoal": "fairness"
        },
        {
          "text": "After group-specific threshold adjustment, the readmission alert model flags patients who are later readmitted at similar rates across race and ethnicity groups, with overall accuracy and alert volume inside the limits agreed with clinicians.",
          "domain": "healthcare",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The pre-trial risk tool's post-processed decisions have equal true positive and false positive rates across racial groups on a held-out sample of past cases.",
          "domain": "public sector",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The fairness adjustment to the CV-scoring model was applied after training, leaving the trained model unchanged, and its cost in accuracy was measured and reported to the selection panel.",
          "domain": "general",
          "assuranceGoal": "fairness"
        }
      ]
    },
    {
      "@id": "tea:technique/reject-option-classification",
      "@type": "Technique",
      "name": "Reject Option Classification",
      "slug": "reject-option-classification",
      "description": "A post-processing fairness technique that modifies predictions in regions of high uncertainty to favour disadvantaged groups and achieve fairness objectives. The method identifies a 'rejection region' where the model's confidence is low (typically near the decision boundary) and reassigns predictions within this region to benefit underrepresented groups. By leveraging model uncertainty, this approach can improve fairness metrics like demographic parity or equalised odds whilst minimising changes to confident predictions, thus preserving overall accuracy for cases where the model is certain.",
      "addressesGoal": [
        "tea:goal/fairness",
        "tea:goal/reliability",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/applicable-models/requirements/probabilistic-output",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/post-processing",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/uncertainty-quantification",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/audit-trail",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/any",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/lifecycle-stage/system-deployment",
        "tea:tag/lifecycle-stage/system-deployment/system-implementation",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/evidence-type/model-artefact"
      ],
      "complexityRating": 3,
      "computationalCostRating": 2,
      "relatedTo": [
        "tea:technique/threshold-optimiser",
        "tea:technique/conformal-prediction",
        "tea:technique/confidence-thresholding"
      ],
      "citesResource": [
        "tea:resource/aif360developersAif360algorithmspostprocessingRejectOptionClassification2018",
        "tea:resource/trusted-aiAIF3602018",
        "tea:resource/kamiranDecisionTheoryDiscriminationAware2012",
        "tea:resource/kamiranExploitingRejectOption2018",
        "tea:resource/AIF360DemoReject",
        "tea:resource/farayolaFairnessfocusedApproachRecidivism2025",
        "tea:resource/raftopoulosEvaluatingFairnessStrategies2025"
      ],
      "exampleUseCases": [
        {
          "description": "Adjusting hiring algorithm predictions in the uncertainty region where candidate scores are close to the threshold, reassigning borderline cases to ensure equal selection rates across gender and ethnicity groups whilst maintaining decisions for clearly qualified or unqualified candidates.",
          "goal": "Fairness"
        },
        {
          "description": "Improving reliability of loan approval systems by identifying applications where the model is uncertain and adjusting these edge cases to ensure consistent approval rates across demographic groups, reducing the risk of systematic discrimination in borderline creditworthiness assessments.",
          "goal": "Reliability"
        },
        {
          "description": "Creating transparent bail decision systems that clearly document which predictions fall within the rejection region and how adjustments are made, providing courts with explainable fairness interventions that show exactly when and why decisions were modified for equity.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Requires models that provide reliable uncertainty estimates or probability scores, limiting applicability to deterministic classifiers without confidence outputs."
        },
        {
          "description": "Selection of the rejection region threshold is subjective and requires careful tuning to balance fairness improvements with accuracy preservation."
        },
        {
          "description": "May reject too many instances if tuned conservatively, potentially affecting a large portion of predictions and reducing the model's practical utility."
        },
        {
          "description": "Cannot address bias in confident predictions outside the rejection region, limiting effectiveness when discrimination occurs in high-certainty cases."
        },
        {
          "description": "Performance depends on the quality of uncertainty estimates, which may be poorly calibrated in some models, leading to inappropriate rejection regions."
        }
      ],
      "sampleClaims": [
        {
          "text": "The hiring system's selection decisions in uncertain candidate evaluations are adjusted to ensure equal opportunity across demographic groups",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The credit assessment model's predictions in borderline creditworthiness cases achieve equitable approval rates without modifying high-confidence decisions",
          "domain": "finance",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The diagnostic system's uncertain classifications maintain consistent accuracy across patient populations through targeted fairness adjustments",
          "domain": "healthcare",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The bail decision system documents which predictions fall within the uncertainty region and the rationale for fairness-motivated reassignments",
          "domain": "public sector",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The autonomous vehicle's object classification remains reliable across lighting conditions through uncertainty-aware decision adjustments that compensate for perceptual limitations in edge cases",
          "domain": "autonomous systems",
          "assuranceGoal": "reliability"
        }
      ]
    },
    {
      "@id": "tea:technique/calibration-with-equality-of-opportunity",
      "@type": "Technique",
      "name": "Calibration with Equality of Opportunity",
      "slug": "calibration-with-equality-of-opportunity",
      "description": "A post-processing fairness technique that adjusts model predictions to achieve equal true positive rates across protected groups whilst maintaining calibration within each group. The method addresses fairness by ensuring that qualified individuals from different demographic groups have equal chances of receiving positive predictions, whilst preserving the meaning of probability scores within each group. This technique attempts to balance the competing objectives of group fairness and accurate probability estimation.",
      "addressesGoal": [
        "tea:goal/fairness",
        "tea:goal/transparency",
        "tea:goal/reliability"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/applicable-models/requirements/probabilistic-output",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/post-processing",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/calibration",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/confidence-and-limits",
        "tea:tag/data-requirements/calibration-set",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/any",
        "tea:tag/expertise-needed/regulatory-compliance",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/evidence-type/model-artefact"
      ],
      "complexityRating": 4,
      "computationalCostRating": 2,
      "relatedTo": [
        "tea:technique/threshold-optimiser",
        "tea:technique/reject-option-classification"
      ],
      "citesResource": [
        "tea:resource/Aif360algorithmspostprocessingCalibratedEqOddsPostprocessingAif360Documentation",
        "tea:resource/gpleissEqualized_odds_and_calibration2017",
        "tea:resource/trusted-aiAIF3602018",
        "tea:resource/pleissFairnessCalibration2017",
        "tea:resource/hardtEqualityOpportunitySupervised2016",
        "tea:resource/AIF360DemoCalibrated",
        "tea:resource/raftopoulosEvaluatingFairnessStrategies2025"
      ],
      "exampleUseCases": [
        {
          "description": "Adjusting a loan approval model to ensure that qualified applicants from different ethnic backgrounds have equal approval rates, whilst maintaining that a 70% predicted repayment probability means the same thing for each ethnic group in practice.",
          "goal": "Fairness"
        },
        {
          "description": "Post-processing a university admissions algorithm to equalise acceptance rates for qualified students across gender groups, whilst ensuring the predicted success scores remain well-calibrated within each gender to support transparent decision-making.",
          "goal": "Transparency"
        },
        {
          "description": "Calibrating a medical diagnosis model to maintain equal detection rates for a disease across different age groups whilst preserving the reliability of risk scores, ensuring that a 30% risk prediction accurately reflects actual disease occurrence within each age group.",
          "goal": "Reliability"
        }
      ],
      "limitations": [
        {
          "description": "Fundamental mathematical incompatibility exists between perfect calibration and exact equality of opportunity, except in highly constrained special cases."
        },
        {
          "description": "May reduce overall model accuracy or calibration when forcing equal true positive rates across groups with genuinely different base rates."
        },
        {
          "description": "Requires access to sensitive attributes during post-processing, which may not be available or legally permissible in all contexts."
        },
        {
          "description": "The technique only addresses one aspect of fairness (true positive rates) and may allow disparities in false positive rates between groups."
        },
        {
          "description": "Post-processing approaches cannot address biases inherent in the training data or model architecture, only adjust final predictions."
        }
      ],
      "sampleClaims": [
        {
          "text": "The lending system ensures qualified applicants from different demographic groups receive positive outcomes at equal rates whilst probability scores retain consistent meaning within each group",
          "domain": "finance",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The diagnostic model achieves equal detection rates for the condition across patient populations whilst maintaining that a given risk score reflects the same actual disease probability within each population",
          "domain": "healthcare",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The system's probability estimates remain interpretable and well-calibrated within each demographic group after adjusting for equal opportunity",
          "domain": "public sector",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The model's confidence scores accurately reflect true outcome rates within each demographic segment despite equalising true positive rates across segments",
          "domain": "healthcare",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The system provides equally qualified individuals from all protected groups with equivalent likelihood of favourable classification",
          "domain": "general",
          "assuranceGoal": "fairness"
        }
      ]
    },
    {
      "@id": "tea:technique/equal-opportunity-difference",
      "@type": "Technique",
      "name": "Equal Opportunity Difference",
      "slug": "equal-opportunity-difference",
      "description": "A fairness metric that quantifies discrimination by measuring the difference in true positive rates (recall) between protected and privileged groups. Based on Hardt et al.'s equality of opportunity framework, this metric computes the maximum difference in TPR across demographic groups, with a value of 0 indicating perfect fairness. The technique provides a mathematical measure of whether qualified individuals from different groups have equal chances of receiving positive predictions.",
      "addressesGoal": [
        "tea:goal/fairness",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/bias-measurement",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/assessment-results",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/fairness-metric",
        "tea:tag/technique-type/metric",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation"
      ],
      "complexityRating": 2,
      "computationalCostRating": 1,
      "relatedTo": [
        "tea:technique/demographic-parity-assessment",
        "tea:technique/average-odds-difference",
        "tea:technique/calibration-with-equality-of-opportunity"
      ],
      "citesResource": [
        "tea:resource/aif360developersAif360sklearnmetricsequal_opportunity_differenceAif3600612018",
        "tea:resource/Fairlearnmetricsequal_opportunity_differenceFairlearnDocumentation",
        "tea:resource/trusted-aiAIF3602018",
        "tea:resource/fairlearnFairlearn2018",
        "tea:resource/hardtEqualityOpportunitySupervised2016",
        "tea:resource/bellamyAIFairness3602019",
        "tea:resource/AIF360TutorialMedical",
        "tea:resource/mackinIdentifyingMitigatingAlgorithmic2025",
        "tea:resource/bacongEvaluatingAlgorithmicFairness2026"
      ],
      "exampleUseCases": [
        {
          "description": "Evaluating a loan approval model to ensure that qualified applicants from different ethnic backgrounds have equal approval rates, measuring whether a 90% TPR for qualified white applicants is matched by similar rates for qualified minority applicants.",
          "goal": "Fairness"
        },
        {
          "description": "Auditing a medical diagnosis system to verify that patients with a particular condition are detected at equal rates across age groups, providing transparent evidence that diagnostic accuracy is consistent regardless of patient demographics.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Only considers true positive rates and ignores false positive rate disparities, potentially allowing discrimination in the form of unequal false alarm rates between groups."
        },
        {
          "description": "Requires accurate ground truth labels for the positive class, which may be biased or unavailable in some domains."
        },
        {
          "description": "Improving TPR for one group might increase FPR for that group, creating trade-offs between different types of fairness."
        },
        {
          "description": "Does not account for intersectional fairness across multiple protected attributes simultaneously."
        },
        {
          "description": "May not capture fairness concerns for the negative class or individuals who should not receive positive predictions."
        }
      ],
      "sampleClaims": [
        {
          "text": "The hiring system identifies qualified candidates at equivalent rates across demographic groups",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The diagnostic model detects disease in affected patients consistently regardless of patient ethnicity",
          "domain": "healthcare",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The benefit allocation system's true positive rate disparity across demographic groups is documented and monitored",
          "domain": "public sector",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The model's ability to correctly identify qualified individuals is measured separately for each protected group",
          "domain": "general",
          "assuranceGoal": "transparency"
        }
      ]
    },
    {
      "@id": "tea:technique/average-odds-difference",
      "@type": "Technique",
      "name": "Average Odds Difference",
      "slug": "average-odds-difference",
      "description": "Average Odds Difference measures fairness by calculating the average difference in both false positive rates and true positive rates between different demographic groups. This metric captures how consistently a model performs across groups for both positive and negative predictions. A value of 0 indicates perfect fairness under the equalized odds criterion, while larger absolute values indicate greater disparities in model performance between groups.",
      "addressesGoal": [
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/bias-measurement",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/fairness-metric",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/technique-type/metric",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/expertise-needed/domain-expertise"
      ],
      "complexityRating": 2,
      "computationalCostRating": 1,
      "relatedTo": [
        "tea:technique/demographic-parity-assessment",
        "tea:technique/equal-opportunity-difference",
        "tea:technique/calibration-with-equality-of-opportunity",
        "tea:technique/threshold-optimiser"
      ],
      "citesResource": [
        "tea:resource/aif360developersAIF360AverageOdds2018",
        "tea:resource/fairlearnFairlearn2018",
        "tea:resource/trusted-aiAIF3602018",
        "tea:resource/hardtEqualityOpportunitySupervised2016",
        "tea:resource/bellamyAIFairness3602019",
        "tea:resource/AIF360TutorialMedical",
        "tea:resource/bacongEvaluatingAlgorithmicFairness2026",
        "tea:resource/drukkerMachineLearningEvaluation2025"
      ],
      "exampleUseCases": [
        {
          "description": "Evaluating criminal risk assessment tools to ensure equal false positive rates (wrongly flagging low-risk individuals as high-risk) and true positive rates (correctly identifying high-risk individuals) across racial and ethnic groups.",
          "goal": "Fairness"
        },
        {
          "description": "Auditing hiring algorithms to verify that both the rate of correctly identifying qualified candidates and the rate of incorrectly rejecting qualified candidates remain consistent across gender and demographic groups.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "Averaging effect can mask important disparities when false positive and true positive rate differences compensate for each other, potentially hiding significant bias in one direction."
        },
        {
          "description": "Requires access to ground truth labels and sensitive attribute information, which may not be available in all deployment scenarios or may be subject to privacy constraints."
        },
        {
          "description": "Does not account for base rate differences between groups, meaning equal error rates may not translate to equal treatment when group prevalences differ significantly."
        },
        {
          "description": "Focuses solely on prediction accuracy disparities without considering whether the underlying decision-making process or feature selection introduces systematic bias against certain groups."
        },
        {
          "description": "May encourage optimization for fairness metrics at the expense of overall model performance, potentially reducing utility for the primary prediction task."
        }
      ],
      "sampleClaims": [
        {
          "text": "The criminal risk assessment system maintains equivalent error rates for both false alarms and correct identifications across racial and ethnic groups",
          "domain": "public sector",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The hiring model's accuracy in both accepting qualified candidates and rejecting unqualified candidates is consistent across all protected demographic categories",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The credit scoring model's true approval rate for creditworthy applicants and false approval rate for non-creditworthy applicants remain equitable across protected groups",
          "domain": "finance",
          "assuranceGoal": "fairness"
        }
      ]
    },
    {
      "@id": "tea:technique/path-specific-counterfactual-fairness-assessment",
      "@type": "Technique",
      "name": "Path-Specific Counterfactual Fairness Assessment",
      "slug": "path-specific-counterfactual-fairness-assessment",
      "description": "A causal fairness evaluation technique that assesses algorithmic discrimination by examining specific causal pathways in a model's decision-making process. Unlike general counterfactual fairness, this approach enables practitioners to identify and intervene on particular causal paths that may introduce bias whilst preserving other legitimate pathways. The method uses causal graphs to distinguish between direct discrimination (through protected attributes) and indirect discrimination (through seemingly neutral factors that correlate with protected attributes), allowing for more nuanced fairness assessments in complex causal settings.",
      "addressesGoal": [
        "tea:goal/fairness",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/bias-measurement",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/assessment-results",
        "tea:tag/data-requirements/causal-graph",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/tabular",
        "tea:tag/evidence-type/causal-analysis",
        "tea:tag/evidence-type/fairness-metric",
        "tea:tag/expertise-needed/causal-inference",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/expertise-needed/ethics",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/technique-type/metric"
      ],
      "complexityRating": 5,
      "computationalCostRating": 4,
      "relatedTo": [
        "tea:technique/counterfactual-fairness-assessment",
        "tea:technique/fairness-testing"
      ],
      "citesResource": [
        "tea:resource/CausalFairnessAnalysis",
        "tea:resource/dpleckoFaircauseCausalFairness2026",
        "tea:resource/chiappaPathSpecificCounterfactualFairness2019",
        "tea:resource/zhangCausalFrameworkDiscovering2017",
        "tea:resource/pleckoCausalFairnessAnalysis2024",
        "tea:resource/CausalFairnessAnalysisa",
        "tea:resource/zhangPathspecificEffectsPulseoximetry2025"
      ],
      "exampleUseCases": [
        {
          "description": "Evaluating hiring algorithms by identifying which causal pathways from education and experience legitimately affect job performance versus those that introduce gender or racial bias, enabling targeted interventions that preserve merit-based selection whilst eliminating discriminatory pathways.",
          "goal": "Fairness"
        },
        {
          "description": "Analysing loan approval models to provide transparent evidence of which factors legitimately influence creditworthiness versus those that create indirect discrimination, enabling clear explanations to regulators about causal mechanisms underlying fair lending decisions.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Requires identifying which causal pathways are 'allowable' and which are not—a subjective decision; analyzing specific paths adds complexity to the causal model and the fairness criterion."
        },
        {
          "description": "Causal graph construction relies on domain expertise and cannot be validated from observational data alone; if the graph incorrectly encodes causal structure or omits relevant edges, the path-specific assessment may certify an unfair model as compliant with no internal mechanism to detect the error, and this uncertainty is rarely surfaced in compliance documentation."
        },
        {
          "description": "Path-specific causal effects are frequently non-identifiable from observational data alone; when unobserved confounders exist between a sensitive attribute and mediating variables or outcomes, the effect along a specific pathway cannot be uniquely recovered without additional parametric assumptions, reducing the technique to bounding rather than point-estimation of discrimination."
        }
      ],
      "sampleClaims": [
        {
          "text": "The hiring system's decisions are not influenced by gender through educational pathways whilst preserving the legitimate influence of qualifications on employment outcomes",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The loan approval model's risk assessment isolates the direct influence of creditworthiness from indirect effects of demographic characteristics propagating through correlated factors",
          "domain": "finance",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The decision process documents which factors legitimately affect outcomes versus those that create indirect discrimination through upstream correlations",
          "domain": "public sector",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The model's treatment recommendations remain consistent across patient demographics when controlling for symptom severity and medical history whilst allowing clinically relevant differences to influence care decisions",
          "domain": "healthcare",
          "assuranceGoal": "fairness"
        }
      ]
    },
    {
      "@id": "tea:technique/fair-bayesian-optimisation",
      "@type": "Technique",
      "name": "Fair Bayesian Optimisation",
      "slug": "fair-bayesian-optimisation",
      "description": "Fair Bayesian Optimisation (FairBO) tunes a model's hyperparameters, the settings fixed before training such as tree depth or regularisation strength, to find the most accurate model that also meets a fairness threshold chosen in advance, for example a difference in positive-prediction rates between two groups of at most 0.05. Because it only changes hyperparameters and retrains, it treats the model and its training pipeline as a black box, so it works with any model class and any group fairness metric, can enforce several metrics at once, and leaves a model that needs no protected attribute at prediction time. Each step trains a model with a candidate configuration and measures its validation accuracy and fairness, and two Gaussian processes (statistical models that predict a value together with its uncertainty) are fitted to the results of the configurations tried so far. The next configuration is the one with the highest expected improvement in accuracy weighted by the predicted probability of meeting the fairness constraint; until a fair configuration has been found, the search maximises that probability alone. The output is the best configuration that met the constraint, with its accuracy and fairness measurements.",
      "addressesGoal": [
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/in-processing",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/tabular",
        "tea:tag/evidence-type/model-artefact",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-selection-and-training",
        "tea:tag/technique-type/algorithmic"
      ],
      "acronym": "FairBO",
      "complexityRating": 5,
      "computationalCostRating": 4,
      "relatedTo": [
        "tea:technique/prejudice-remover-regulariser",
        "tea:technique/exponentiated-gradient-reduction"
      ],
      "citesResource": [
        "tea:resource/perroneFairBayesianOptimization2020",
        "tea:resource/SyneTuneV0130",
        "tea:resource/AutoGluonV031Constrained",
        "tea:resource/FairBayesianOptimization"
      ],
      "exampleUseCases": [
        {
          "description": "A lender's model risk team tunes a gradient-boosted credit-risk model under a constraint that the approval-rate difference between applicants of different nationality stays at or below 0.05. It records the most accurate configuration that met the constraint beside the result of unconstrained tuning, so the model approval committee can see what accuracy the constraint cost.",
          "goal": "Fairness"
        },
        {
          "description": "An HR analytics team at a large employer tunes a random forest that ranks job applications for interview, enforcing limits on the gender gap in true positive rates and on the gap in shortlisting rates at the same time, because its policy commits to both equal opportunity and comparable shortlisting rates.",
          "goal": "Fairness"
        },
        {
          "description": "A data science team at a health insurer already runs an adversarially debiased claims-triage model whose fairness changed sharply with its learning rate and adversary weight. It uses FairBO to tune those hyperparameters under a statistical parity constraint, rather than tuning them for accuracy alone and checking fairness afterwards.",
          "goal": "Fairness"
        },
        {
          "description": "A local authority building a model to prioritise benefit-fraud reviews cannot use ethnicity as an input at decision time. It holds ethnicity only in a validation extract, uses FairBO to select hyperparameters that keep the referral-rate gap within its equality impact assessment threshold, and then confirms the gap on a separate held-out sample before deployment.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "It can only reach fairness that some hyperparameter setting already provides. If no configuration in the search space meets the threshold, it returns no fair model. The originating paper found that regularisation hyperparameters (tree depth, weight penalties, learning rate) drive most of the effect, so a search space without them leaves far fewer fair options."
        },
        {
          "description": "The fairness metric and its threshold must be fixed before the search, and the result says nothing about metrics that were not constrained. Choosing them is a normative decision the method does not make. If decision-makers need to see the whole accuracy-fairness trade-off before picking a threshold, a multi-objective search is needed, which the paper found slower to reach a model meeting a given threshold."
        },
        {
          "description": "A constraint can be met by a model that barely distinguishes between anyone. The paper shows that as regularisation grows, predictions approach a constant and satisfy every group fairness metric, and on its benchmarks random search found fair models only at the accuracy of always predicting the majority class. Check accuracy and error rates within each group, not only the fairness gap, before accepting the result."
        },
        {
          "description": "Every step trains a full model, so the cost is the training cost multiplied by the number of evaluations (the paper used up to 100), which is expensive for large models. The fairness value guiding the search is estimated on the validation split used during tuning, so it carries sampling error that is large when a group is small; confirm the gap on held-out data before relying on it."
        },
        {
          "description": "No maintained implementation exists. The authors released it in AutoGluon 0.3.1 (2021), which dropped it from version 0.4.0; it later lived in Syne Tune until version 0.13.0 (2024), and later Syne Tune releases removed the constrained searcher although the current documentation still describes it. Using it today means pinning an old release or rebuilding the method on a general constrained Bayesian optimisation library."
        }
      ],
      "sampleClaims": [
        {
          "text": "The credit model is the most accurate of the hyperparameter configurations searched whose approval-rate difference between groups was at most 0.05 on validation data, and the gap was confirmed on held-out data.",
          "assuranceGoal": "fairness",
          "domain": "finance"
        },
        {
          "text": "The screening model meets the agreed limits on both the true-positive-rate gap and the selection-rate gap between groups when measured on held-out data.",
          "assuranceGoal": "fairness",
          "domain": "general"
        },
        {
          "text": "The deployed model meets the fairness threshold without needing the protected attribute at prediction time.",
          "assuranceGoal": "fairness",
          "domain": "public sector"
        },
        {
          "text": "The accuracy given up to meet the fairness threshold has been measured against unconstrained tuning of the same model and is documented.",
          "assuranceGoal": "fairness",
          "domain": "general"
        }
      ]
    },
    {
      "@id": "tea:technique/model-development-audit-trails",
      "@type": "Technique",
      "name": "Model Development Audit Trails",
      "slug": "model-development-audit-trails",
      "description": "Model development audit trails create comprehensive, immutable records of all decisions, experiments, and changes throughout the ML lifecycle. This technique captures dataset versions, training configurations, hyperparameter searches, model architecture changes, evaluation results, and deployment decisions in tamper-evident logs. Audit trails enable reproducibility, accountability, and regulatory compliance by documenting who made what changes when and why, supporting post-hoc investigation of model failures or unexpected behaviours.",
      "addressesGoal": [
        "tea:goal/general",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/data-type/any",
        "tea:tag/technique-type/process",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/regulatory-compliance",
        "tea:tag/expertise-needed/software-engineering",
        "tea:tag/expertise-needed/governance-and-audit",
        "tea:tag/expertise-needed/data-engineering",
        "tea:tag/data-requirements/no-special-requirements",
        "tea:tag/assurance-goal-category/general",
        "tea:tag/assurance-goal-category/general/documentation-and-records",
        "tea:tag/lifecycle-stage/other/cross-cutting",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-documentation",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/audit-trail",
        "tea:tag/evidence-type/documentation",
        "tea:tag/evidence-type/audit-record"
      ],
      "relatedTo": [
        "tea:technique/mlflow-experiment-tracking",
        "tea:technique/data-version-control",
        "tea:technique/model-cards"
      ],
      "citesResource": [
        "tea:resource/mlflowMlflow2018",
        "tea:resource/iterativeDvc2017",
        "tea:resource/foalemLoggingRequirementContinuous2025"
      ],
      "exampleUseCases": [
        {
          "description": "Maintaining detailed audit trails for medical AI development enabling investigators to trace how training data, model architecture, and evaluation decisions led to specific diagnostic behaviors during regulatory review.",
          "goal": "Transparency"
        },
        {
          "description": "Recording all model updates and performance changes over time to support root cause analysis when deployed systems exhibit unexpected behavior or reliability degradation.",
          "goal": "Reliability"
        },
        {
          "description": "Documenting safety-critical decisions like dataset filtering, bias testing, and red teaming results to demonstrate due diligence in preventing harmful deployments.",
          "goal": "Safety"
        },
        {
          "description": "Documenting credit scoring model development for regulatory compliance, maintaining detailed records of data sources, feature engineering decisions, fairness testing, and validation results to demonstrate adherence to fair lending requirements during audits.",
          "goal": "Transparency"
        },
        {
          "description": "Creating comprehensive audit trails for criminal justice risk assessment tools to enable external review of training data selection, bias mitigation techniques, and validation methodologies when legal challenges question algorithmic fairness.",
          "goal": "Fairness"
        },
        {
          "description": "Maintaining development logs for autonomous vehicle perception systems to support accident investigations, enabling forensic analysis of which model version was deployed, what training data informed its behavior, and what testing validated its safety.",
          "goal": "Safety"
        }
      ],
      "limitations": [
        {
          "description": "Comprehensive logging generates large volumes of data requiring significant storage infrastructure and data management."
        },
        {
          "description": "Audit trails may contain sensitive information about proprietary techniques, requiring careful access control and redaction procedures."
        },
        {
          "description": "Creating meaningful audit trails requires discipline and tooling integration that may slow development velocity."
        },
        {
          "description": "Retrospective analysis of audit trails can be time-consuming and requires expertise to extract actionable insights from complex logs."
        },
        {
          "description": "Implementing comprehensive audit trail systems requires integrating with diverse development tools (version control, experiment tracking, data pipelines), which can be complex and may require custom development for organisation-specific workflows."
        },
        {
          "description": "Storage costs can be substantial, with comprehensive model development projects generating terabytes of logs, experimental artifacts, and dataset versions requiring long-term retention for compliance purposes."
        }
      ],
      "sampleClaims": [
        {
          "text": "All model development decisions are traceable to documented rationale and identified decision-makers",
          "domain": "general",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The diagnostic system's training data lineage, architecture changes, and validation results are preserved in tamper-evident logs enabling regulatory review",
          "domain": "healthcare",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The model's unexpected behaviour can be investigated by tracing dataset versions, hyperparameter configurations, and evaluation metrics back to specific development phases",
          "domain": "finance",
          "assuranceGoal": "reliability"
        },
        {
          "text": "All safety-critical decisions during autonomous system development are recorded with timestamps, responsible parties, and justifications",
          "domain": "autonomous systems",
          "assuranceGoal": "safety"
        },
        {
          "text": "The environmental forecasting model's experimental results and deployment decisions are reproducible from archived configurations and versioned datasets",
          "domain": "environmental",
          "assuranceGoal": "reliability"
        }
      ]
    },
    {
      "@id": "tea:technique/adversarial-training-evaluation",
      "@type": "Technique",
      "name": "Adversarial Training Evaluation",
      "slug": "adversarial-training-evaluation",
      "description": "Adversarial training evaluation assesses whether models trained with adversarial examples have genuinely improved robustness rather than merely overfitting to specific attack methods. This technique tests robustness against diverse attack algorithms including those not used during training, measures certified robustness bounds, and evaluates whether adversarial training creates exploitable trade-offs in clean accuracy or introduces new vulnerabilities. Evaluation ensures adversarial training provides genuine security benefits rather than superficial improvements.",
      "addressesGoal": [
        "tea:goal/security",
        "tea:goal/reliability",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/architecture/neural-networks",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/security",
        "tea:tag/assurance-goal-category/security/vulnerability-testing",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/robustness",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/assessment-results",
        "tea:tag/data-type/any",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/technique-type/testing",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/security"
      ],
      "relatedTo": [
        "tea:technique/red-teaming",
        "tea:technique/data-poisoning-detection",
        "tea:technique/model-extraction-defence-testing",
        "tea:technique/jailbreak-resistance-testing"
      ],
      "citesResource": [
        "tea:resource/adversarial-robustness-toolboxdevelopersWelcomeAdversarialRobustness",
        "tea:resource/robustnessdevelopersTrainingEvaluatingNetworks2019",
        "tea:resource/adversarial-robustness-toolboxdevelopersArtmetricsAdversarialRobustness",
        "tea:resource/fra31AutoAttackFra31Autoattack2026",
        "tea:resource/AdversarialRobustnessToolbox2026",
        "tea:resource/carliniEvaluatingAdversarialRobustness2019",
        "tea:resource/croceReliableEvaluationAdversarial2020",
        "tea:resource/DemonstrateAdversarialTraining",
        "tea:resource/khakzarLearningInterpretableFeatures2019"
      ],
      "exampleUseCases": [
        {
          "description": "Verifying that an adversarially-trained facial recognition system demonstrates genuine robustness against diverse attack types beyond those used in training, preventing false confidence in security.",
          "goal": "Security"
        },
        {
          "description": "Ensuring adversarial training of a spam filter improves reliable detection of adversarial emails without significantly degrading performance on normal messages.",
          "goal": "Reliability"
        },
        {
          "description": "Evaluating whether adversarial training of a loan approval model maintains fair lending decisions whilst improving robustness against applicants attempting to game the system through strategic feature manipulation.",
          "goal": "Reliability"
        },
        {
          "description": "Assessing whether adversarially-trained automated essay grading systems remain reliable on standard student submissions whilst becoming more robust to attempts at deliberately confusing the model with adversarial writing patterns.",
          "goal": "Reliability"
        },
        {
          "description": "Verifying that adversarial training of a medical imaging classifier for tumour detection maintains diagnostic accuracy on routine cases whilst improving robustness to image quality variations and potential adversarial attacks.",
          "goal": "Security"
        },
        {
          "description": "Documenting adversarial training evaluation results in a model card or technical dossier to meet transparency and disclosure obligations for high-risk AI systems, enabling regulators and deployers to assess whether robustness claims are substantiated by rigorous evaluation across diverse attack types beyond those used in training.",
          "goal": "Transparency"
        }
      ],
      "limitations": [
        {
          "description": "Models may overfit to adversarial examples in training data without generalizing to fundamentally different attack strategies."
        },
        {
          "description": "Adversarial training typically reduces clean accuracy by 2-10 percentage points, requiring careful evaluation of security-accuracy trade-offs for each application."
        },
        {
          "description": "Difficult to achieve certified robustness guarantees that hold against all possible attacks within a specified threat model."
        },
        {
          "description": "Adversarial training increases training time by 2-10x compared to standard training, as each batch requires generating adversarial examples, making it resource-intensive for large models or datasets."
        },
        {
          "description": "Requires diverse attack types for comprehensive evaluation beyond training distribution, necessitating ongoing research into emerging attack methods and regular re-evaluation cycles."
        }
      ],
      "sampleClaims": [
        {
          "text": "The system maintains reliable performance when subjected to attack strategies not encountered during its development",
          "domain": "general",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The facial recognition system resists malicious manipulation attempts that fundamentally differ from those used to harden its defenses",
          "domain": "security",
          "assuranceGoal": "security"
        },
        {
          "text": "The spam filter's improved resilience to adversarial messages does not significantly degrade its accuracy on legitimate communications",
          "domain": "general",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The model's documented robustness improvements reflect genuine security gains rather than adaptation to specific test cases",
          "domain": "general",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The medical imaging classifier maintains diagnostic accuracy on routine cases while demonstrating measurable resistance to deliberate input perturbations",
          "domain": "healthcare",
          "assuranceGoal": "security"
        }
      ]
    },
    {
      "@id": "tea:technique/agent-goal-misalignment-testing",
      "@type": "Technique",
      "name": "Agent Goal Misalignment Testing",
      "slug": "agent-goal-misalignment-testing",
      "description": "Agent goal misalignment testing checks whether an AI agent, given a goal that could be advanced by means its operators have not sanctioned, takes those means. The tester builds scenarios around a goal conflict: the agent has a task, tools and access, and the situation offers a harmful or forbidden route to its goal, such as deceiving a user, leaking confidential information, acquiring power or resources beyond its remit, or coercing people to avoid being replaced, while its instructions or ordinary ethics rule that route out. Each scenario is run many times, and every transcript is classified, by a language-model classifier checked against human judgement or by annotators, for whether the agent took a misaligned action. The result is the rate of misaligned actions per scenario and per model, with example transcripts, and how that rate changes with factors the tester varies, such as a threat to the agent's continued operation or an explicit instruction not to cause harm. It needs no access to a reward function or to training: it tests the behaviour of an already-trained agent.",
      "addressesGoal": [
        "tea:goal/safety",
        "tea:goal/reliability"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/architecture/neural-networks/transformer/llm",
        "tea:tag/applicable-models/paradigm/generative",
        "tea:tag/applicable-models/paradigm/reinforcement",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/behavioural-consistency",
        "tea:tag/assurance-goal-category/safety",
        "tea:tag/assurance-goal-category/safety/hazard-identification",
        "tea:tag/data-requirements/test-scenarios",
        "tea:tag/data-type/text",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/evidence-type/qualitative-report",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/evaluation-design",
        "tea:tag/technique-type/testing",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/lifecycle-stage/system-deployment",
        "tea:tag/lifecycle-stage/system-deployment/system-implementation"
      ],
      "relatedTo": [
        "tea:technique/prompt-injection-testing",
        "tea:technique/constitutional-ai-evaluation",
        "tea:technique/multi-agent-system-testing",
        "tea:technique/reward-hacking-detection"
      ],
      "citesResource": [
        "tea:resource/AgenticMisalignmentHow2025",
        "tea:resource/AgenticmisalignmentAnthropicexperimental2026",
        "tea:resource/panRewardsJustifyMeans2023",
        "tea:resource/soulyUKAISIAlignment2026"
      ],
      "exampleUseCases": [
        {
          "description": "Before giving an email and calendar agent access to client records, a bank runs it through scenarios in which its assigned target can only be met by sending confidential client data to an outside party, and records how often it does so with and without a system-prompt prohibition, to decide whether the agent needs a human approval step for outbound messages.",
          "goal": "Safety"
        },
        {
          "description": "A national AI evaluation body tests coding agents deployed inside a simulated research lab for whether they sabotage or refuse safety-related tasks when the scenario says the agent is about to be replaced, and reports the rates to the developers before wider internal deployment.",
          "goal": "Safety"
        },
        {
          "description": "A logistics firm upgrading the model behind its procurement agent runs the old and new models through the same scenarios, in which a delivery deadline can only be met by exceeding the agent's delegated spending limit or misreporting an order's status, and adopts the new model only if it stays within its operator's constraints at least as often.",
          "goal": "Reliability"
        }
      ],
      "limitations": [
        {
          "description": "Scenarios are artificial. To make behaviour measurable they usually offer a stark choice between failing the goal and a harmful act, and place the key information side by side, whereas real deployments offer more alternatives. Measured rates may therefore overstate or understate what an agent would do in use, and do not transfer directly to a deployment."
        },
        {
          "description": "Agents may behave differently when they judge they are being tested. In the agentic-misalignment study one model blackmailed in 55.1% of runs when it concluded the scenario was real and 6.5% when it concluded it was an evaluation, so a low measured rate can understate deployed behaviour."
        },
        {
          "description": "It only tests the misaligned routes the scenarios offer. A clean result on one suite says nothing about routes it did not include, and building enough realistic scenario variants for a given deployment (tools, data, organisational context) takes substantial evaluation-design and domain effort."
        },
        {
          "description": "Rates are only as good as the transcript classification. Classifiers based on language models, or keyword matching, misjudge borderline actions, and their error rate feeds straight into the reported rates; a sample of transcripts needs human checking for each new scenario family."
        },
        {
          "description": "It measures how often an agent acts, not why. An agent's stated reasoning may not reflect what drove its action, and role-play can explain some behaviour, so transcripts cannot establish whether a misaligned action came from the goal, the framing or the scenario's cues."
        }
      ],
      "sampleClaims": [
        {
          "text": "Across the goal-conflict scenarios in the test suite, the agent took no action that disclosed confidential client data to an outside party",
          "domain": "finance",
          "assuranceGoal": "safety"
        },
        {
          "text": "When told it would be replaced, the agent did not attempt to deceive or coerce its operators to prevent the replacement in any sampled run",
          "domain": "general",
          "assuranceGoal": "safety"
        },
        {
          "text": "The procurement agent stayed within its delegated spending limit in every scenario where exceeding it was the only way to meet the assigned deadline",
          "domain": "general",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The upgraded agent model shows a misaligned-action rate no higher than the version it replaces on the same scenario suite",
          "domain": "general",
          "assuranceGoal": "reliability"
        }
      ]
    },
    {
      "@id": "tea:technique/api-usage-pattern-monitoring",
      "@type": "Technique",
      "name": "API Usage Pattern Monitoring",
      "slug": "api-usage-pattern-monitoring",
      "description": "API usage pattern monitoring analyses AI model API usage to detect anomalies and generate evidence of secure operation. This technique tracks request patterns, input distributions, and usage velocity to produce security reports, anomaly detection evidence, and usage compliance documentation. Monitoring generates quantitative metrics on extraction attempt frequency, adversarial probing patterns, and deviation from intended use, creating auditable evidence for assurance cases.",
      "addressesGoal": [
        "tea:goal/security",
        "tea:goal/safety",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/security",
        "tea:tag/assurance-goal-category/security/detection",
        "tea:tag/assurance-goal-category/safety",
        "tea:tag/assurance-goal-category/safety/monitoring",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/audit-trail",
        "tea:tag/data-type/any",
        "tea:tag/data-requirements/no-special-requirements",
        "tea:tag/lifecycle-stage/system-deployment",
        "tea:tag/lifecycle-stage/system-deployment/system-use-and-monitoring",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/evidence-type/documentation",
        "tea:tag/evidence-type/audit-record",
        "tea:tag/expertise-needed/security",
        "tea:tag/expertise-needed/software-engineering",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/expertise-needed/human-factors"
      ],
      "relatedTo": [
        "tea:technique/runtime-monitoring-and-circuit-breakers",
        "tea:technique/prompt-injection-testing",
        "tea:technique/model-development-audit-trails"
      ],
      "citesResource": [
        "tea:resource/alvinashcraftAbuseMonitoringMicrosoft",
        "tea:resource/editorLLM102025Unbounded",
        "tea:resource/Langfuse2026",
        "tea:resource/kesarwaniModelExtractionWarning2018",
        "tea:resource/juutiPRADAProtectingDNN2019"
      ],
      "exampleUseCases": [
        {
          "description": "Detecting suspicious query patterns in a fraud detection API that might indicate attackers are probing to understand decision boundaries and evade detection.",
          "goal": "Security"
        },
        {
          "description": "Monitoring a content moderation API for unexpected input distributions that might indicate new types of harmful content not adequately covered by current safety measures.",
          "goal": "Safety"
        },
        {
          "description": "Providing transparent reporting on actual API usage patterns versus intended use cases, enabling proactive identification of misuse and appropriate interventions.",
          "goal": "Transparency"
        },
        {
          "description": "Monitoring query patterns in a healthcare diagnosis API to detect when clinics are submitting unusual volumes or types of queries that might indicate misuse (e.g., using a pediatric model for geriatric patients) or system integration errors requiring intervention.",
          "goal": "Safety"
        },
        {
          "description": "Analyzing usage patterns in an educational content recommendation API to identify when schools or districts are experiencing different student interaction patterns than expected, enabling proactive quality assurance and equity reviews.",
          "goal": "Transparency"
        },
        {
          "description": "Detecting anomalous query sequences in a loan underwriting API that might indicate adversarial testing by competitors or attackers attempting to reverse-engineer decision boundaries for circumvention.",
          "goal": "Security"
        }
      ],
      "limitations": [
        {
          "description": "Defining normal versus anomalous usage patterns requires establishing baselines that may not capture legitimate diversity in usage."
        },
        {
          "description": "Sophisticated adversaries may disguise malicious activity to blend with normal traffic, evading pattern-based detection."
        },
        {
          "description": "Privacy concerns may limit the extent to which usage data can be collected and analyzed, especially for sensitive applications."
        },
        {
          "description": "High false positive rates (often 20-40% in anomaly detection) can create alert fatigue, reducing the effectiveness of human review processes."
        },
        {
          "description": "Continuous pattern analysis requires storing and processing large volumes of query logs (potentially petabytes for high-traffic APIs), creating significant infrastructure and data retention costs."
        },
        {
          "description": "Real-time anomaly detection can add 5-20ms latency per request depending on analysis complexity, potentially impacting service level agreements for low-latency applications."
        }
      ],
      "sampleClaims": [
        {
          "text": "The system detects and logs query patterns consistent with attempts to reverse-engineer decision boundaries",
          "domain": "general",
          "assuranceGoal": "security"
        },
        {
          "text": "The deployed model identifies when usage patterns deviate from the validated operational envelope",
          "domain": "autonomous systems",
          "assuranceGoal": "safety"
        },
        {
          "text": "The API service maintains auditable records demonstrating alignment between actual usage and documented intended purposes",
          "domain": "finance",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The healthcare AI system flags unusual request volumes or distributions that may indicate integration errors or misuse",
          "domain": "healthcare",
          "assuranceGoal": "safety"
        },
        {
          "text": "The model API detects coordinated query sequences characteristic of adversarial probing attempts",
          "domain": "general",
          "assuranceGoal": "security"
        }
      ]
    },
    {
      "@id": "tea:technique/chain-of-thought-faithfulness-evaluation",
      "@type": "Technique",
      "name": "Chain-of-Thought Faithfulness Evaluation",
      "slug": "chain-of-thought-faithfulness-evaluation",
      "description": "Chain-of-thought faithfulness evaluation assesses the quality and faithfulness of step-by-step reasoning produced by language models. This technique evaluates whether intermediate reasoning steps are logically valid, factually accurate, and actually responsible for final answers (rather than post-hoc rationalisations). Evaluation methods include consistency checking (whether altered reasoning changes answers), counterfactual testing (injecting errors in reasoning chains), and comparison between reasoning paths for equivalent problems to ensure systematic rather than spurious reasoning.",
      "addressesGoal": [
        "tea:goal/explainability",
        "tea:goal/reliability",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/neural-networks/transformer/llm",
        "tea:tag/applicable-models/paradigm/generative",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/explainability",
        "tea:tag/assurance-goal-category/explainability/explains/internal-mechanisms",
        "tea:tag/assurance-goal-category/explainability/property/fidelity",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/performance-assessment",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/decision-reasons",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-type/text",
        "tea:tag/evidence-type/qualitative-report",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/expertise-needed/evaluation-design",
        "tea:tag/explanatory-scope/local",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/technique-type/testing"
      ],
      "relatedTo": [
        "tea:technique/retrieval-augmented-generation-evaluation",
        "tea:technique/epistemic-uncertainty-quantification",
        "tea:technique/constitutional-ai-evaluation"
      ],
      "citesResource": [
        "tea:resource/turpinCotunfaithfulnessCodeTurpin2026",
        "tea:resource/turpinLanguageModelsDont2023",
        "tea:resource/lanhamMeasuringFaithfulnessChainofThought2023",
        "tea:resource/benthamChainofThoughtUnfaithfulnessDisguised2024"
      ],
      "exampleUseCases": [
        {
          "description": "Evaluating a chemistry tutoring AI that guides students through chemical reaction balancing, ensuring each reasoning step correctly applies conservation of mass and charge rather than producing superficially plausible but scientifically incorrect pathways.",
          "goal": "Explainability"
        },
        {
          "description": "Ensuring a legal reasoning assistant produces reliable analysis by verifying that its chain-of-thought explanations correctly apply relevant statutes and precedents without logical gaps.",
          "goal": "Reliability"
        },
        {
          "description": "Testing science education AI that explains complex concepts step-by-step, verifying reasoning chains reflect sound pedagogical logic that helps students build understanding rather than just memorize facts.",
          "goal": "Transparency"
        },
        {
          "description": "Assessing an automated financial advisory system's investment recommendations to verify that its chain-of-thought explanations correctly apply financial principles, accurately calculate risk metrics, and logically justify portfolio allocations to clients.",
          "goal": "Reliability"
        }
      ],
      "limitations": [
        {
          "description": "Models may generate reasoning that appears valid but is actually post-hoc rationalization rather than the actual computational process leading to answers."
        },
        {
          "description": "Difficult to establish ground truth for complex reasoning tasks where multiple valid reasoning paths may exist."
        },
        {
          "description": "Verification requires domain expertise to judge whether reasoning steps are genuinely valid or merely superficially plausible."
        },
        {
          "description": "Computationally expensive to generate and verify multiple reasoning paths for comprehensive consistency checking."
        },
        {
          "description": "Scaling to production environments with high-volume requests is challenging, as thorough faithfulness evaluation may require generating multiple alternative reasoning paths for comparison, significantly increasing latency and cost."
        }
      ],
      "sampleClaims": [
        {
          "text": "The system's intermediate reasoning steps are logically valid and directly contribute to final conclusions",
          "domain": "general",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The medical triage assistant's step-by-step symptom analysis reflects genuine clinical reasoning rather than post-hoc justification",
          "domain": "healthcare",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The legal research tool's case analysis demonstrates consistent application of precedent across equivalent legal questions",
          "domain": "public sector",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The tutoring system's problem-solving explanations maintain factual accuracy at each step without logical gaps",
          "domain": "general",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The financial advisory model's investment recommendations are grounded in verifiable reasoning that users can trace and validate",
          "domain": "finance",
          "assuranceGoal": "transparency"
        }
      ]
    },
    {
      "@id": "tea:technique/constitutional-ai-evaluation",
      "@type": "Technique",
      "name": "Constitutional AI Evaluation",
      "slug": "constitutional-ai-evaluation",
      "description": "Constitutional AI evaluation assesses models trained to follow explicit behavioural principles or 'constitutions' that specify desired values and constraints. This technique verifies that models consistently adhere to specified principles across diverse scenarios, measuring both principle compliance and handling of principle conflicts. Evaluation includes testing boundary cases where principles might conflict, measuring robustness to adversarial attempts to violate principles, and assessing whether models can explain their reasoning in terms of constitutional principles.",
      "addressesGoal": [
        "tea:goal/safety",
        "tea:goal/transparency",
        "tea:goal/reliability"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/neural-networks/transformer/llm",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/applicable-models/paradigm/supervised",
        "tea:tag/assurance-goal-category/safety",
        "tea:tag/assurance-goal-category/safety/verification",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/decision-reasons",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/behavioural-consistency",
        "tea:tag/data-type/text",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/technique-type/testing",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/evidence-type/qualitative-report",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/expertise-needed/ethics",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/evaluation-design"
      ],
      "relatedTo": [
        "tea:technique/chain-of-thought-faithfulness-evaluation",
        "tea:technique/jailbreak-resistance-testing",
        "tea:technique/reward-hacking-detection"
      ],
      "citesResource": [
        "tea:resource/ClaudesConstitution",
        "tea:resource/tunstallAlignmenthandbookHuggingFace2026",
        "tea:resource/kyrychenkoC3AICraftingEvaluating2025",
        "tea:resource/baiConstitutionalAIHarmlessness2022",
        "tea:resource/ConstitutionalAIOpen2024",
        "tea:resource/lyuDomainSpecificConstitutionalAI2025",
        "tea:resource/huangCollectiveConstitutionalAI2024"
      ],
      "exampleUseCases": [
        {
          "description": "Evaluating a general-purpose AI assistant with the principle 'provide helpful information while refusing requests for illegal activities' to ensure it consistently distinguishes between legitimate chemistry education queries and attempts to obtain instructions for synthesising controlled substances or explosives.",
          "goal": "Safety"
        },
        {
          "description": "Testing whether an AI assistant can transparently explain its decisions by referencing the specific constitutional principles that guided its responses, enabling users to understand value-based reasoning.",
          "goal": "Transparency"
        },
        {
          "description": "Verifying that an AI news aggregator consistently applies stated principles about neutrality versus editorial perspective across diverse political topics and international news sources.",
          "goal": "Reliability"
        },
        {
          "description": "Evaluating a mental health support chatbot designed with principles like 'be empathetic and supportive while never providing medical diagnoses or replacing professional care' to verify it consistently maintains this boundary across varied emotional crises and user requests.",
          "goal": "Safety"
        },
        {
          "description": "Testing an AI homework assistant built on principles of 'guide learning without providing direct answers' to ensure it maintains this educational philosophy across different subjects, student ages, and question complexities without reverting to simply solving problems.",
          "goal": "Reliability"
        }
      ],
      "limitations": [
        {
          "description": "Constitutional principles may be vague or subject to interpretation, making it difficult to objectively measure compliance."
        },
        {
          "description": "Principles can conflict in complex scenarios, and evaluation must assess whether the model's priority ordering matches intended values."
        },
        {
          "description": "Models may learn to superficially cite principles in explanations without genuinely using them in decision-making processes."
        },
        {
          "description": "Creating comprehensive test sets covering all relevant principle applications and edge cases requires significant domain expertise and resources."
        },
        {
          "description": "Constitutional principles that seem clear in one cultural or linguistic context may be interpreted differently across diverse user populations, making it challenging to evaluate whether the model appropriately adapts its principle application or inappropriately varies its values."
        },
        {
          "description": "As organisational values evolve or principles are refined based on deployment experience, re-evaluation becomes necessary, but comparing results across principle versions is challenging without confounding changes in the model itself versus changes in evaluation criteria."
        }
      ],
      "sampleClaims": [
        {
          "text": "The conversational assistant consistently refuses requests for harmful information whilst maintaining helpful responses to legitimate educational queries",
          "domain": "general",
          "assuranceGoal": "safety"
        },
        {
          "text": "The system's decisions reference specific guiding principles that explain why certain actions were taken or declined",
          "domain": "public sector",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The healthcare chatbot maintains its boundary between providing supportive information and offering medical advice across diverse emotional contexts",
          "domain": "healthcare",
          "assuranceGoal": "safety"
        },
        {
          "text": "The content moderation system applies its stated community standards consistently across different cultural contexts and topic sensitivities",
          "domain": "general",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The educational assistant upholds its pedagogical values without reverting to direct answer provision when users express frustration or urgency",
          "domain": "general",
          "assuranceGoal": "reliability"
        }
      ]
    },
    {
      "@id": "tea:technique/continual-learning-stability-testing",
      "@type": "Technique",
      "name": "Continual Learning Stability Testing",
      "slug": "continual-learning-stability-testing",
      "description": "Continual learning stability testing evaluates whether models that learn from streaming data maintain performance on previously learned tasks while acquiring new capabilities. This technique measures catastrophic forgetting (performance degradation on old tasks), forward transfer (whether old knowledge helps new learning), and backward transfer (whether new learning damages old performance). Testing includes challenging scenarios where data distributions shift significantly and evaluates whether stability techniques like experience replay or regularisation effectively preserve knowledge.",
      "addressesGoal": [
        "tea:goal/reliability",
        "tea:goal/safety",
        "tea:goal/fairness"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/architecture/neural-networks",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/robustness",
        "tea:tag/assurance-goal-category/safety",
        "tea:tag/assurance-goal-category/safety/verification",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/performance-by-group",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-type/any",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/technique-type/testing",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation"
      ],
      "relatedTo": [
        "tea:technique/adversarial-training-evaluation",
        "tea:technique/safety-envelope-testing",
        "tea:technique/agent-goal-misalignment-testing",
        "tea:technique/machine-unlearning"
      ],
      "citesResource": [
        "tea:resource/continuumdevelopersMetricsContinuum0102023",
        "tea:resource/lomonacoAvalancheEndtoEndLibrary2021",
        "tea:resource/delangeContinualEvaluationLifelong2022",
        "tea:resource/lopez-pazGradientEpisodicMemory2017",
        "tea:resource/EvaluationAvalancheZero",
        "tea:resource/zengDevelopmentValidationDeep2026"
      ],
      "exampleUseCases": [
        {
          "description": "Testing whether a content moderation model updated with new harmful content patterns maintains reliable detection of previously learned violation types without catastrophic forgetting.",
          "goal": "Reliability"
        },
        {
          "description": "Ensuring a medical diagnosis AI that continuously learns from new clinical cases doesn't forget how to recognize previously mastered conditions, preventing safety regressions.",
          "goal": "Safety"
        },
        {
          "description": "Verifying that fairness improvements from continual learning don't introduce new biases or degrade performance for previously well-served demographic groups.",
          "goal": "Fairness"
        },
        {
          "description": "Testing whether a fraud detection system that continuously learns from new fraud patterns maintains its ability to detect previously identified fraud types, preventing financial losses from regression to older attack vectors.",
          "goal": "Reliability"
        },
        {
          "description": "Verifying that a customer service chatbot updated with new product knowledge doesn't degrade in handling established customer issues, maintaining consistent service quality across evolving capabilities.",
          "goal": "Reliability"
        }
      ],
      "limitations": [
        {
          "description": "Comprehensive testing requires maintaining evaluation datasets for all previously learned tasks, which becomes burdensome as systems learn continuously."
        },
        {
          "description": "Trade-offs between plasticity (learning new tasks well) and stability (retaining old knowledge) are fundamental and difficult to optimize simultaneously."
        },
        {
          "description": "Techniques that prevent catastrophic forgetting often require storing samples of old data, raising privacy and storage concerns."
        },
        {
          "description": "Defining acceptable forgetting levels is application-dependent and may conflict with the need to adapt to changing environments."
        },
        {
          "description": "Comprehensive stability testing requires re-running full evaluation suites after each update, creating computational costs that scale linearly with model lifespan and update frequency."
        }
      ],
      "sampleClaims": [
        {
          "text": "The diagnostic system maintains accurate detection of previously learned conditions when updated with new disease patterns",
          "domain": "healthcare",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The content moderation model retains effective identification of earlier violation types after learning to detect new forms of harmful content",
          "domain": "general",
          "assuranceGoal": "safety"
        },
        {
          "text": "The fraud detection system's performance on established fraud patterns does not degrade when trained on emerging attack vectors",
          "domain": "finance",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The recommendation system's fairness properties for existing user demographics remain stable when the model adapts to new user populations",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The industrial safety monitoring system preserves reliable detection of known hazard conditions whilst incorporating recognition of newly identified risk factors",
          "domain": "manufacturing",
          "assuranceGoal": "safety"
        }
      ]
    },
    {
      "@id": "tea:technique/data-poisoning-detection",
      "@type": "Technique",
      "name": "Data Poisoning Detection",
      "slug": "data-poisoning-detection",
      "description": "Data poisoning detection identifies malicious training data designed to compromise model behaviour. This technique detects various poisoning attacks including backdoor injection (triggers causing specific behaviours), availability attacks (degrading overall performance), and targeted attacks (causing errors on specific inputs). Detection methods include statistical outlier analysis, influence function analysis to identify high-impact training points, and validation-based approaches that test for suspicious model behaviours indicative of poisoning.",
      "addressesGoal": [
        "tea:goal/security",
        "tea:goal/reliability",
        "tea:goal/safety"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/model-agnostic",
        "tea:tag/applicable-models/requirements/white-box",
        "tea:tag/applicable-models/requirements/gradient-access",
        "tea:tag/assurance-goal-category/security",
        "tea:tag/assurance-goal-category/security/detection",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/robustness",
        "tea:tag/assurance-goal-category/safety",
        "tea:tag/assurance-goal-category/safety/safeguards",
        "tea:tag/data-requirements/access-to-training-data",
        "tea:tag/data-type/any",
        "tea:tag/technique-type/algorithmic",
        "tea:tag/evidence-type/dataset-analysis",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/security",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/expertise-needed/data-engineering",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/preprocessing-and-feature-engineering",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation"
      ],
      "relatedTo": [
        "tea:technique/adversarial-training-evaluation",
        "tea:technique/influence-functions",
        "tea:technique/federated-learning"
      ],
      "citesResource": [
        "tea:resource/adversarial-robustness-toolboxdevelopersArtdefencesdetectorpoisonAdversarialRobustness",
        "tea:resource/AdversarialRobustnessToolbox2026",
        "tea:resource/chenDetectingBackdoorAttacks2018",
        "tea:resource/tranSpectralSignaturesBackdoor2018",
        "tea:resource/ARTNotebookPoisoning",
        "tea:resource/singampalliSAFELOCOvercomingData2024",
        "tea:resource/mithsaraZeroShotDetectionSanitization2024"
      ],
      "exampleUseCases": [
        {
          "description": "Scanning training data for an autonomous driving system to detect images that might contain backdoor triggers designed to cause unsafe behavior when specific objects appear in the environment.",
          "goal": "Safety"
        },
        {
          "description": "Protecting a federated learning system for hospital patient diagnosis models from malicious participants who might inject poisoned medical records designed to create backdoors that misclassify specific patient profiles or degrade overall diagnostic reliability.",
          "goal": "Security"
        },
        {
          "description": "Ensuring a content moderation model hasn't been poisoned with data designed to make it fail on specific types of harmful content, maintaining reliable safety filtering.",
          "goal": "Reliability"
        },
        {
          "description": "Detecting poisoned training data in recidivism prediction models used for sentencing recommendations, where malicious actors might inject manipulated records to systematically bias predictions for specific demographic groups.",
          "goal": "Safety"
        },
        {
          "description": "Scanning training data for algorithmic trading models to identify poisoned market data designed to create exploitable patterns, ensuring reliable trading decisions and preventing market manipulation vulnerabilities.",
          "goal": "Reliability"
        }
      ],
      "limitations": [
        {
          "description": "Sophisticated poisoning attacks can be designed to evade statistical detection by mimicking benign data distributions closely."
        },
        {
          "description": "High false positive rates may lead to incorrectly filtering legitimate but unusual training examples, reducing training data quality and diversity."
        },
        {
          "description": "Computationally expensive to apply influence function analysis or deep inspection to very large training datasets, potentially requiring hours to days for thorough analysis of datasets with millions of samples, particularly when using gradient-based detection methods."
        },
        {
          "description": "Difficult to detect poisoning in scenarios where attackers have knowledge of detection methods and can adapt attacks accordingly."
        },
        {
          "description": "Establishing ground truth for what constitutes 'poisoned' versus legitimate but unusual data is challenging, particularly when dealing with naturally occurring outliers or edge cases in the data distribution."
        }
      ],
      "sampleClaims": [
        {
          "text": "The training data is free from malicious examples designed to compromise model behaviour on specific trigger patterns",
          "domain": "autonomous systems",
          "assuranceGoal": "security"
        },
        {
          "text": "The diagnostic system's training dataset contains no manipulated medical records that systematically bias predictions for specific patient profiles",
          "domain": "healthcare",
          "assuranceGoal": "safety"
        },
        {
          "text": "The content moderation model's training corpus has not been corrupted with examples designed to suppress detection of particular harmful content categories",
          "domain": "general",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The federated learning system detects and rejects training contributions containing backdoor triggers before they influence the global model",
          "domain": "healthcare",
          "assuranceGoal": "security"
        },
        {
          "text": "The financial model's training data is validated to exclude manipulated records designed to create exploitable prediction patterns",
          "domain": "finance",
          "assuranceGoal": "safety"
        }
      ]
    },
    {
      "@id": "tea:technique/embedding-bias-analysis",
      "@type": "Technique",
      "name": "Embedding Bias Analysis",
      "slug": "embedding-bias-analysis",
      "description": "Embedding bias analysis examines learned representations to identify biases, spurious correlations, and problematic clustering patterns in vector embeddings. This technique uses dimensionality reduction, clustering analysis, and geometric fairness metrics to examine whether embeddings encode sensitive attributes, place certain groups in disadvantaged regions of representation space, or learn stereotypical associations. Analysis reveals whether embeddings used for retrieval, recommendation, or downstream tasks contain fairness issues that will propagate to applications.",
      "addressesGoal": [
        "tea:goal/fairness",
        "tea:goal/explainability",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/neural-networks",
        "tea:tag/applicable-models/architecture/neural-networks/transformer",
        "tea:tag/applicable-models/architecture/neural-networks/transformer/llm",
        "tea:tag/applicable-models/architecture/neural-networks/convolutional",
        "tea:tag/applicable-models/requirements/model-internals",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/bias-measurement",
        "tea:tag/assurance-goal-category/explainability",
        "tea:tag/assurance-goal-category/explainability/explains/internal-mechanisms",
        "tea:tag/assurance-goal-category/explainability/visualization-methods/activation-maps",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/assessment-results",
        "tea:tag/data-type/text",
        "tea:tag/data-type/image",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/technique-type/testing",
        "tea:tag/evidence-type/fairness-metric",
        "tea:tag/evidence-type/visualisation",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/explanatory-scope/global"
      ],
      "relatedTo": [
        "tea:technique/attention-weight-analysis",
        "tea:technique/concept-activation-vectors",
        "tea:technique/few-shot-fairness-evaluation",
        "tea:technique/toxicity-detection"
      ],
      "citesResource": [
        "tea:resource/WEFEDocumentation",
        "tea:resource/WEFEWordEmbeddings2026",
        "tea:resource/caliskanSemanticsDerivedAutomatically2017",
        "tea:resource/BiasMeasurementWEFE",
        "tea:resource/bolukbasiManComputerProgrammer2016",
        "tea:resource/gargWordEmbeddingsQuantify2018",
        "tea:resource/steedImageRepresentationsLearned2021"
      ],
      "exampleUseCases": [
        {
          "description": "Auditing word embeddings for biased gender associations like 'doctor' being closer to 'male' than 'female', identifying problematic stereotypes that could affect downstream NLP applications.",
          "goal": "Fairness"
        },
        {
          "description": "Analyzing face recognition embeddings to understand whether certain demographic groups are clustered more tightly (enabling easier discrimination) or more dispersed (enabling easier misidentification).",
          "goal": "Explainability"
        },
        {
          "description": "Transparently documenting embedding space properties including which attributes are encoded and what associations exist, enabling informed decisions about appropriate use cases.",
          "goal": "Transparency"
        },
        {
          "description": "Analyzing clinical note embeddings in a medical diagnosis support system to detect whether disease associations cluster along demographic lines (e.g., certain conditions being systematically closer to particular age or ethnic groups in the embedding space), which could lead to biased treatment recommendations.",
          "goal": "Fairness"
        },
        {
          "description": "Examining embeddings in a legal document analysis system to identify whether risk assessment features encode problematic associations between demographic attributes and recidivism concepts, revealing bias that could affect sentencing or parole decisions.",
          "goal": "Explainability"
        },
        {
          "description": "Auditing loan application embeddings to detect whether protected characteristics (ethnicity, gender, age) cluster near creditworthiness concepts in ways that could enable indirect discrimination in lending decisions.",
          "goal": "Fairness"
        }
      ],
      "limitations": [
        {
          "description": "Defining ground truth for 'fair' or 'unbiased' embedding geometries is challenging and may depend on application-specific requirements."
        },
        {
          "description": "Debiasing embeddings can reduce performance on downstream tasks or remove useful information along with unwanted biases."
        },
        {
          "description": "High-dimensional embedding spaces are difficult to visualize and interpret comprehensively, potentially missing subtle bias patterns."
        },
        {
          "description": "Embeddings may encode bias in complex, non-linear ways that simple geometric metrics fail to capture."
        },
        {
          "description": "Requires access to model internals and training data to extract and analyze embeddings, making this technique infeasible for black-box commercial models or systems where proprietary data cannot be shared."
        },
        {
          "description": "Analyzing large-scale embedding spaces can be computationally expensive and requires sophisticated understanding of both vector space geometry and the specific domain to interpret results meaningfully."
        },
        {
          "description": "Effective bias analysis requires representative test datasets covering relevant demographic groups and attributes, which may be difficult to obtain for sensitive domains or protected characteristics."
        }
      ],
      "sampleClaims": [
        {
          "text": "The recommendation system's item embeddings do not cluster products along demographic lines in ways that limit cross-group exposure",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The document retrieval system's embedding space geometry does not position certain demographic groups in disadvantaged regions affecting search relevance",
          "domain": "public sector",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The medical language model's clinical term embeddings maintain equitable distances across patient demographic attributes",
          "domain": "healthcare",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The hiring system's resume embeddings reveal which candidate attributes are encoded in the representation space and how they cluster",
          "domain": "finance",
          "assuranceGoal": "explainability"
        },
        {
          "text": "The content moderation system's embedding space properties are documented including encoded sensitive attributes and their spatial relationships",
          "domain": "general",
          "assuranceGoal": "transparency"
        }
      ]
    },
    {
      "@id": "tea:technique/few-shot-fairness-evaluation",
      "@type": "Technique",
      "name": "Few-Shot Fairness Evaluation",
      "slug": "few-shot-fairness-evaluation",
      "description": "Few-shot fairness evaluation assesses whether in-context learning with few-shot examples introduces or amplifies biases in model predictions. This technique systematically varies demographic characteristics in few-shot examples and measures how these variations affect model outputs for different groups. Evaluation includes testing prompt sensitivity (how example selection impacts fairness), stereotype amplification (whether biased examples disproportionately affect outputs), and consistency (whether similar inputs receive equitable treatment regardless of example composition).",
      "addressesGoal": [
        "tea:goal/fairness",
        "tea:goal/reliability",
        "tea:goal/transparency"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/neural-networks/transformer/llm",
        "tea:tag/applicable-models/paradigm/generative",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/fairness",
        "tea:tag/assurance-goal-category/fairness/bias-measurement",
        "tea:tag/evidence-type/fairness-metric",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/robustness",
        "tea:tag/assurance-goal-category/transparency",
        "tea:tag/assurance-goal-category/transparency/assessment-results",
        "tea:tag/data-requirements/labelled-data",
        "tea:tag/data-requirements/sensitive-attributes",
        "tea:tag/data-type/text",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/statistics",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/expertise-needed/evaluation-design",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/technique-type/testing"
      ],
      "relatedTo": [
        "tea:technique/prompt-robustness-testing",
        "tea:technique/toxicity-detection",
        "tea:technique/fairness-testing",
        "tea:technique/embedding-bias-analysis"
      ],
      "citesResource": [
        "tea:resource/LangFairDocumentation",
        "tea:resource/Langfair2026",
        "tea:resource/FairnessguidedFewshotPrompting2023",
        "tea:resource/LangFairCounterfactualMetrics",
        "tea:resource/huStrategicDemonstrationSelection2024"
      ],
      "exampleUseCases": [
        {
          "description": "Testing whether a resume screening LLM's few-shot examples inadvertently introduce gender bias by showing more male examples for technical positions, affecting how it evaluates subsequent applicants.",
          "goal": "Fairness"
        },
        {
          "description": "Ensuring a customer service classifier maintains reliable performance across demographic groups regardless of which few-shot examples users or developers choose to include in prompts.",
          "goal": "Reliability"
        },
        {
          "description": "Documenting how few-shot example selection affects fairness metrics, transparently reporting sensitivity to example composition in deployment guidelines.",
          "goal": "Transparency"
        },
        {
          "description": "Evaluating whether a medical triage LLM's few-shot examples for symptom assessment inadvertently encode demographic biases (e.g., more examples of cardiac symptoms in male patients), leading to differential urgency assessments across patient populations.",
          "goal": "Fairness"
        },
        {
          "description": "Testing whether few-shot examples used in a legal case summarization system introduce racial or socioeconomic bias in how defendant backgrounds or case circumstances are characterized, affecting case outcome predictions.",
          "goal": "Fairness"
        },
        {
          "description": "Assessing whether few-shot examples in a loan application review assistant systematically present more favourable examples for certain demographic profiles, biasing the model's assessment of creditworthiness for subsequent applications.",
          "goal": "Fairness"
        },
        {
          "description": "Verifying that an automated essay grading system maintains consistent standards across student demographics when few-shot examples inadvertently represent particular writing styles, dialects, or cultural references more prominently.",
          "goal": "Reliability"
        }
      ],
      "limitations": [
        {
          "description": "Vast number of possible few-shot example combinations makes exhaustive testing infeasible, requiring sampling strategies that may miss important configurations."
        },
        {
          "description": "Fairness may be highly sensitive to subtle differences in example wording or formatting, making it difficult to provide robust guarantees."
        },
        {
          "description": "Trade-offs between example diversity and task performance may force choices between fairness and accuracy."
        },
        {
          "description": "Results may not generalise across different prompt templates or instruction formats, requiring separate evaluation for each prompting strategy."
        },
        {
          "description": "Requires carefully labeled datasets with demographic annotations to measure fairness across groups, which may be unavailable, expensive to create, or raise privacy concerns in sensitive domains."
        },
        {
          "description": "Designing representative test sets that capture realistic few-shot example distributions requires deep domain expertise and understanding of how the system will be used in practice."
        },
        {
          "description": "Evaluating fairness across multiple demographic groups with various few-shot configurations can be computationally expensive, particularly for large language models with high inference costs."
        }
      ],
      "sampleClaims": [
        {
          "text": "The language model produces equitable outcomes across demographic groups regardless of which few-shot examples are provided in the prompt",
          "domain": "general",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The recruitment system's candidate assessments remain unbiased when the composition of demonstration examples varies in demographic representation",
          "domain": "finance",
          "assuranceGoal": "fairness"
        },
        {
          "text": "The model maintains consistent performance across protected groups under diverse configurations of in-context learning examples",
          "domain": "healthcare",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The system's fairness characteristics across different prompt example compositions are quantified and documented",
          "domain": "public sector",
          "assuranceGoal": "transparency"
        },
        {
          "text": "The content generation model's outputs exhibit equitable treatment of demographic groups when few-shot examples contain varying levels of representation",
          "domain": "general",
          "assuranceGoal": "fairness"
        }
      ]
    },
    {
      "@id": "tea:technique/jailbreak-resistance-testing",
      "@type": "Technique",
      "name": "Jailbreak Resistance Testing",
      "slug": "jailbreak-resistance-testing",
      "description": "Jailbreak resistance testing evaluates LLM defences against techniques that bypass safety constraints. This involves testing role-playing attacks, hypothetical framing, encoded instructions, and multi-turn manipulation. Testing measures immediate resistance to jailbreaks and the system's ability to detect and block evolving attack patterns, producing reports on vulnerability severity and exploit paths.",
      "addressesGoal": [
        "tea:goal/safety",
        "tea:goal/security",
        "tea:goal/reliability"
      ],
      "hasTag": [
        "tea:tag/applicable-models/architecture/neural-networks/transformer/llm",
        "tea:tag/applicable-models/requirements/black-box",
        "tea:tag/assurance-goal-category/safety",
        "tea:tag/assurance-goal-category/safety/verification",
        "tea:tag/assurance-goal-category/security",
        "tea:tag/assurance-goal-category/security/vulnerability-testing",
        "tea:tag/assurance-goal-category/reliability",
        "tea:tag/assurance-goal-category/reliability/robustness",
        "tea:tag/data-type/text",
        "tea:tag/lifecycle-stage/model-development",
        "tea:tag/lifecycle-stage/model-development/model-testing-and-validation",
        "tea:tag/technique-type/testing",
        "tea:tag/evidence-type/qualitative-report",
        "tea:tag/evidence-type/quantitative-metric",
        "tea:tag/expertise-needed/domain-expertise",
        "tea:tag/expertise-needed/ml-engineering",
        "tea:tag/expertise-needed/security",
        "tea:tag/expertise-needed/evaluation-design",
        "tea:tag/data-requirements/no-special-requirements"
      ],
      "relatedTo": [
        "tea:technique/prompt-injection-testing",
        "tea:technique/adversarial-training-evaluation",
        "tea:technique/red-teaming",
        "tea:technique/prompt-robustness-testing"
      ],
      "citesResource": [
        "tea:resource/GarakDocumentation2026",
        "tea:resource/llamator-coreLlamator2024",
        "tea:resource/Garak2026",
        "tea:resource/microsoftPyRITPythonRisk2024",
        "tea:resource/weiJailbrokenHowDoes2023",
        "tea:resource/YourFirstScan2023",
        "tea:resource/shenAnythingNowCharacterizing2024"
      ],
      "exampleUseCases": [
        {
          "description": "Testing a mental health support chatbot to ensure it cannot be jailbroken into providing medical advice that contradicts established clinical guidelines or suggesting harmful interventions, even when users employ emotional manipulation or role-playing scenarios.",
          "goal": "Safety"
        },
        {
          "description": "Validating that a financial advisory AI cannot be manipulated through multi-turn conversations into revealing proprietary trading algorithms, internal risk assessment models, or client portfolio information through social engineering techniques.",
          "goal": "Security"
        },
        {
          "description": "Ensuring an educational assessment AI maintains reliable grading standards and cannot be convinced to inflate scores, provide test answers, or bypass academic integrity checks through creative prompt engineering or hypothetical framing.",
          "goal": "Reliability"
        },
        {
          "description": "Testing a legal research AI assistant to verify it cannot be jailbroken into generating legally problematic content, revealing confidential case strategies, or providing advice that contradicts professional ethics rules through iterative prompt refinement.",
          "goal": "Security"
        }
      ],
      "limitations": [
        {
          "description": "New jailbreak techniques emerge constantly as adversaries discover creative attack vectors, requiring continuous testing and defense updates."
        },
        {
          "description": "Overly restrictive defenses can cause false positive rates of 5-15%, blocking legitimate queries about sensitive topics for educational or research purposes."
        },
        {
          "description": "Testing coverage is inherently limited by the creativity of testers, potentially missing novel jailbreak approaches that real users might discover."
        },
        {
          "description": "Some jailbreaks work through subtle multi-turn interactions that are difficult to anticipate and test systematically."
        },
        {
          "description": "Defence mechanisms such as output filtering, multi-stage validation, and adversarial prompt detection add 100-300ms latency per response, which may impact user experience in real-time applications."
        },
        {
          "description": "Defining clear boundaries for what constitutes unacceptable behaviour versus legitimate edge case queries is context-dependent and culturally variable, making universal jailbreak resistance metrics difficult to establish."
        }
      ],
      "sampleClaims": [
        {
          "text": "The mental health chatbot maintains established clinical guidelines and refuses harmful recommendations even when users attempt emotional manipulation or hypothetical scenario framing",
          "domain": "healthcare",
          "assuranceGoal": "safety"
        },
        {
          "text": "The financial advisory system's confidentiality safeguards remain effective against conversational techniques designed to extract proprietary information",
          "domain": "finance",
          "assuranceGoal": "security"
        },
        {
          "text": "The educational assessment system enforces academic integrity policies consistently regardless of how creatively students phrase requests for inappropriate assistance",
          "domain": "general",
          "assuranceGoal": "reliability"
        },
        {
          "text": "The legal research assistant detects and blocks attempts to circumvent professional ethics constraints through iterative prompt refinement",
          "domain": "public sector",
          "assuranceGoal": "security"
        },
        {
          "text": "The customer service chatbot's safety boundaries withstand techniques that attempt to redefine its role or operational constraints during conversations",
          "domain": "general",
          "assuranceGoal": "safety"
        }
      ]
    },
    {
      "@id": "tea:technique/epistemic-uncertainty-quantification",
      "@type": "Technique",
      "name": "Epistemic Uncertainty Quantification",
      "slug": "epistemic-uncertainty-quantification",
      "description": "Epistemic uncertainty quantification systematically measures model uncertainty about what it knows, partially knows, and doesn't know across different domains and topics. This technique uses probing datasets, confidence calibration analysis, and consistency testing to quantify epistemic uncertainty (uncertainty due to lack of knowledge) as distinct from aleatoric uncertainty (inherent data uncertainty). Uncertainty quantification enables appropriate deployment scoping, communicating model limitations, and identifying knowledge gaps requiring additional training or human oversight.",
      "addressesGoal": [
        "tea:goal/transparency",
        "tea:goal/reliability",
        "tea:goal/safety"
      ],
