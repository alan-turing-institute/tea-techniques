      "@id": "tea:resource/asyrofiBiasFinderMetamorphicTest2021",
      "@type": "Resource",
      "name": "BiasFinder: Metamorphic Test Generation to Uncover Bias for Sentiment Analysis Systems",
      "citationKey": "asyrofiBiasFinderMetamorphicTest2021",
      "url": "https://doi.org/10.1109/tse.2021.3136169",
      "sourceType": "application_paper",
      "authors": [
        "Muhammad Hilmi Asyrofi",
        "Zhou Yang",
        "Imam Nur Bani Yusuf",
        "Hong Jin Kang",
